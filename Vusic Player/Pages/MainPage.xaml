<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Vusic_Player.Pages.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Vusic_Player.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:media="using:CommunityToolkit.WinUI.Media" xmlns:controls="using:CommunityToolkit.WinUI.Controls" xmlns:playback_views="using:Vusic_Player.UI.UserViews.Controls" xmlns:videogeneral="using:Vusic_Player.UI.Dialogs.VideoOptions.VideoGeneral" xmlns:audiogeneral="using:Vusic_Player.UI.Dialogs.VideoOptions.Audio.AudioGeneral" xmlns:audioequalizer="using:Vusic_Player.UI.Dialogs.VideoOptions.Audio.AudioEqualizer" xmlns:audioadvanced="using:Vusic_Player.UI.Dialogs.VideoOptions.Audio.AudioAdvanced"
    mc:Ignorable="d">

    <Grid Background="#FF0D1117">
        <Frame Name="frmVid" Visibility="Collapsed"></Frame>
        <Frame Name="frmRoot">
            <Grid Name="grdRoot" Visibility="Visible" PreviewKeyDown="ControlRoot_PreviewKeyDown" KeyboardAcceleratorPlacementMode="Hidden" >
                <Grid.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Space" Invoked="Spacebar_Invoked"/>
                    <KeyboardAccelerator Key="M" Invoked="KeyboardAccelerator_Invoked"/>
                    <KeyboardAccelerator Key="N" x:Name="NKey" Invoked="NKey_Invoked"   />
                    <KeyboardAccelerator Key="P" x:Name="PKey" Invoked="PKey_Invoked"   />
                </Grid.KeyboardAccelerators>
                <Grid.Background>
                    <ImageBrush x:Name="imgSourceBackground" ImageSource="{Binding BackgroundBlur, Source={StaticResource GlobalIconHolder}}"
Stretch="UniformToFill"/>
                </Grid.Background>
                <Border CornerRadius="20" x:Name="Bordermain">
                    <Border.Background>
                        <media:BackdropBlurBrush Amount="7.0" x:Name="BackdropBlur"/>
                    </Border.Background>
                    <Grid ColumnSpacing="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition ></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                            <ColumnDefinition MaxWidth="700" MinWidth="280" x:Name="ColumnMaster" Width="300"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <NavigationView  IsBackButtonVisible="Auto" IsBackEnabled="True" BackRequested="nvgMain_BackRequested" Grid.Column="0" Background="Transparent" Name="nvgMain" PaneDisplayMode="Top" IsSettingsVisible="True" SelectionChanged="nvgMain_SelectionChanged">
                            <NavigationView.Resources>
                                <!-- The default selection indicator bar color -->
                                <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" 
                         Color="{StaticResource GlobalAccentColor}"/>

                           
                            </NavigationView.Resources>
                            <NavigationView.MenuItems>
                                <NavigationViewItem   FontFamily="{StaticResource GlobalFontHolder}"  Name="nvgitHome" Content="Home" Tag="HomePage"></NavigationViewItem>
                                <NavigationViewItem  FontFamily="{ThemeResource GlobalFontHolder}"  Name="nvgitMusic" Content="Music Library" Tag="MusicLibrary"></NavigationViewItem>
                                <NavigationViewItem  FontFamily="{StaticResource GlobalFontHolder}"  Name="nvgitVideo" Content="Video Library"></NavigationViewItem>
                                <NavigationViewItem  FontFamily="{StaticResource GlobalFontHolder}"  Name="nvgitQueue" Content="Play Queue" Visibility="Visible"></NavigationViewItem>
                            </NavigationView.MenuItems>

                            <NavigationView.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <playback_views:MasterSearchControl x:Name="masterSearchControl" Grid.Column="1" MinWidth="300" Margin="40, 0" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    <TextBlock  FontFamily="{ThemeResource GlobalFontHolder}"  Grid.Column="0" Name="txtHeader" Text=""/>
                                </Grid>
                            </NavigationView.Header>

                            <Grid>
                                <Grid Visibility="Collapsed" Name="blackBackground" Background="Black" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"></Grid>

                                <Frame Name="frmMain" Navigated="FrmMain_Navigated" Background="Transparent">

                                </Frame>
                            </Grid>
                        </NavigationView>
                        <controls:GridSplitter Grid.Column="1" 
    Width="12" Margin="0, 0" Padding="0" x:Name="grdsplittr"
    ResizeBehavior="BasedOnAlignment">

                        </controls:GridSplitter>
                        <Grid RowSpacing="5" Visibility="Visible" Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="20, 0" Name="MusicPlayerMaster" Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"></RowDefinition>
                                <RowDefinition Height="Auto"></RowDefinition>
                                <RowDefinition Height="Auto"></RowDefinition>
                                <RowDefinition Height="Auto"></RowDefinition>
                                <RowDefinition Height="Auto"></RowDefinition>
                                <RowDefinition Height="Auto"></RowDefinition>
                                <RowDefinition Height="Auto"></RowDefinition>
                                <RowDefinition Height="Auto"></RowDefinition>
                                <RowDefinition Height="Auto"></RowDefinition>
                                <RowDefinition Height="Auto"></RowDefinition>
                            </Grid.RowDefinitions>
                            <Image Name="imgThumbnailCover" Source="{x:Bind mediacontroller.CoverThumbnail, Mode=OneWay}" Width="150" Grid.Row="0"></Image>

                            <TextBlock  FontFamily="{StaticResource GlobalFontHolder}"   Margin="0, 20, 0, 0" HorizontalAlignment="Center"  Name="txtSongName" TextTrimming="CharacterEllipsis" MaxLines="1" Grid.Row="1" Text="{x:Bind mediacontroller.MediaDisplayName, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind mediacontroller.MediaDisplayName, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="NoWrap" >

                            </TextBlock>
                            <Grid Grid.Row="2" Margin="0, 5, 0, 0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <HyperlinkButton Foreground="{StaticResource GlobalAccentColor}"   FontFamily="{StaticResource GlobalFontHolder}"  Click="HyperlinkButton_Click" Grid.Column="0" Content="{x:Bind mediacontroller.ArtistDisplayName, Mode=OneWay}">

                                </HyperlinkButton>
                                <HyperlinkButton Foreground="{StaticResource GlobalAccentColor}"   FontFamily="{StaticResource GlobalFontHolder}" Click="HyperlinkButton_Click_1" Grid.Column="1" HorizontalAlignment="Right" Content="{x:Bind mediacontroller.AlbumDisplayName,Mode=OneWay}">

                                </HyperlinkButton>
                            </Grid>
                            <playback_views:OceanSlider Margin="0, 5, 0, 0" x:Name="sldMain" Value="{x:Bind mediacontroller.CurrentPosition, Mode=TwoWay}" Maximum="{x:Bind mediacontroller.TotalDuration, Mode=TwoWay}" DragStarted="sldMain_DragStarted" DragCompleted="sldMain_DragCompleted"  IsEnabled="True" Grid.Row="3" HorizontalAlignment="Stretch" ></playback_views:OceanSlider>

                            <Grid x:Name="grdTexts" Margin="5,10,0, 0" Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock  FontFamily="{StaticResource GlobalFontHolder}"  Grid.Column="0" HorizontalAlignment="Left" Text="{x:Bind mediacontroller.RunningDurationString, Mode=OneWay}" Name="txtRunningDuration" FontSize="11" Opacity="0.8"/>
                                <TextBlock Tapped="txtTotalDuration_Tapped"  FontFamily="{StaticResource GlobalFontHolder}"  Grid.Column="1" HorizontalAlignment="Right" Text="{x:Bind mediacontroller.TotalDurationString, Mode=OneWay}" Name="txtTotalDuration" FontSize="11" Opacity="0.8"/>
                            </Grid>

                            <playback_views:PlayPauseControls SpaceWidth="10" Margin="0, 5" Grid.Row="5" HorizontalAlignment="Center"></playback_views:PlayPauseControls>
                            <playback_views:VolumeSlider Margin="0, 10" Grid.Row="6" HorizontalAlignment="Center"></playback_views:VolumeSlider>

                            <playback_views:PanelControlsAudioPlayer x:Name="panelControlAudioPlayer"  ExpandedViewButtonToolTip="Expanded View" Grid.Row="7"></playback_views:PanelControlsAudioPlayer>
                            <CheckBox  FontFamily="{StaticResource GlobalFontHolder}"  HorizontalAlignment="Center" Name="chckMultioutput" Grid.Row="8" Content="Multi-Device Audio Output" Checked="chckMultioutput_Checked" Unchecked="chckMultioutput_Checked">
                                <CheckBox.Resources>
                                    <!-- 1. Background Fill when CHECKED -->
                                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="{StaticResource GlobalAccentColor}"/>
                                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="{StaticResource GlobalAccentColorPointerOver}"/>
                                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedDisabled" Color="#2A2A2A"/>

                                    <!-- 2. The Checkmark Glyph Color -->
                                    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#000000"/>
                                    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#000000"/>
                                    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#000000"/>
                                    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedDisabled" Color="#707070"/>

                                    <!-- 3. Border Stroke when CHECKED -->
                                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="Transparent"/>
                                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="Transparent"/>
                                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="Transparent"/>
                                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedDisabled" Color="Transparent"/>

                                    <!-- 4. Background Fill & Stroke when UNCHECKED -->
                                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked" Color="Transparent"/>
                                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="#808080"/>
                                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" Color="#B0B0B0"/>
                                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPressed" Color="#606060"/>

                                    <!-- 5. Label Text Foreground -->
                                    <SolidColorBrush x:Key="CheckBoxForeground" Color="#FFFFFF"/>
                                    <SolidColorBrush x:Key="CheckBoxForegroundPointerOver" Color="#FFFFFF"/>
                                    <SolidColorBrush x:Key="CheckBoxForegroundPressed" Color="#CCCCCC"/>
                                </CheckBox.Resources>
                            </CheckBox>

                            <Button  FontFamily="{StaticResource GlobalFontHolder}"  Click="btnMultiDeviceOptions_Click" IsEnabled="{x:Bind mediacontroller.MultiDeviceOutputFeature,Mode=OneWay}" Name="btnMultiDeviceOptions" Content="Multi-Device Audio Output Mixer" HorizontalAlignment="Center" Margin="0, 10" Grid.Row="9"/>
                            
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Frame>
        <TeachingTip Name="ttSpeedControl" >
            <videogeneral:PlaybackSpeed/>
        </TeachingTip>
        <TeachingTip Name="ttPitchControl">
            <audiogeneral:Pitch/>
        </TeachingTip>
        <TeachingTip Name="ttReverbControl">
            <audioadvanced:AudioReverb/>
        </TeachingTip>
        <TeachingTip Name="ttTutorial" Title="Welcome to Vusic Player!">
            <Grid Margin="20, 20" RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock 
            FontFamily="{StaticResource GlobalFontHolder}" 
            Text="New to Vusic Player? Check out our documentation, or support ongoing development!" 
            Style="{StaticResource BodyLargeStrongTextBlockStyle}" 
            TextWrapping="Wrap"/>

                <HyperlinkButton 
            FontFamily="{StaticResource GlobalFontHolder}" 
            Grid.Row="1" 
            Content="How To Use Vusic Player?" 
            NavigateUri="https://oceancyantech.github.io/Vusic-Player/howtousevusicplayer.html"/>

                <HyperlinkButton 
            FontFamily="{StaticResource GlobalFontHolder}" 
            Grid.Row="2" 
            Content="Support Vusic Player (Donate)" 
            NavigateUri="https://oceancyantech.github.io/Vusic-Player/donate.html"/>

                <Button 
            FontFamily="{StaticResource GlobalFontHolder}" 
            Style="{StaticResource AccentButtonStyle}" 
            Grid.Row="3" 
            Content="Close" 
            Name="btnCloseTutorial" 
            Click="btnCloseTutorial_Click"/>
            </Grid>
        </TeachingTip>
        <TeachingTip Margin="0, 10" Name="ttEXCEPTION" Title="Exception">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Image Width="40" Source="{Binding SourceError ,Source={StaticResource GlobalIconHolder}}"/>
                <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" FontFamily="{StaticResource GlobalFontHolder}"    Name="txtExceptionError"/>
            </StackPanel>
        </TeachingTip>
    
    </Grid>
</Page>
