<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Vusic_Player.Pages.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Vusic_Player.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:media="using:CommunityToolkit.WinUI.Media" xmlns:controls="using:CommunityToolkit.WinUI.Controls" xmlns:playback_views="using:Vusic_Player.UI.UserViews.Controls"
    mc:Ignorable="d">

    <Grid>
        <Frame Name="frmVid" Visibility="Collapsed"></Frame>
        <Frame Name="frmRoot">
            <Grid Name="grdRoot" Visibility="Visible" >
                <Grid.Background>
                    <ImageBrush x:Name="imgSourceBackground" ImageSource="/Assets/oceanglow.png" 
Stretch="UniformToFill"/>
                </Grid.Background>
                <Border CornerRadius="20" x:Name="Bordermain">
                    <Border.Background>
                        <media:BackdropBlurBrush Amount="10.0" x:Name="BackdropBlur"/>
                    </Border.Background>
                    <Grid ColumnSpacing="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition ></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                            <ColumnDefinition MaxWidth="700" MinWidth="280" x:Name="ColumnMaster" Width="300"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <NavigationView  IsBackButtonVisible="Auto" IsBackEnabled="True" BackRequested="nvgMain_BackRequested" Grid.Column="0" Background="Transparent" Name="nvgMain" PaneDisplayMode="Top" IsSettingsVisible="True" SelectionChanged="nvgMain_SelectionChanged">

                            <NavigationView.MenuItems>
                                <NavigationViewItem Name="nvgitHome" Content="Home" Tag="HomePage"></NavigationViewItem>
                                <NavigationViewItem Name="nvgitMusic" Content="Music Library" Tag="MusicLibrary"></NavigationViewItem>
                                <NavigationViewItem Name="nvgitVideo" Content="Video Library"></NavigationViewItem>
                                <NavigationViewItem Name="nvgitQueue" Content="Play Queue" Visibility="Visible"></NavigationViewItem>
                            </NavigationView.MenuItems>

                            <NavigationView.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <playback_views:MasterSearchControl Grid.Column="1" MinWidth="300" Margin="40, 0" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="0" Name="txtHeader" Text=""/>
                                </Grid>
                            </NavigationView.Header>

                            <Grid>
                                <Grid Visibility="Collapsed" Name="blackBackground" Background="Black" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"></Grid>

                                <Frame Name="frmMain" Navigated="FrmMain_Navigated" Background="Transparent">

                                </Frame>
                            </Grid>
                        </NavigationView>
                        <controls:GridSplitter Grid.Column="1" 
    Width="12" Margin="0, 0" Padding="0" x:Name="grdsplittr"
    ResizeBehavior="BasedOnAlignment">

                        </controls:GridSplitter>
                        <Grid RowSpacing="5" Visibility="Visible" Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="20, 0" Name="MusicPlayerMaster" Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"></RowDefinition>
                                <RowDefinition Height="Auto"></RowDefinition>
                                <RowDefinition Height="Auto"></RowDefinition>
                                <RowDefinition Height="Auto"></RowDefinition>
                                <RowDefinition Height="Auto"></RowDefinition>
                                <RowDefinition Height="Auto"></RowDefinition>
                                <RowDefinition Height="Auto"></RowDefinition>
                                <RowDefinition Height="Auto"></RowDefinition>
                                <RowDefinition Height="Auto"></RowDefinition>
                                <RowDefinition Height="Auto"></RowDefinition>
                            </Grid.RowDefinitions>
                            <Image Name="imgThumbnailCover" Source="{x:Bind mediacontroller.CoverThumbnail, Mode=OneWay}" Width="150" Grid.Row="0"></Image>

                            <TextBlock  Margin="0, 20, 0, 0" HorizontalAlignment="Center"  Name="txtSongName" TextTrimming="CharacterEllipsis" MaxLines="1" Grid.Row="1" Text="{x:Bind mediacontroller.MediaDisplayName, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind mediacontroller.MediaDisplayName, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="NoWrap" >

                            </TextBlock>
                            <Grid Grid.Row="2" Margin="0, 5, 0, 0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <HyperlinkButton Click="HyperlinkButton_Click" Grid.Column="0" Content="{x:Bind mediacontroller.ArtistDisplayName, Mode=OneWay}">

                                </HyperlinkButton>
                                <HyperlinkButton Click="HyperlinkButton_Click_1" Grid.Column="1" HorizontalAlignment="Right" Content="{x:Bind mediacontroller.AlbumDisplayName,Mode=OneWay}">

                                </HyperlinkButton>
                            </Grid>
                            <playback_views:OceanSlider Margin="0, 5, 0, 0" x:Name="sldMain" Value="{x:Bind mediacontroller.CurrentPosition, Mode=TwoWay}" Maximum="{x:Bind mediacontroller.TotalDuration, Mode=TwoWay}" DragStarted="sldMain_DragStarted" DragCompleted="sldMain_DragCompleted"  IsEnabled="True" Grid.Row="3" HorizontalAlignment="Stretch" ></playback_views:OceanSlider>

                            <Grid x:Name="grdTexts" Margin="5,10,0, 0" Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" HorizontalAlignment="Left" Text="{x:Bind mediacontroller.RunningDurationString, Mode=OneWay}" Name="txtRunningDuration" FontSize="11" Opacity="0.8"/>
                                <TextBlock Grid.Column="1" HorizontalAlignment="Right" Text="{x:Bind mediacontroller.TotalDurationString, Mode=OneWay}" Name="txtTotalDuration" FontSize="11" Opacity="0.8"/>
                            </Grid>

                            <playback_views:PlayPauseControls SpaceWidth="10" Margin="0, 5" Grid.Row="5" HorizontalAlignment="Center"></playback_views:PlayPauseControls>
                            <playback_views:VolumeSlider Margin="0, 0" Grid.Row="6"></playback_views:VolumeSlider>
                            <playback_views:PanelControlsAudioPlayer ExpandedViewButtonToolTip="Expanded View" Grid.Row="7"></playback_views:PanelControlsAudioPlayer>
                            <CheckBox HorizontalAlignment="Center" Name="chckMultioutput" Grid.Row="8" Content="Multi-Device Audio Output" Checked="chckMultioutput_Checked" Unchecked="chckMultioutput_Checked"/>

                            <Button Name="btnMultiDeviceOptions" Content="Multi-Device Audio Output Mixer" HorizontalAlignment="Center" Margin="0, 10" Grid.Row="9"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Frame>

    </Grid>
</Page>
