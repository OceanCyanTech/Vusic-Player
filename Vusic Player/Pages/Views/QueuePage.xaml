<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Vusic_Player.Pages.Views.QueuePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Vusic_Player.Pages.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:playback_views="using:Vusic_Player.UI.UserViews.Controls" xmlns:ui="using:CommunityToolkit.WinUI" xmlns:media="using:CommunityToolkit.WinUI.Media" xmlns:oceandialogcontrols="using:Vusic_Player.UI.UserViews.Controls.OceanDialogControls"
    mc:Ignorable="d">

    <Grid Margin="40, 0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition MaxWidth="450"></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <!--<Grid Grid.Column="0" VerticalAlignment="Stretch" Name="grdNowPlaying">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition ></RowDefinition>
            </Grid.RowDefinitions>
            <TextBlock  FontFamily="{StaticResource GlobalFontHolder}"  Text="Now Playing" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center" Grid.Row="0"></TextBlock>
            <vusic:PanelControlsAudioPlayer Grid.Row="1" ExpandedViewButtonToolTip="Expanded View"/>
        </Grid>-->
        <Grid Name="musicPlayerMaster" Grid.Column="0" CornerRadius="20" Margin="20, 30" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem FontFamily="{StaticResource GlobalFontHolder}"  Text="Open Media" Click="btnAddtoQueue_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE838;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </Grid.ContextFlyout>
            <Grid.Background>
                <ImageBrush ImageSource="{Binding BlurAesthetic, Source={StaticResource GlobalIconHolder}}" Stretch="UniformToFill"/>
            </Grid.Background>
            <Border CornerRadius="20">
                <Border.Background>
                    <media:BackdropBlurBrush Amount="5.0" />
                </Border.Background>
                <Grid CornerRadius="20" RowSpacing="20" Padding="30">
                    <Grid.Background>
                        <AcrylicBrush TintColor="Black" TintOpacity="0.05" Opacity="0.8" FallbackColor="Black" AlwaysUseFallback="False"/>
                    </Grid.Background>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                    </Grid.RowDefinitions>

                    <Image HorizontalAlignment="Center" Width="150" Grid.Row="0" Source="{x:Bind mediacontroller.CoverThumbnail, Mode=OneWay}"></Image>
                    <TextBlock  FontFamily="{StaticResource GlobalFontHolder}"  Margin="0,0,0,0" TextWrapping="NoWrap" HorizontalAlignment="Center" Text="{x:Bind mediacontroller.MediaDisplayName, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind mediacontroller.MediaDisplayName, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" Grid.Row="1"></TextBlock>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <HyperlinkButton Click="txtArtist_Click" Name="txtArtist" ToolTipService.ToolTip="Artist" HorizontalAlignment="Left" FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <TextBlock  FontFamily="{StaticResource GlobalFontHolder}"  Text="• "></TextBlock>
                                <TextBlock  FontFamily="{StaticResource GlobalFontHolder}"  Name="txtArtistDisplay" Text="{x:Bind mediacontroller.ArtistDisplayName, Mode=OneWay}"></TextBlock>
                            </StackPanel>
                        </HyperlinkButton>
                        <HyperlinkButton Click="txtAlbum_Click" ToolTipService.ToolTip="Album" Name="txtAlbum" Grid.Column="1" HorizontalAlignment="Right" FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <TextBlock  FontFamily="{StaticResource GlobalFontHolder}"  Text="• "></TextBlock>
                                <TextBlock  FontFamily="{StaticResource GlobalFontHolder}"  Name="txtAlbumDisplay" Text="{x:Bind mediacontroller.AlbumDisplayName, Mode=OneWay}"></TextBlock>
                            </StackPanel>
                        </HyperlinkButton>
                    </Grid>

                    <playback_views:OceanSlider Margin="0, 0" x:Name="sldMain" Value="{x:Bind mediacontroller.CurrentPosition, Mode=TwoWay}" Maximum="{x:Bind mediacontroller.TotalDuration, Mode=TwoWay}" DragStarted="sldMain_DragStarted" DragCompleted="sldMain_DragCompleted" IsEnabled="True" Grid.Row="3" HorizontalAlignment="Stretch" ></playback_views:OceanSlider>

                    <Grid x:Name="grdTexts" Margin="5,0,0, 0" Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock  FontFamily="{StaticResource GlobalFontHolder}"  Grid.Column="0" HorizontalAlignment="Left" Text="{x:Bind mediacontroller.RunningDurationString, Mode=OneWay}" Name="txtRunningDuration" FontSize="18" Opacity="0.8"/>
                        <TextBlock  FontFamily="{StaticResource GlobalFontHolder}"  Grid.Column="1" HorizontalAlignment="Right" Text="{x:Bind mediacontroller.TotalDurationString, Mode=OneWay}" Name="txtTotalDuration" FontSize="18" Opacity="0.8"/>
                    </Grid>

                    <Grid Width="300" Grid.Row="5" Margin="0, 0" Padding="15" CornerRadius="16">
                        <Grid.Background>
                            <AcrylicBrush TintColor="Black" TintOpacity="0.2" FallbackColor="Transparent" AlwaysUseFallback="False"/>
                        </Grid.Background>
                        <playback_views:PlayPauseControls SpaceWidth="20" ImageWidth="32" HorizontalAlignment="Center"></playback_views:PlayPauseControls>
                    </Grid>

                    <Grid Grid.Row="6" CornerRadius="16">
                        <Grid.Background>
                            <AcrylicBrush TintColor="Black" TintOpacity="0.1" FallbackColor="Transparent" AlwaysUseFallback="False"/>
                        </Grid.Background>
                        <playback_views:VolumeSlider />
                    </Grid>

                    <Grid Grid.Row="7" CornerRadius="16">
                        <Grid.Background>
                            <AcrylicBrush TintColor="Black" TintOpacity="0.1" FallbackColor="Transparent" AlwaysUseFallback="False"/>
                        </Grid.Background>
                        <playback_views:PanelControlsAudioPlayer ExpandedViewButtonToolTip="Normal View" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Column="1" HorizontalAlignment="Stretch">

            <Border x:Name="ShadowTarget2" />
            <Grid 
      Name="grdQueue"
      CornerRadius="20"
      Margin="50,0">
                <Grid.Background>
                    <AcrylicBrush TintColor="Black" 
TintOpacity="0" 
                   
FallbackColor="Black" 
AlwaysUseFallback="False"/>
                </Grid.Background>
                <ui:Effects.Shadow>
                    <ui:AttachedDropShadow CastTo="{x:Bind ShadowTarget2}" CornerRadius="20" BlurRadius="20" Opacity="0.5" Offset="0,0" />
                </ui:Effects.Shadow>
                <ScrollViewer>
                    <Grid>
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem FontFamily="{StaticResource GlobalFontHolder}"  Text="Add Media" Click="btnAddtoQueue_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE710;"></FontIcon>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Grid.ContextFlyout>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>


                        <!-- HEADER -->
                        <Grid Grid.Row="0" Padding="30,30,30,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="300"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Grid.Column="0">
                                <TextBlock  FontFamily="{StaticResource GlobalFontHolder}"  Text="Queue" 
                   Style="{StaticResource TitleTextBlockStyle}"/>
                                <TextBlock  FontFamily="{StaticResource GlobalFontHolder}"  Margin="10,10" Style="{StaticResource BaseTextBlockStyle}" ToolTipService.ToolTip="Playlist will play shuffled" Text="shuffled" Name="txtShuffled" Visibility="Collapsed" Foreground="{ThemeResource TextFillColorSecondaryBrush}"></TextBlock>
                            </StackPanel>
                            <AutoSuggestBox FontFamily="{StaticResource GlobalFontHolder}"   QuerySubmitted="asbFindQueue_QuerySubmitted"  IsEnabled="True" CornerRadius="12" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"  Grid.Column="1" Name="asbFindQueue" TextChanged="asbFindQueue_TextChanged"
                        QueryIcon="Find"
                        PlaceholderText="Find in queue..."
                        HorizontalAlignment="Stretch" Height="35" Width="300"/>
                        </Grid>


                        <!-- QUEUE INFO + CONTROLS -->
                        <Grid Grid.Row="1" Padding="30,0,30,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Queue information -->
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock  FontFamily="{StaticResource GlobalFontHolder}"  Text="{x:Bind mediacontroller.ItemsCount, Mode=OneWay}"
                       Name="txtCount"
                       Style="{StaticResource BaseTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                <TextBlock  FontFamily="{StaticResource GlobalFontHolder}"  Text="{x:Bind mediacontroller.TotalQueueRuntime, Mode=OneWay}"
                       Name="txtTotalDurQueue"
                       ToolTipService.ToolTip="Runtime Duration of queue"
                       Style="{StaticResource BaseTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>


                            <!-- Controls -->
                            <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="10">

                                <Button CornerRadius="12" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" IsEnabled="True" Name="btnRemoveSelectionFromQueue" Click="btnRemoveSelectionFromQueue_Click"
                    ToolTipService.ToolTip="Remove selection from queue">
                                    <Image Width="20" Source="{Binding DeleteIcon, Source={StaticResource GlobalIconHolder}}"/>
                                </Button>

                                <ToggleButton CornerRadius="12" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" Checked="tglShuffleQueue_Checked" Unchecked="tglShuffleQueue_Checked" Name="tglShuffleQueue"
                          ToolTipService.ToolTip="Shuffle Play Queue">
                                    <Image Width="20" Source="{Binding ShuffleIcon, Source={StaticResource GlobalIconHolder}}"/>
                                    <ToggleButton.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem FontFamily="{StaticResource GlobalFontHolder}"  Text="Shuffle and play all" Name="mnftShuffleandPlayAll">
                                                <MenuFlyoutItem.Icon>
                                                    <ImageIcon Source="/Assets/shuffleandplayallfonticon.png"/>
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </ToggleButton.ContextFlyout>
                                </ToggleButton>

                                <ToggleButton CornerRadius="12" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" IsEnabled="True"  Background="Transparent" Name="tglLoopQueue" Checked="tglLoopQueue_Checked" Unchecked="tglLoopQueue_Checked"
                          ToolTipService.ToolTip="Loop list">
                                    <Image Width="20" Source="{Binding LoopIcon, Source={StaticResource GlobalIconHolder}}"/>
                                </ToggleButton>

                                <Button  IsEnabled="True"  Background="Transparent" Name="btnClearQueue" Click="btnClearQueue_Click"
                    ToolTipService.ToolTip="Clear Queue">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Image Width="20" Source="{Binding Removeicon, Source={StaticResource GlobalIconHolder}}"/>
                                        <TextBlock  FontFamily="{StaticResource GlobalFontHolder}"  Name="txtClearQueue" Text="Clear queue"/>
                                    </StackPanel>
                                </Button>

                                <Button  IsEnabled="True"  Background="Transparent" Name="btnSaveQueue" Click="btnSaveQueue_Click"
                    ToolTipService.ToolTip="Save Queue to Playlist">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Image Width="20" Source="{Binding SaveIcon, Source={StaticResource GlobalIconHolder}}"/>
                                        <TextBlock  FontFamily="{StaticResource GlobalFontHolder}"  Text="Save Queue to Playlist"/>
                                    </StackPanel>
                                </Button>

                            </StackPanel>
                        </Grid>


                        <!-- SECTION LABEL -->
                        <StackPanel Orientation="Horizontal" Grid.Row="2" Spacing="10">
                            <TextBlock  FontFamily="{StaticResource GlobalFontHolder}"  
               Text="Up Next"
               Margin="30,0,0,10"
               FontSize="18" Name="txtUpNext"
               FontWeight="SemiBold"
               Opacity="0.85"/>

                            <ToggleButton CornerRadius="12" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" Checked="btnViewQueue_Checked" Unchecked="btnViewQueue_Checked"  Name="btnViewQueue"
>
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Image Width="20" Source="{Binding ViewFullQueue, Source={StaticResource GlobalIconHolder}}"/>
                                    <TextBlock  FontFamily="{StaticResource GlobalFontHolder}"  Text="View full queue"/>
                                </StackPanel>
                            </ToggleButton>
                            <Button IsEnabled="True" CornerRadius="12" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" Name="btnAddtoQueue" Click="btnAddtoQueue_Click"
ToolTipService.ToolTip="Add media to queue">
                                <Image Width="20" Source="{Binding AddIcon, Source={StaticResource GlobalIconHolder}}"/>
                            </Button>
                            <Button IsEnabled="True" Visibility="Collapsed" CornerRadius="12" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" Name="btnRestartandPlay" Click="btnRestartandPlay_Click"
ToolTipService.ToolTip="Play all from start">
                                <Image Width="20" Source="/Assets/appicon.png"/>
                            </Button>
                        </StackPanel>


                        <!-- QUEUE LIST -->

                        <ScrollView VerticalAlignment="Stretch" Margin="10, 0" Name="ListPanel"  Grid.Row="4">
                            <StackPanel  Orientation="Vertical">

                                <InfoBar FontFamily="{StaticResource GlobalFontHolder}"   IsOpen="False" Severity="Warning" Name="iBMissingFiles" Title="Missing files">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock  FontFamily="{StaticResource GlobalFontHolder}"  x:Name="infoBarMessage" Text="Some files could not be located." Margin="0,0,8,0"/>
                                        <Button Content="Relocate" Name="btnRelocate" Click="btnRelocate_Click"/>
                                    </StackPanel>
                                </InfoBar>

                            </StackPanel>
                        </ScrollView>

                        <playback_views:ListViewMedia SearchVisibility="Collapsed"  MediaSource="QueueList" ItemsSource="{x:Bind VusicQueueList}" Margin="30, 10" x:Name="lstViewQueue" Grid.Row="4"></playback_views:ListViewMedia>
                        <Grid  Grid.Row="3"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Name="grdNoSearchResults" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Button Grid.Row="0" Name="btnCloseSearch" CornerRadius="12" Background="Transparent" BorderBrush="Transparent" Click="btnCloseSearch_Click" ToolTipService.ToolTip="Close Search Results" HorizontalAlignment="Right" Margin="20, 0">
                                <FontIcon Glyph="&#xE711;" FontSize="36"></FontIcon>
                            </Button>
                            <Frame VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Row="1" Name="frmSearchResultsNOMATCH"></Frame>

                        </Grid>

                        <StackPanel Visibility="{x:Bind mediacontroller.QueuePageEmptyVisibility, Mode=OneWay}" Orientation="Vertical" Grid.Row="3" Spacing="20" HorizontalAlignment="Center" VerticalAlignment="Center" Name="grdEmptyQueue">
                            <StackPanel Spacing="20" Orientation="Horizontal">
                                <Image Source="{Binding EmptyQueue, Source={StaticResource GlobalIconHolder}}" Width="100"></Image>
                                <TextBlock  FontFamily="{StaticResource GlobalFontHolder}"  Text="Your play queue is empty!" VerticalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}"></TextBlock>
                            </StackPanel>

                            <Button CornerRadius="10" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" Click="btnAddtoQueue_Click" Name="btnOpenMediaFile">
                                <Button.Background>
                                    <AcrylicBrush TintColor="Black" 
TintOpacity="0.4" 
                   
FallbackColor="Black" 
AlwaysUseFallback="False"/>
                                </Button.Background>
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Modifiers="Control" Key="O"></KeyboardAccelerator>
                                </Button.KeyboardAccelerators>
                                <StackPanel  Orientation="Horizontal" Spacing="10">

                                    <Image Width="26" Source="{Binding Openfolder, Source={StaticResource GlobalIconHolder}}"></Image>
                                    <TextBlock  FontFamily="{StaticResource GlobalFontHolder}"  Foreground="White" Text="Open Media" Margin="0, 5">

                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
        <TeachingTip  FontFamily="{StaticResource GlobalFontHolder}"   Title="Edit Playlist" HorizontalContentAlignment="Stretch" Name="ttEditPlaylist" >
            <TeachingTip.Resources>
                <x:Double x:Key="TeachingTipMinWidth">800</x:Double>
                <x:Double x:Key="TeachingTipMaxWidth">600</x:Double>
            </TeachingTip.Resources>
            <Grid >
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <oceandialogcontrols:NewPlaylistCreation x:Name="newPlaylistCreationEdit"/>
                <Grid ColumnSpacing="10" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button  FontFamily="{StaticResource GlobalFontHolder}"  Name="btnSavePlaylistEdited" Content="Save Playlist" Style="{StaticResource AccentButtonStyle}"/>
                    <Button FontFamily="{StaticResource GlobalFontHolder}"   Name="btnCancelEdit" Click="btnCancelEdit_Click" Content="Cancel" Grid.Column="1"/>
                </Grid>
            </Grid>
        </TeachingTip>

    </Grid>
</Page>
