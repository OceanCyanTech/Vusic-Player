<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Vusic_Player.Pages.Views.LoggerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Vusic_Player.Pages.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowSpacing="10" Margin="0, 30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Grid Grid.Row="0" Margin="10, 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <AutoSuggestBox  FontFamily="{StaticResource GlobalFontHolder}"   QueryIcon="Find" VerticalAlignment="Center" PlaceholderText="Find log entries..." TextChanged="AutoSuggestBox_TextChanged" QuerySubmitted="AutoSuggestBox_QuerySubmitted">
                <AutoSuggestBox.Resources>
                    <!-- 1. Focused State (Accent Highlight on Border & Caret) -->
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource GlobalAccentColor}"/>
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1E1E1E"/>
                    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFFFFF"/>

                    <!-- 2. Resting / Unfocused State -->
                    <SolidColorBrush x:Key="TextControlBackground" Color="#202020"/>
                    <SolidColorBrush x:Key="TextControlForeground" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#404040"/>
                    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#808080"/>

                    <!-- 3. Pointer Over (Hover) State -->
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#2A2A2A"/>
                    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#555555"/>
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#999999"/>

                    <!-- 4. Text Selection Highlight -->
                    <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="{StaticResource GlobalAccentColor}"/>

                    <!-- 5. Query / Search Icon Button & Clear ("X") Button -->
                    <SolidColorBrush x:Key="AutoSuggestBoxButtonForeground" Color="#808080"/>
                    <SolidColorBrush x:Key="AutoSuggestBoxButtonForegroundPointerOver" Color="{StaticResource GlobalAccentColorPointerOver}"/>
                    <SolidColorBrush x:Key="AutoSuggestBoxButtonForegroundPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                    <SolidColorBrush x:Key="AutoSuggestBoxButtonBackgroundPointerOver" Color="#303030"/>
                    <SolidColorBrush x:Key="AutoSuggestBoxButtonBackgroundPressed" Color="#404040"/>

                    <!-- 6. Suggestions Dropdown Popup (ListView items) -->
                    <!-- Background surface of the dropdown overlay -->
                    <SolidColorBrush x:Key="AutoSuggestBoxSuggestionsListBackground" Color="#1E1E1E"/>

                    <!-- Hovered suggestion item -->
                    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#2C2C2C"/>
                    <SolidColorBrush x:Key="ListViewItemForegroundPointerOver" Color="#FFFFFF"/>

                    <!-- Selected suggestion item (Focused or Arrow-Key Navigated) -->
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#333333"/>
                    <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#383838"/>

                    <!-- Selection Indicator Pill on the left of the item -->
                    <SolidColorBrush x:Key="ListViewItemSelectionIndicatorFill" Color="{StaticResource GlobalAccentColor}"/>
                    <SolidColorBrush x:Key="ListViewItemSelectionIndicatorFillPointerOver" Color="{StaticResource GlobalAccentColorPointerOver}"/>

                    <!-- 7. Disabled State -->
                    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#181818"/>
                    <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#505050"/>
                    <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#2A2A2A"/>
                </AutoSuggestBox.Resources>
            </AutoSuggestBox>
            <StackPanel Orientation="Horizontal"
                 HorizontalAlignment="Right"
                 Margin="10" Grid.Column="1">
                <Button  FontFamily="{StaticResource GlobalFontHolder}"   Content="Export Log" Style="{StaticResource AccentButtonStyle}"
                 Click="Button_Click_1" Background="{StaticResource GlobalAccentColor}" >
                    <Button.Resources>
                        <SolidColorBrush x:Key="AccentButtonBackground" Color="{StaticResource GlobalAccentColor}"/>
                        <SolidColorBrush x:Key="AccentButtonForeground" Color="#0B0D13"/>
                        <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent"/>

                        <!-- Pointer Over (Hover) -->
                        <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{StaticResource GlobalAccentColorPointerOver}"/>
                        <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#0B0D13"/>
                        <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="Transparent"/>

                        <!-- Pressed State -->
                        <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                        <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="Transparent"/>

                        <!-- Disabled State -->
                        <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#2A2A2A"/>
                        <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#707070"/>
                        <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="Transparent"/>
                    </Button.Resources>
                </Button>
                <Button  FontFamily="{StaticResource GlobalFontHolder}"   Content="Refresh Log" Margin="10, 0" Style="{StaticResource AccentButtonStyle}"
         Click="Button_Click_2" Background="{StaticResource GlobalAccentColor}" >
                    <Button.Resources>
                        <SolidColorBrush x:Key="AccentButtonBackground" Color="{StaticResource GlobalAccentColor}"/>
                        <SolidColorBrush x:Key="AccentButtonForeground" Color="#0B0D13"/>
                        <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent"/>

                        <!-- Pointer Over (Hover) -->
                        <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{StaticResource GlobalAccentColorPointerOver}"/>
                        <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#0B0D13"/>
                        <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="Transparent"/>

                        <!-- Pressed State -->
                        <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                        <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="Transparent"/>

                        <!-- Disabled State -->
                        <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#2A2A2A"/>
                        <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#707070"/>
                        <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="Transparent"/>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
   

        <!-- Tabs -->
      
                <Grid RowSpacing="20" Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition />
                    </Grid.RowDefinitions>
            <TextBlock  FontFamily="{StaticResource GlobalFontHolder}"   Text="No log information available!" Name="txtNoLogs" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0, 20" Style="{StaticResource TitleTextBlockStyle}"></TextBlock>
                    <Grid Grid.Row="1" Margin="10, 0" ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Filter Logs: " VerticalAlignment="Center"/>
                <CheckBox  FontFamily="{StaticResource GlobalFontHolder}"   Grid.Column="1" Content="Error" Name="chckShowErrors" IsChecked="True" Checked="chckShowErrors_Checked" Unchecked="chckShowErrors_Checked">
                    <CheckBox.Resources>
                        <!-- Checked State (Background box fill) -->
                        <SolidColorBrush x:Key="CheckBoxFillColorDefault" Color="{StaticResource GlobalAccentColor}"/>
                        <SolidColorBrush x:Key="CheckBoxFillColorPointerOver" Color="{StaticResource GlobalAccentColorPointerOver}"/>
                        <SolidColorBrush x:Key="CheckBoxFillColorPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                        <SolidColorBrush x:Key="CheckBoxFillColorDisabled" Color="#2A2A2A"/>

                        <!-- Checkmark Glyph Color (The tick mark inside the box) -->
                        <SolidColorBrush x:Key="CheckBoxCheckGlyphForeground" Color="#000000"/>
                        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundPointerOver" Color="#000000"/>
                        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundPressed" Color="#000000"/>
                        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundDisabled" Color="#707070"/>

                        <!-- Unchecked State (Empty box outline border) -->
                        <SolidColorBrush x:Key="CheckBoxStrokeColorDefault" Color="#808080"/>
                        <SolidColorBrush x:Key="CheckBoxStrokeColorPointerOver" Color="#B0B0B0"/>
                        <SolidColorBrush x:Key="CheckBoxStrokeColorPressed" Color="#606060"/>

                        <!-- Text Label Foreground -->
                        <SolidColorBrush x:Key="CheckBoxForeground" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="CheckBoxForegroundPointerOver" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="CheckBoxForegroundPressed" Color="#CCCCCC"/>
                    </CheckBox.Resources>
                </CheckBox>

                <CheckBox FontFamily="{StaticResource GlobalFontHolder}"   Grid.Column="2" Content="Successful" Name="chckShowSuccess" IsChecked="True" Checked="chckShowSuccess_Checked" Unchecked="chckShowSuccess_Checked">
                    <CheckBox.Resources>
                        <!-- Checked State (Background box fill) -->
                        <SolidColorBrush x:Key="CheckBoxFillColorDefault" Color="{StaticResource GlobalAccentColor}"/>
                        <SolidColorBrush x:Key="CheckBoxFillColorPointerOver" Color="{StaticResource GlobalAccentColorPointerOver}"/>
                        <SolidColorBrush x:Key="CheckBoxFillColorPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                        <SolidColorBrush x:Key="CheckBoxFillColorDisabled" Color="#2A2A2A"/>

                        <!-- Checkmark Glyph Color (The tick mark inside the box) -->
                        <SolidColorBrush x:Key="CheckBoxCheckGlyphForeground" Color="#000000"/>
                        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundPointerOver" Color="#000000"/>
                        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundPressed" Color="#000000"/>
                        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundDisabled" Color="#707070"/>

                        <!-- Unchecked State (Empty box outline border) -->
                        <SolidColorBrush x:Key="CheckBoxStrokeColorDefault" Color="#808080"/>
                        <SolidColorBrush x:Key="CheckBoxStrokeColorPointerOver" Color="#B0B0B0"/>
                        <SolidColorBrush x:Key="CheckBoxStrokeColorPressed" Color="#606060"/>

                        <!-- Text Label Foreground -->
                        <SolidColorBrush x:Key="CheckBoxForeground" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="CheckBoxForegroundPointerOver" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="CheckBoxForegroundPressed" Color="#CCCCCC"/>
                    </CheckBox.Resources>
                </CheckBox>

                <CheckBox FontFamily="{StaticResource GlobalFontHolder}"   Grid.Column="3" Content="Information" Name="chckShowInformation" IsChecked="True" Checked="chckShowInformation_Checked" Unchecked="chckShowInformation_Checked">
                    <CheckBox.Resources>
                        <!-- Checked State (Background box fill) -->
                        <SolidColorBrush x:Key="CheckBoxFillColorDefault" Color="{StaticResource GlobalAccentColor}"/>
                        <SolidColorBrush x:Key="CheckBoxFillColorPointerOver" Color="{StaticResource GlobalAccentColorPointerOver}"/>
                        <SolidColorBrush x:Key="CheckBoxFillColorPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                        <SolidColorBrush x:Key="CheckBoxFillColorDisabled" Color="#2A2A2A"/>

                        <!-- Checkmark Glyph Color (The tick mark inside the box) -->
                        <SolidColorBrush x:Key="CheckBoxCheckGlyphForeground" Color="#000000"/>
                        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundPointerOver" Color="#000000"/>
                        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundPressed" Color="#000000"/>
                        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundDisabled" Color="#707070"/>

                        <!-- Unchecked State (Empty box outline border) -->
                        <SolidColorBrush x:Key="CheckBoxStrokeColorDefault" Color="#808080"/>
                        <SolidColorBrush x:Key="CheckBoxStrokeColorPointerOver" Color="#B0B0B0"/>
                        <SolidColorBrush x:Key="CheckBoxStrokeColorPressed" Color="#606060"/>

                        <!-- Text Label Foreground -->
                        <SolidColorBrush x:Key="CheckBoxForeground" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="CheckBoxForegroundPointerOver" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="CheckBoxForegroundPressed" Color="#CCCCCC"/>
                    </CheckBox.Resources>
                </CheckBox>

                <CheckBox FontFamily="{StaticResource GlobalFontHolder}"   Grid.Column="4" Content="Warning" Name="chckShowWarning" IsChecked="True" Checked="chckShowWarning_Checked" Unchecked="chckShowWarning_Checked">
                    <CheckBox.Resources>
                        <!-- Checked State (Background box fill) -->
                        <SolidColorBrush x:Key="CheckBoxFillColorDefault" Color="{StaticResource GlobalAccentColor}"/>
                        <SolidColorBrush x:Key="CheckBoxFillColorPointerOver" Color="{StaticResource GlobalAccentColorPointerOver}"/>
                        <SolidColorBrush x:Key="CheckBoxFillColorPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                        <SolidColorBrush x:Key="CheckBoxFillColorDisabled" Color="#2A2A2A"/>

                        <!-- Checkmark Glyph Color (The tick mark inside the box) -->
                        <SolidColorBrush x:Key="CheckBoxCheckGlyphForeground" Color="#000000"/>
                        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundPointerOver" Color="#000000"/>
                        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundPressed" Color="#000000"/>
                        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundDisabled" Color="#707070"/>

                        <!-- Unchecked State (Empty box outline border) -->
                        <SolidColorBrush x:Key="CheckBoxStrokeColorDefault" Color="#808080"/>
                        <SolidColorBrush x:Key="CheckBoxStrokeColorPointerOver" Color="#B0B0B0"/>
                        <SolidColorBrush x:Key="CheckBoxStrokeColorPressed" Color="#606060"/>

                        <!-- Text Label Foreground -->
                        <SolidColorBrush x:Key="CheckBoxForeground" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="CheckBoxForegroundPointerOver" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="CheckBoxForegroundPressed" Color="#CCCCCC"/>
                    </CheckBox.Resources>
                </CheckBox>

            </Grid>
                    <Grid Margin="0, 0" Background="{ThemeResource SystemControlBackgroundAltHighBrush}" Padding="30, 0" Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <!-- Icon -->
                            <ColumnDefinition/>
                            <!-- Level -->
                            <ColumnDefinition />
                            <!-- Timestamp -->
                            <ColumnDefinition />
                            <!-- Message -->
                            <ColumnDefinition />
                            <!-- Source -->
                            <ColumnDefinition />
                            <!-- Button -->
                        </Grid.ColumnDefinitions>

                        <Button Click="Button_Click_3" Grid.Column="1" FontWeight="Bold" Background="Transparent" BorderBrush="Transparent">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Name="fntIconDirectionLevel" />
                        <TextBlock  FontFamily="{StaticResource GlobalFontHolder}"   Text="Level" />
                            </StackPanel>
                        </Button>
                        <Button Click="Button_Click_4" Grid.Column="2" FontWeight="Bold" Background="Transparent" BorderBrush="Transparent">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Name="fntIconDirectionTimeStamp" Glyph="&#xE70E;"/>
                        <TextBlock FontFamily="{StaticResource GlobalFontHolder}"   Text="Timestamp" />
                            </StackPanel>
                        </Button>
                        <Button Click="Button_Click_5" Grid.Column="3" FontWeight="Bold" Background="Transparent" BorderBrush="Transparent">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Name="fntIconDirectionSource" />
                        <TextBlock FontFamily="{StaticResource GlobalFontHolder}"   Text="Source" />
                            </StackPanel>
                        </Button>
                        <Button Click="Button_Click_6" Grid.Column="4" FontWeight="Bold" Background="Transparent" BorderBrush="Transparent">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Name="fntIconDirectionMessage" />
                        <TextBlock FontFamily="{StaticResource GlobalFontHolder}"   Text="Message" />
                            </StackPanel>
                        </Button>

                    </Grid>

                    <ListView Name="lstViewPlayerLogs" Grid.Row="3">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{Binding Icon}"
                                       Width="16"
                                       Height="16"
                                       Margin="0,0,10,0"/>
                            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"   Text="{Binding Level}"
                                           FontWeight="Bold"
                                           Margin="0,0,10,0" Grid.Column="1"/>
                            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"   Foreground="{ThemeResource TextFillColorSecondaryBrush}"  Text="{Binding Timestamp}"
                                           Margin="0,0,10,0" Grid.Column="2"/>
                            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"   ToolTipService.ToolTip="{Binding Source}" IsTextSelectionEnabled="True" Text="{Binding Source}" Grid.Column="3"/>
                            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"   Grid.Column="4"  IsTextSelectionEnabled="True" Margin="10,0,0,0" Text="{Binding Message}" ToolTipService.ToolTip="{Binding Message}"/>

                                    <Button Grid.Column="5" Background="Transparent" BorderBrush="Transparent" Margin="10,0,0,0"
                                        Click="Button_Click" ToolTipService.ToolTip="Copy Log">
                                        <FontIcon Glyph="&#xE8C8;" />
                                        <Button.Flyout>
                                            <Flyout >
                                        <TextBlock FontFamily="{StaticResource GlobalFontHolder}"   Text="Copied ✔️"></TextBlock>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
            <Grid  Grid.Row="3"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Name="grdNoSearchResults" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>
                <Button Grid.Row="0" Name="btnCloseSearch" CornerRadius="12" Background="Transparent" BorderBrush="Transparent" Click="btnCloseSearch_Click" ToolTipService.ToolTip="Close Search Results" HorizontalAlignment="Right" Margin="20, 0">
                    <FontIcon Glyph="&#xE711;" FontSize="36"></FontIcon>
                </Button>
                <Frame VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Row="1" Name="frmSearchResultsNOMATCH"></Frame>

            </Grid>
        </Grid>
    
    </Grid>

</Page>
