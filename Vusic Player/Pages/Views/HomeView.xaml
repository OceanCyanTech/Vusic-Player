<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Vusic_Player.Pages.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Vusic_Player.Pages.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:grids="using:Vusic_Player.UI.UserViews.Grids"
    mc:Ignorable="d">

    <ScrollViewer>
        <Grid  Margin="40, 20" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
            </Grid.RowDefinitions>
            <TextBlock Text="Welcome"  FontFamily="{StaticResource GlobalFontHolder}"  Style="{StaticResource TitleLargeTextBlockStyle}" Grid.Row="0"></TextBlock>
            <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0, 20" Spacing="10">
                <Button Name="btnOpenFolder" CornerRadius="12" Margin="0, 0"  Click="btnOpenFolder_Click">
                    <StackPanel Orientation="Horizontal">
                        <Image Width="20" Source="{Binding Openfolder, Source={StaticResource GlobalIconHolder}}"></Image>
                        <TextBlock  VerticalAlignment="Bottom"   FontFamily="{StaticResource GlobalFontHolder}"  Margin="5,0" Text="Open Folder" Style="{StaticResource BodyTextBlockStyle}"></TextBlock>
                    </StackPanel>
                </Button>
                <Button CornerRadius="12" ToolTipService.ToolTip="(Ctrl + O) Open and play any video or audio" Click="btnOpenMedia_Click">
                    <StackPanel Orientation="Horizontal">
                        <Image VerticalAlignment="Top" Width="20" Source="{Binding Importicon, Source={StaticResource GlobalIconHolder}}"></Image>
                        <TextBlock VerticalAlignment="Bottom" FontFamily="{StaticResource GlobalFontHolder}"    Margin="5,0" Text="Open Media"  Style="{StaticResource BodyTextBlockStyle}"></TextBlock>
                    </StackPanel>
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="O"></KeyboardAccelerator>
                    </Button.KeyboardAccelerators>
                </Button>
            </StackPanel>

            <Expander   IsExpanded="False"  Expanding="expRecentsVideo_Expanding" Name="expRecentsVideo" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch" Header="Continue Playing" HorizontalAlignment="Stretch"  Grid.Row="2">
                <Expander.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="Continue Playing" FontFamily="{StaticResource GlobalFontHolder}"/>
                    </DataTemplate>
                </Expander.HeaderTemplate>
                <grids:ContinuePlayingRecentsVideo Margin="0, 10"/>
            </Expander>

            <StackPanel Orientation="Horizontal" Grid.Row="3" Spacing="10">
                <TextBlock  FontFamily="{StaticResource GlobalFontHolder}"  Name="txtDisplay1" Tapped="TextBlock_Tapped" Text="Your Recently Listened" Grid.Row="3" Padding="15" Style="{StaticResource TitleTextBlockStyle}"></TextBlock>
            </StackPanel>

            <Expander HorizontalContentAlignment="Stretch" Header="Recent Music" HorizontalAlignment="Stretch" Grid.Row="4"  IsExpanded="False"  Expanding="expRecentsVideo_Expanding" Name="expRecentMusic">
                <Expander.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="Recent Music" FontFamily="{StaticResource GlobalFontHolder}"/>
                    </DataTemplate>
                </Expander.HeaderTemplate>

                <grids:RecentMusicList />

            </Expander>

            <StackPanel Orientation="Horizontal" Grid.Row="5" Spacing="10">
                <TextBlock FontFamily="{StaticResource GlobalFontHolder}" Name="txtDisplay2" Tapped="TextBlock_Tapped_1" Text="Music For You" Grid.Row="3" Padding="15" Style="{StaticResource TitleTextBlockStyle}"></TextBlock>
            </StackPanel>

            <Expander Grid.Row="6" HorizontalContentAlignment="Stretch" Header="Music Suggestions" HorizontalAlignment="Stretch" IsExpanded="False" Expanding="expRecentsVideo_Expanding" Name="expMusicMix">
                <Expander.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="Music Suggestions" FontFamily="{StaticResource GlobalFontHolder}"/>
                    </DataTemplate>
                </Expander.HeaderTemplate>

                <grids:MusicListHome />

            </Expander>

            <StackPanel Name="txtDisplay3" Orientation="Horizontal" Grid.Row="7" Spacing="10" Margin="0, 10">
                <TextBlock FontFamily="{StaticResource GlobalFontHolder}" Tapped="TextBlock_Tapped_2" Text="Jump back to your favourites" Grid.Row="3" Padding="15" Style="{StaticResource TitleTextBlockStyle}"></TextBlock>
                <HyperlinkButton FontFamily="{StaticResource GlobalFontHolder}" Name="hypViewAllFav" Click="hypViewAllFav_Click" Content="View all favourites" FontSize="16" Margin="0, 10"></HyperlinkButton>
            </StackPanel>

            <Expander FontFamily="{StaticResource GlobalFontHolder}" Grid.Row="8" HorizontalContentAlignment="Stretch" Header="Recommended Favourites" HorizontalAlignment="Stretch" IsExpanded="False" Expanding="expRecentsVideo_Expanding" Name="expFav">
                <Expander.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="Recommended Favourites" FontFamily="{StaticResource GlobalFontHolder}"/>
                    </DataTemplate>
                </Expander.HeaderTemplate>
                <grids:Favourites />

            </Expander>
            <StackPanel Orientation="Horizontal" Grid.Row="9" Spacing="10">
                <TextBlock FontFamily="{StaticResource GlobalFontHolder}" Tapped="TextBlock_Tapped_1" Text="Folders Opened" Grid.Row="3" Padding="15" Style="{StaticResource TitleTextBlockStyle}"></TextBlock>
            </StackPanel>
            <StackPanel Visibility="Collapsed" Name="stkFoldersOptions" Orientation="Horizontal" Spacing="20" Grid.Row="10">
                <CheckBox Content="Select" Grid.Row="1" Margin="0, 5" Name="chkSelect" Checked="chkSelect_Checked" Unchecked="chkSelect_Checked"></CheckBox>
                <StackPanel Name="selectMoreOptions" Visibility="Collapsed" Margin="0, 5" Orientation="Horizontal">
                    <CheckBox Content="Select all" Name="chckSelectAllFolders" Visibility="Visible" Checked="chckSelectAllFolders_Checked" Unchecked="chckSelectAllFolders_Checked"/>
                    <Button ToolTipService.ToolTip="Remove from Folders Opened" Background="Transparent" BorderBrush="Transparent" Visibility="Visible" Margin="0, 0"  Click="btnRemove_Click"  Name="btnRemove" >
                        <StackPanel Orientation="Horizontal">
                            <Image Width="20" Source="{Binding Removeicon, Source={StaticResource GlobalIconHolder}}"></Image>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <GridView ItemsSource="{x:Bind FoldersOpened, Mode=OneWay}" Visibility="Collapsed"  Grid.Row="11" Name="grdViewFoldersOpened" ItemClick="grdViewFoldersOpened_ItemClick" IsItemClickEnabled="True">
                <GridView.ItemTemplate>
                    <DataTemplate >
                        <Grid Width="120" 
                  Height="120" 
                  Padding="8"
                  CornerRadius="8"
                  Background="Transparent"
                  ToolTipService.ToolTip="{Binding FolderPath}">

                            <!-- Right-click Context Menu -->
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem FontFamily="{StaticResource GlobalFontHolder}" Text="Open Folder" 
                                        Icon="Folder" Name="mnftOpenFolder"
                                        Click="mnftOpenFolder_Click" />
                                    <MenuFlyoutItem FontFamily="{StaticResource GlobalFontHolder}" Text="Open Folder Location" 
                                        Icon="OpenFile"
                                        Name="mnftOpenFolderLoc"
                                        Click="mnftOpenFolderLoc_Click" />
                                    <MenuFlyoutItem FontFamily="{StaticResource GlobalFontHolder}" Text="Copy Folder Path" 
                                        Icon="Copy"
                               Name="mnftCopyFolderLoc"
     Click="mnftCopyFolderLoc_Click"/>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem FontFamily="{StaticResource GlobalFontHolder}" Text="Remove Folder from List" 
                                        Icon="Delete"
                                             Name="mnftRemoveFolderLoc"
     Click="mnftRemoveFolderLoc_Click" />
                                </MenuFlyout>
                            </Grid.ContextFlyout>

                            <!-- Folder Item Layout -->
                            <StackPanel HorizontalAlignment="Center" 
                            VerticalAlignment="Center" 
                            Spacing="6">
                                <Image Width="80" Source="{Binding FolderIcon, Source={StaticResource GlobalIconHolder}}" />
                                <TextBlock FontFamily="{StaticResource GlobalFontHolder}" Text="{Binding FolderName}" 
                               FontSize="12"
                               TextTrimming="CharacterEllipsis" 
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               MaxWidth="104" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
            <Grid Name="grdEmptySuggestions" HorizontalAlignment="Center" Grid.Column="0" Grid.Row="12" Visibility="Visible" >
                <StackPanel Orientation="Vertical" Spacing="15">
                    <StackPanel Orientation="Vertical" Spacing="20">
                        <Image Width="90" Source="{Binding FolderIcon, Source={StaticResource GlobalIconHolder}}"></Image>
                        <TextBlock  FontFamily="{StaticResource GlobalFontHolder}"  HorizontalAlignment="Center" TextWrapping="Wrap" Text="No Folders have been opened yet!" Style="{StaticResource SubtitleTextBlockStyle}"></TextBlock>
                        <Button HorizontalAlignment="Center" Name="btnOpenFolder2" CornerRadius="12" Margin="0, 0"  Click="btnOpenFolder_Click">
                            <StackPanel Orientation="Horizontal">
                                <Image Width="20" Source="{Binding Openfolder, Source={StaticResource GlobalIconHolder}}"></Image>
                                <TextBlock FontFamily="{StaticResource GlobalFontHolder}" VerticalAlignment="Bottom" Margin="5,0" Text="Open Folder" Style="{StaticResource BodyTextBlockStyle}"></TextBlock>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Button Visibility="Collapsed" Content="NAVIGATE PRIVATE" Click="Button_Click"/>
        </Grid>
    </ScrollViewer>

</Page>
