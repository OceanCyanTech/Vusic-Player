                            <MenuFlyoutSeparator Grid.Row="6"/>
                            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Text="Maximum Search Results" Style="{StaticResource SubtitleTextBlockStyle}" Grid.Row="2"/>
