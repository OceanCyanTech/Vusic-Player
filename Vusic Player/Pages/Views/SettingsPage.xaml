                                                    <SolidColorBrush x:Key="AutoSuggestBoxSuggestionsListBackground" Color="#1E1E1E"/>

                                                    <!-- Hovered suggestion item -->
                                                    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#2C2C2C"/>
                                                    <SolidColorBrush x:Key="ListViewItemForegroundPointerOver" Color="#FFFFFF"/>

                                                    <!-- Selected suggestion item (Focused or Arrow-Key Navigated) -->
                                                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#333333"/>
                                                    <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="#FFFFFF"/>
                                                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#383838"/>

