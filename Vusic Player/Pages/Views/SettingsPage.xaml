<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Vusic_Player.Pages.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Vusic_Player.Pages.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:grids="using:Vusic_Player.UI.UserViews.Grids" xmlns:controls1="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">
    <Page.Resources>
        <grids:CountToVisibility x:Key="CountToVisConverter"/>
        <grids:CountToVisibilityReverse x:Key="CountToVisReverseConverter"/>
    </Page.Resources>
    <Grid  Margin="30, 30">
        <NavigationView IsBackButtonVisible="Collapsed" PaneDisplayMode="Top" SelectionChanged="nvgNavigationMain_SelectionChanged" IsSettingsVisible="False"  Name="nvgNavigationMain">
            <NavigationView.Resources>
                <!-- The default selection indicator bar color -->
                <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" 
  Color="{StaticResource GlobalAccentColor}"/>


            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem FontFamily="{StaticResource GlobalFontHolder}"   Name="nvgitPlayback" Content="General"/>
                <NavigationViewItem FontFamily="{StaticResource GlobalFontHolder}"   Name="nvgitHomePage" Content="Home Page Options"/>

                <NavigationViewItem FontFamily="{StaticResource GlobalFontHolder}"   Name="nvgitMusicOptions" Content="Music Options"/>
                <NavigationViewItem FontFamily="{StaticResource GlobalFontHolder}"   Name="nvgitVideoOptions" Content="Video Options"/>
                <NavigationViewItem FontFamily="{StaticResource GlobalFontHolder}"   Name="nvgitAppSettings" Content="App Config"/>
                <NavigationViewItem FontFamily="{StaticResource GlobalFontHolder}"   Name="nvgitAboutHelp" Content="About &amp; Help"/>
            </NavigationView.MenuItems>
            <ScrollViewer>
                <Grid Background="Transparent" Margin="30, 30">
                    <Grid Name="grdAppSettings" RowSpacing="30">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Text="App Configuration" Style="{StaticResource TitleTextBlockStyle}"/>
                        <MenuFlyoutSeparator Grid.Row="1"/>
                        <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Text="App Log" Grid.Row="2" Style="{StaticResource SubtitleTextBlockStyle}"/>
                        <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Text="View events that are recorded when Vusic Player performs informative/successful actions or unexpectedly crashes due to bugs" Style="{StaticResource BodyStrongTextBlockStyle}" Grid.Row="3"/>
                        <Button FontFamily="{StaticResource GlobalFontHolder}" Name="btnViewLog" Grid.Row="4" Content="View App Log" Style="{StaticResource AccentButtonStyle}" Click="btnViewLog_Click" Background="{StaticResource GlobalAccentColor}" >
                            <Button.Resources>
                                <SolidColorBrush x:Key="AccentButtonBackground" Color="{StaticResource GlobalAccentColor}"/>
                                <SolidColorBrush x:Key="AccentButtonForeground" Color="#0B0D13"/>
                                <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent"/>

                                <!-- Pointer Over (Hover) -->
                                <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{StaticResource GlobalAccentColorPointerOver}"/>
                                <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#0B0D13"/>
                                <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="Transparent"/>

                                <!-- Pressed State -->
                                <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                                <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF"/>
                                <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="Transparent"/>

                                <!-- Disabled State -->
                                <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#2A2A2A"/>
                                <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#707070"/>
                                <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="Transparent"/>
                            </Button.Resources>
                        </Button>
                        <MenuFlyoutSeparator Grid.Row="5"/>
                        <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Text="Media Database" Grid.Row="6" Style="{StaticResource SubtitleTextBlockStyle}"/>
                        <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Text="Re-scan the media database. The media database will be cleared and rescaned fresh." Style="{StaticResource BodyStrongTextBlockStyle}" Grid.Row="7"/>
                        <Button Content="Re-scan Database" Name="btnRefreshDatabase" Click="btnRefreshDatabase_Click" Grid.Row="8"/>
                        <MenuFlyoutSeparator Grid.Row="9"/>
                        <StackPanel Orientation="Vertical" Spacing="30" Grid.Row="10">
                            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Name="txtFolderPermissions" Text="Folder Permissions" Grid.Row="6" Style="{StaticResource SubtitleTextBlockStyle}"/>
                            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Text="Toggle or add folders that Vusic Player is allowed to read and display in the Library Pages." Style="{StaticResource BodyStrongTextBlockStyle}" Grid.Row="3"/>
                            <controls1:WrapPanel VerticalAlignment="Stretch" MaxHeight="95" Orientation="Horizontal" Grid.Row="1" Margin="0, 20" >
                                <GridView SelectionMode="None" VerticalAlignment="Stretch" Name="grdViewFolders" Grid.Row="1">
                                    <GridView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsWrapGrid Orientation="Horizontal" ItemWidth="NaN" />
                                        </ItemsPanelTemplate>
                                    </GridView.ItemsPanel>
                                    <GridView.ItemTemplate>
                                        <DataTemplate>
                                            <ToggleButton VerticalAlignment="Stretch" IsChecked="{Binding isChecked}" Width="160" Margin="5, 0" HorizontalAlignment="Stretch" ToolTipService.ToolTip="{Binding FolderPath}"  CornerRadius="16"  Name="btnGenericFolder" Checked="btnGenericFolder_Checked" Unchecked="btnGenericFolder_Checked" FontSize="16" Padding="10" Content="{Binding FolderName}" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" Background="Transparent" Grid.Column="0">
                                                <ToggleButton.Resources>
                                                    <!-- 1. Background Fill when CHECKED -->
                                                    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{StaticResource GlobalAccentColor}"/>
                                                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{StaticResource GlobalAccentColorPointerOver}"/>
                                                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                                                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedDisabled" Color="#2A2A2A"/>

                                                    <!-- 2. Text / Icon Foreground when CHECKED -->
                                                    <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#000000"/>
                                                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#000000"/>
                                                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#000000"/>
                                                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedDisabled" Color="#707070"/>

                                                    <!-- 3. Border Stroke when CHECKED -->
                                                    <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent"/>
                                                    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent"/>
                                                    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent"/>
                                                    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedDisabled" Color="Transparent"/>

                                                    <!-- 4. Background Fill when UNCHECKED -->
                                                    <SolidColorBrush x:Key="ToggleButtonBackground" Color="#202020"/>
                                                    <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#2D2D2D"/>
                                                    <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#181818"/>
                                                    <SolidColorBrush x:Key="ToggleButtonBackgroundDisabled" Color="#1E1E1E"/>

                                                    <!-- 5. Text / Icon Foreground when UNCHECKED -->
                                                    <SolidColorBrush x:Key="ToggleButtonForeground" Color="#FFFFFF"/>
                                                    <SolidColorBrush x:Key="ToggleButtonForegroundPointerOver" Color="#FFFFFF"/>
                                                    <SolidColorBrush x:Key="ToggleButtonForegroundPressed" Color="#CCCCCC"/>
                                                    <SolidColorBrush x:Key="ToggleButtonForegroundDisabled" Color="#505050"/>

                                                    <!-- 6. Border Stroke when UNCHECKED -->
                                                    <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="#404040"/>
                                                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="#555555"/>
                                                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="#303030"/>
                                                    <SolidColorBrush x:Key="ToggleButtonBorderBrushDisabled" Color="#2A2A2A"/>
                                                </ToggleButton.Resources>
                                                <ToggleButton.ContextFlyout>
                                                    <MenuFlyout >
                                                        <MenuFlyoutItem FontFamily="{StaticResource GlobalFontHolder}"  Text="Open Folder" Name="mnftOpenFolder" Click="mnftOpenFolder_Click">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE838;"></FontIcon>
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem FontFamily="{StaticResource GlobalFontHolder}"  Text="Copy Folder Path" Name="mnftCopyPathFolder" Click="mnftCopyPathFolder_Click">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE8C8;"></FontIcon>
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem FontFamily="{StaticResource GlobalFontHolder}"  Text="Remove Folder" Name="mnftRemoveFolder" Click="mnftRemoveFolder_Click">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE894;"></FontIcon>
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyout>

                                                </ToggleButton.ContextFlyout>
                                            </ToggleButton>
                                        </DataTemplate>
                                    </GridView.ItemTemplate>
                                </GridView>
                                <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Text="No folders added." Visibility="Collapsed"  Name="txtNofoldersadded" VerticalAlignment="Center" Margin="0, 0, 10, 0"/>
                                <Button CornerRadius="16" VerticalAlignment="Stretch" Click="btnAddFolders_Click" Name="btnAddFolders" FontSize="16" Padding="10" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" Grid.Column="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Image Width="20" Source="{Binding AddIcon, Source={StaticResource GlobalIconHolder}}"></Image>
                                        <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Text="Add Folder"></TextBlock>
                                    </StackPanel>
                                </Button>
                            </controls1:WrapPanel>
                            <MenuFlyoutSeparator/>
                            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Text="Startup" Name="txtStartup" Grid.Row="6" Style="{StaticResource SubtitleTextBlockStyle}"/>
                            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Text="Configure app startup settings." Style="{StaticResource BodyStrongTextBlockStyle}" Grid.Row="3"/>
                            <CheckBox Name="chkShowSplash" Content="Show Splash Screen" Checked="chkShowSplash_Checked" Unchecked="chkShowSplash_Checked">
                                <CheckBox.Resources>
                                    <!-- Checked State (Background box fill) -->
                                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="{StaticResource GlobalAccentColor}"/>
                                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="{StaticResource GlobalAccentColorPointerOver}"/>
                                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedDisabled" Color="#2A2A2A"/>

                                    <!-- Checkmark Glyph Color (The tick mark inside the box) -->
                                    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#000000"/>
                                    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#000000"/>
                                    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#000000"/>
                                    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedDisabled" Color="#707070"/>

                                    <!-- Unchecked State (Empty box outline border) -->
                                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked" Color="Transparent"/>
                                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="#808080"/>
                                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" Color="#B0B0B0"/>                                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPressed" Color="#606060"/> 

                                    <!-- Text Label Foreground -->
                                    <SolidColorBrush x:Key="CheckBoxForeground" Color="#FFFFFF"/>
                                    <SolidColorBrush x:Key="CheckBoxForegroundPointerOver" Color="#FFFFFF"/>
                                    <SolidColorBrush x:Key="CheckBoxForegroundPressed" Color="#CCCCCC"/>
                                </CheckBox.Resources>
                            </CheckBox>

                            <ComboBox FontFamily="{StaticResource GlobalFontHolder}"  Header="Page to show when app starts" SelectedIndex="0" Name="cmbStartupPage" SelectionChanged="cmbStartupPage_SelectionChanged">
                                <ComboBox.Items>
                                    <ComboBoxItem FontFamily="{StaticResource GlobalFontHolder}"  Content="Home Page"/>
                                    <ComboBoxItem FontFamily="{StaticResource GlobalFontHolder}"  Content="Music Library Page"/>
                                    <ComboBoxItem FontFamily="{StaticResource GlobalFontHolder}"  Content="Video Library Page"/>
                                </ComboBox.Items>
                            </ComboBox>
                            <Button Content="App Lock" Click="btnAppLock_Click"  Name="btnAppLock" Style="{StaticResource AccentButtonStyle}" Background="{StaticResource GlobalAccentColor}" >
                                <Button.Resources>
                                    <SolidColorBrush x:Key="AccentButtonBackground" Color="{StaticResource GlobalAccentColor}"/>
                                    <SolidColorBrush x:Key="AccentButtonForeground" Color="#0B0D13"/>
                                    <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent"/>

                                    <!-- Pointer Over (Hover) -->
                                    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{StaticResource GlobalAccentColorPointerOver}"/>
                                    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#0B0D13"/>
                                    <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="Transparent"/>

                                    <!-- Pressed State -->
                                    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                                    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF"/>
                                    <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="Transparent"/>

                                    <!-- Disabled State -->
                                    <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#2A2A2A"/>
                                    <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#707070"/>
                                    <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="Transparent"/>
                                </Button.Resources>
                            </Button>
                            <MenuFlyoutSeparator/>
                            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Text="Default App" Grid.Row="6" Style="{StaticResource SubtitleTextBlockStyle}"/>
                            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Text="Make Vusic Player the default media player app for various media formats." Style="{StaticResource BodyStrongTextBlockStyle}" Grid.Row="3"/>
                            <Button Content="Open Settings" Click="btnOpenSettings_Click"  Name="btnOpenSettings" Style="{StaticResource AccentButtonStyle}" Background="{StaticResource GlobalAccentColor}" >
                                <Button.Resources>
                                    <SolidColorBrush x:Key="AccentButtonBackground" Color="{StaticResource GlobalAccentColor}"/>
                                    <SolidColorBrush x:Key="AccentButtonForeground" Color="#0B0D13"/>
                                    <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent"/>

                                    <!-- Pointer Over (Hover) -->
                                    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{StaticResource GlobalAccentColorPointerOver}"/>
                                    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#0B0D13"/>
                                    <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="Transparent"/>

                                    <!-- Pressed State -->
                                    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                                    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF"/>
                                    <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="Transparent"/>

                                    <!-- Disabled State -->
                                    <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#2A2A2A"/>
                                    <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#707070"/>
                                    <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="Transparent"/>
                                </Button.Resources>
                            </Button>

                            <MenuFlyoutSeparator/>
                            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Text="App Reset" Grid.Row="6" Style="{StaticResource SubtitleTextBlockStyle}"/>
                            <Button Content="Reset All Vusic Player Settings" Click="btnResetAppSettings_Click"  Name="btnResetAppSettings" Style="{StaticResource AccentButtonStyle}" Background="{StaticResource GlobalAccentColor}" >
                                <Button.Resources>
                                    <SolidColorBrush x:Key="AccentButtonBackground" Color="{StaticResource GlobalAccentColor}"/>
                                    <SolidColorBrush x:Key="AccentButtonForeground" Color="#0B0D13"/>
                                    <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent"/>

                                    <!-- Pointer Over (Hover) -->
                                    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{StaticResource GlobalAccentColorPointerOver}"/>
                                    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#0B0D13"/>
                                    <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="Transparent"/>

                                    <!-- Pressed State -->
                                    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                                    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF"/>
                                    <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="Transparent"/>

                                    <!-- Disabled State -->
                                    <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#2A2A2A"/>
                                    <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#707070"/>
                                    <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="Transparent"/>
                                </Button.Resources>
                            </Button>

                        </StackPanel>
                    </Grid>
                    <Grid Name="frmAboutOptions" Visibility="Collapsed" RowSpacing="30">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Vertical" Spacing="30">
                            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Text="About" Name="txtAbout"  Style="{StaticResource TitleTextBlockStyle}"/>
                            <MenuFlyoutSeparator/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Vertical" Spacing="15">
                            <StackPanel Orientation="Horizontal" Spacing="20">
                                <Image VerticalAlignment="Center" Width="50" Source="/Assets/appicon.png"></Image>
                                <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  IsTextSelectionEnabled="True" VerticalAlignment="Center" Style="{StaticResource TitleLargeTextBlockStyle}" Text="Vusic Player"></TextBlock>
                            </StackPanel>
                            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  IsTextSelectionEnabled="True" Style="{StaticResource SubtitleTextBlockStyle}" Text="Version 1.0.0.0"></TextBlock>
                            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  IsTextSelectionEnabled="True" Name="txtBuildType" Style="{StaticResource SubtitleTextBlockStyle}" Text="Preview (RTM)"></TextBlock>
                            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  IsTextSelectionEnabled="True" Style="{StaticResource SubtitleTextBlockStyle}" Text="© OceanCyan Tech 2026" Name="txtCompanyCopyright"></TextBlock>

                            <Image Margin="0, 30" HorizontalAlignment="Left" Width="300" Source="/Assets/OceanCyan Logo High.png"/>
                            <MenuFlyoutSeparator/>
                            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Text="Media Engine" Style="{StaticResource SubtitleTextBlockStyle}"/>
                            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Text="FlyleafLib" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Text="Copyright © SuRGeoNix"/>
                            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Text="Licensed under LGPLv3"/>
                            <StackPanel Orientation="Horizontal"  Spacing="10">
                                <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Text="Source: " VerticalAlignment="Top"/>
                                <HyperlinkButton  Foreground="{StaticResource GlobalAccentColor}"  NavigateUri="https://github.com/SuRGeoNix/Flyleaf" VerticalAlignment="Top" Padding="0" Content="Github Code"/>
                            </StackPanel>
                        </StackPanel>
                        <MenuFlyoutSeparator Grid.Row="2"/>
                        <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Text="Updates" Grid.Row="3" Style="{StaticResource TitleTextBlockStyle}"/>
                        <StackPanel Orientation="Horizontal" Spacing="10" Grid.Row="4">
                            <ProgressRing Name="prgCheckingForUpdates" Visibility="Collapsed">
                                <ProgressRing.Resources>
                                    <!-- 1. Indeterminate Animated Sweep Segment (The rotating colored tail) -->
                                    <SolidColorBrush x:Key="ProgressRingIndeterminateForeground" Color="{StaticResource GlobalAccentColor}"/>

                                    <!-- 2. Determinate Active Arc Fill (The completed percentage portion) -->
                                    <SolidColorBrush x:Key="ProgressRingForeground" Color="{StaticResource GlobalAccentColor}"/>

                                    <!-- 3. Full Circular Track / Rail (The background ring in determinate mode) -->
                                    <SolidColorBrush x:Key="ProgressRingBackground" Color="#2A2A2A"/>

                                    <!-- 4. Outer Border Stroke (Default is Transparent) -->
                                    <SolidColorBrush x:Key="ProgressRingBorderBrush" Color="Transparent"/>

                                    <!-- 5. Disabled State -->
                                    <SolidColorBrush x:Key="ProgressRingForegroundDisabled" Color="#404040"/>
                                    <SolidColorBrush x:Key="ProgressRingBackgroundDisabled" Color="#1E1E1E"/>
                                    <SolidColorBrush x:Key="ProgressRingBorderBrushDisabled" Color="Transparent"/>
                                </ProgressRing.Resources>
                            </ProgressRing>
                            <Image Width="30" Name="imgUpdate" Source="{Binding Success, Source={StaticResource GlobalIconHolder}}"/>
                            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  VerticalAlignment="Center" Name="txtUpdateInfo" Style="{StaticResource BodyLargeStrongTextBlockStyle}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Text="You are on the latest version of Vusic Player!"/>
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Spacing="20" Grid.Row="5">
                            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" Text="The Microsoft Store handles updates automatically. But if you want to double-check right now, you can trigger a manual check below."/>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Name="btnCheckForUpdates" Click="btnCheckForUpdates_Click" Style="{StaticResource AccentButtonStyle}" Content="Check For Updates" Background="{StaticResource GlobalAccentColor}" >
                                    <Button.Resources>
                                        <SolidColorBrush x:Key="AccentButtonBackground" Color="{StaticResource GlobalAccentColor}"/>
                                        <SolidColorBrush x:Key="AccentButtonForeground" Color="#0B0D13"/>
                                        <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent"/>

                                        <!-- Pointer Over (Hover) -->
                                        <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{StaticResource GlobalAccentColorPointerOver}"/>
                                        <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#0B0D13"/>
                                        <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="Transparent"/>

                                        <!-- Pressed State -->
                                        <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                                        <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF"/>
                                        <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="Transparent"/>

                                        <!-- Disabled State -->
                                        <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#2A2A2A"/>
                                        <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#707070"/>
                                        <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="Transparent"/>
                                    </Button.Resources>
                                </Button>
                                <Button Name="btnOpenStore" Click="btnOpenStore_Click"  Content="Open Microsoft Store to Update" Visibility="Collapsed"/>
                                <HyperlinkButton Foreground="{StaticResource GlobalAccentColor}"   Name="hypWhatsNew" NavigateUri="https://raw.githubusercontent.com/OceanCyanTech/Vusic-Player/refs/heads/master/Version/NewVersionReleasenotes.md" Content="See what's new!" Visibility="Collapsed"/>
                            </StackPanel>
                        </StackPanel>
                        <MenuFlyoutSeparator Grid.Row="6"/>
                        <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Text="Help" Name="txtHelp"  Grid.Row="7" Style="{StaticResource TitleTextBlockStyle}"/>
                        <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  VerticalAlignment="Center" Style="{StaticResource BodyLargeStrongTextBlockStyle}" Grid.Row="8" Text="Vusic Player is an open source project!"/>
                        <StackPanel Orientation="Vertical" Spacing="30" Grid.Row="9">
                            <Button Style="{StaticResource AccentButtonStyle}" ToolTipService.ToolTip="View Open Source License" Content="Open Source License" Name="btnViewOSLicense" Click="btnViewOSLicense_Click" Background="{StaticResource GlobalAccentColor}" >
                                <Button.Resources>
                                    <SolidColorBrush x:Key="AccentButtonBackground" Color="{StaticResource GlobalAccentColor}"/>
                                    <SolidColorBrush x:Key="AccentButtonForeground" Color="#0B0D13"/>
                                    <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent"/>

                                    <!-- Pointer Over (Hover) -->
                                    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{StaticResource GlobalAccentColorPointerOver}"/>
                                    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#0B0D13"/>
                                    <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="Transparent"/>

                                    <!-- Pressed State -->
                                    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                                    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF"/>
                                    <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="Transparent"/>

                                    <!-- Disabled State -->
                                    <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#2A2A2A"/>
                                    <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#707070"/>
                                    <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="Transparent"/>
                                </Button.Resources>
                            </Button>
                            <Button Style="{StaticResource AccentButtonStyle}" ToolTipService.ToolTip="View Third Party Licenses" Content="Third Party Licenses" Name="btnViewThirdPartyLicense" Click="btnViewThirdPartyLicense_Click" Background="{StaticResource GlobalAccentColor}" >
                                <Button.Resources>
                                    <SolidColorBrush x:Key="AccentButtonBackground" Color="{StaticResource GlobalAccentColor}"/>
                                    <SolidColorBrush x:Key="AccentButtonForeground" Color="#0B0D13"/>
                                    <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent"/>

                                    <!-- Pointer Over (Hover) -->
