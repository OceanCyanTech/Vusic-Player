<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Vusic_Player.Pages.Views.FormatConverter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Vusic_Player.Pages.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.Resources>
        <local:CountToMediaFilesConverter x:Key="CountToAudioFilesConv"/>
        <local:CountToMediaFilesProcessedConverter x:Key="CountToAudioFilesProcessedConv"/>
    </Page.Resources>
    <Grid Margin="40, 40" RowSpacing="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="File Format Converter" Style="{StaticResource TitleTextBlockStyle}"/>
        <TextBlock Text="Convert between various formats. Audio to Video is not possible." Grid.Row="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <Button Name="btnAddAudioFiles" Click="btnAddAudioFiles_Click" Grid.Row="2">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Image Source="/Assets/addicon.png" Width="20"/>
                <TextBlock Text="Add Media Files"/>
            </StackPanel>
        </Button>
        <TextBlock Text="{x:Bind AddedFiles.Count, Converter={StaticResource CountToAudioFilesConv}, Mode=OneWay}" Grid.Row="3" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <TextBlock Text="{x:Bind ProcessedFiles.Count, Converter={StaticResource CountToAudioFilesProcessedConv}, Mode=OneWay}" Grid.Row="4" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <Button Name="btnConvertAll" Click="btnConvertAll_Click" Content="Convert All" Style="{StaticResource AccentButtonStyle}" Grid.Row="5"/>

        <ListView Name="lstViewFiles" Grid.Row="6" ItemsSource="{x:Bind AddedFiles, Mode=OneWay}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnSpacing="30" ToolTipService.ToolTip="{Binding FilePath}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <FontIcon FontSize="14" Glyph="{Binding Glyph}"/>
                        <TextBlock Text="{Binding FileName}" Grid.Column="1"/>
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding FormattedDuration}" Grid.Column="2"/>
                        <TextBlock Text="{Binding FromFormat}" Grid.Column="3"/>
                        <ComboBox SelectedIndex="0" Name="cmbToFormat"  Grid.Column="4" ItemsSource="{Binding AudioExtensionsList}"/>
                        <Button Name="btnConvert" Click="btnConvert_Click" Content="Convert" Style="{StaticResource AccentButtonStyle}" Grid.Column="5"/>
                        <Button Name="btnOutput" Click="btnOutput_Click" Grid.Column="6" ToolTipService.ToolTip="Open File Output Location">
                            <FontIcon FontSize="14" Glyph="&#xE838;"/>
                        </Button>
                        <Button Name="btnCustomOutput" Click="btnCustomOutput_Click" Grid.Column="6" ToolTipService.ToolTip="Choose Custom Output Location (Default is same as file location with a unique name)">
                            <FontIcon FontSize="14" Glyph="&#xE838;"/>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
