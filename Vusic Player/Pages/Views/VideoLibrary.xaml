<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Vusic_Player.Pages.Views.VideoLibrary"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Vusic_Player.Pages.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:grids="using:Vusic_Player.UI.UserViews.Grids" xmlns:videolibcontrols="using:Vusic_Player.UI.UserViews.Controls.VideoLibraryControls" xmlns:controls="using:Vusic_Player.UI.UserViews.Controls"
    mc:Ignorable="d">

    <ScrollViewer>
        <Grid Margin="40, 30" RowSpacing="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition  Height="Auto"></RowDefinition>
                <RowDefinition   Height="Auto"></RowDefinition>
                <RowDefinition  Height="Auto"></RowDefinition>
                <RowDefinition  Height="Auto"></RowDefinition>
                <RowDefinition  Height="Auto"></RowDefinition>
                <RowDefinition  Height="Auto"></RowDefinition>

            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
                <Button CornerRadius="12"   Grid.Column="0" Name="btnNewPlaylist" Click="btnNewPlaylist_Click">
                    <StackPanel Orientation="Horizontal">
                        <Image Width="20" Source="{Binding AddIcon, Source={StaticResource GlobalIconHolder}}"></Image>
                        <TextBlock FontFamily="{StaticResource GlobalFontHolder}"   Margin="5, 0" Text="New Playlist" Style="{StaticResource BodyTextBlockStyle}"></TextBlock>
                    </StackPanel>
                </Button>
                <Button   BorderThickness="1" BorderBrush="Transparent" HorizontalAlignment="Left" CornerRadius="12"   Margin="0, 0" Name="btnOpenVideo" Click="btnOpenVideo_Click">
                    <Button.Background>
                        <AcrylicBrush TintColor="Transparent" 
TintOpacity="00" 
                   Opacity="0.3"
FallbackColor="Black" 
AlwaysUseFallback="False"/>
                    </Button.Background>
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="O"/>
                    </Button.KeyboardAccelerators>
                    <StackPanel Orientation="Horizontal">

                        <Image Width="20" Source="{Binding Importicon, Source={StaticResource GlobalIconHolder}}"></Image>
                        <TextBlock FontFamily="{StaticResource GlobalFontHolder}"   Margin="5,0" Text="Open Video" Style="{StaticResource BodyTextBlockStyle}"></TextBlock>
                    </StackPanel>

                </Button>


                <HyperlinkButton Content="View Entire Library" Click="hypViewEntireLib_Click" FontSize="16"  Grid.Row="0"></HyperlinkButton>
            </StackPanel>
            <Expander Grid.Row="1" 
          Header="Recently Played"
          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" FontFamily="{StaticResource GlobalFontHolder}"   
          IsExpanded="True"  Expanding="Expander_Expanding" Name="expRecents">
                <Expander.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem FontFamily="{StaticResource GlobalFontHolder}"    Text="View Full Video History" Name="mnftViewFullVideoHistory" Click="mnftViewFullVideoHistory_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE81C;"></FontIcon>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem FontFamily="{StaticResource GlobalFontHolder}"    Text="Disable Recent Videos" Name="mnftDisableRecentVideos" Click="mnftDisableRecentVideos_Click">
                            <MenuFlyoutItem.Icon>
                                <ImageIcon Source="/Assets/disablehistoryfonticon.png"></ImageIcon>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Expander.ContextFlyout>
                <grids:ContinuePlayingRecentsVideo x:Name="ContinuePlay"/>
            </Expander>
            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"   Name="txtDisplay1"  Text="Recommended" Tapped="TextBlock_Tapped" Grid.Row="2" Style="{StaticResource TitleTextBlockStyle}"/>
            <Expander  FontFamily="{StaticResource GlobalFontHolder}"   Grid.Row="3"  Expanding="Expander_Expanding" Name="expRecommended"
          Header="Recommended from your libraries"
          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
          IsExpanded="False">
                
                <videolibcontrols:RecommendedVideos/>
            </Expander>
            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"   Text="My Playlists" Name="txtDisplay2" Tapped="TextBlock_Tapped_1" Grid.Row="4" Style="{StaticResource TitleTextBlockStyle}"/>
            <Expander  FontFamily="{StaticResource GlobalFontHolder}"   Grid.Row="5"  Expanding="Expander_Expanding" Name="expVideoPlaylists"
          Header="My Playlists"
          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
          IsExpanded="False">
                <grids:UserPlaylists HorizontalAlignment="Left"/>
            </Expander>
            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"   Name="txtDisplay3" Text="Shows" Tapped="TextBlock_Tapped_2" Grid.Row="6" Style="{StaticResource TitleTextBlockStyle}"/>
            <Expander  FontFamily="{StaticResource GlobalFontHolder}"   Grid.Row="7" Expanding="Expander_Expanding" Name="expShows"  Header="My Shows"
 HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
 IsExpanded="False">
                <Grid RowSpacing="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0"  Click="Button_Click">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Image Source="{Binding AddIcon, Source={StaticResource GlobalIconHolder}}" Width="15"/>
                            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"   Text="Create New Show Model"/>
                        </StackPanel>
                     </Button>
                    <videolibcontrols:UserShows HorizontalAlignment="Left" Grid.Row="1"></videolibcontrols:UserShows>
                </Grid>
            </Expander>
        </Grid>
    </ScrollViewer>

</Page>
