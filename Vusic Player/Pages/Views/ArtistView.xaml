<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Vusic_Player.Pages.Views.ArtistView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Vusic_Player.Pages.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vusic="using:Vusic_Player.UI.UserViews.Controls"
    mc:Ignorable="d">
    <Page.Resources>
        <local:ArtistItemCountString x:Key="ItemCountStringConverter"/>
        <local:QueueItemCount x:Key="VisibilityOfMainContent"/>
        <local:QueueItemCountBack x:Key="VisibilityOfEmptyContent"/>
        <local:ControlEnabled x:Key="ControlEnabledBasedonCountConverter"/>
        <local:ArtistAlbumCountString x:Key="AlbumCountStringConverter"/>
    </Page.Resources>
    <Grid Margin="50, 20" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MaxWidth="400"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid HorizontalAlignment="Stretch" Grid.Column="0" VerticalAlignment="Stretch" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Play all Songs of Artist" Click="btnPlayAll_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE768;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Add Songs to Artist" Click="btnAddSongs_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE710;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="Rename Artist" Click="btnOpenRenameTT_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8AC;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Refresh Artist Discography" Click="btnRefresh_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE72C;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </Grid.ContextFlyout>

            <TeachingTip FontFamily="{StaticResource GlobalFontHolder}" PreferredPlacement="Bottom" Title="Finding files across your libraries..." Name="ttProgress" >
                <StackPanel Orientation="Horizontal" Margin="0, 15">
                    <ProgressBar Name="prgProgress" IsIndeterminate="True" Width="300" Margin="10, 0">
                        <ProgressBar.Resources>
                            <!-- 1. Determinate State: Active Track Indicator Fill -->
                            <SolidColorBrush x:Key="ProgressBarForeground" Color="{StaticResource GlobalAccentColor}"/>

                            <!-- 2. Track Background (The empty track/trough behind the progress) -->
                            <SolidColorBrush x:Key="ProgressBarBackground" Color="#2A2A2A"/>

                            <!-- 3. Outer Border Stroke (Default is transparent in WinUI) -->
                            <SolidColorBrush x:Key="ProgressBarBorderBrush" Color="Transparent"/>

                            <!-- 4. Indeterminate State (Looping pulse animation / loading bar) -->
                            <SolidColorBrush x:Key="ProgressBarIndeterminateForeground" Color="{StaticResource GlobalAccentColor}"/>

                            <!-- 5. Paused State (When ShowPaused="True") -->
                            <SolidColorBrush x:Key="ProgressBarPausedForeground" Color="#FFC83B"/>

                            <!-- 6. Error State (When ShowError="True") -->
                            <SolidColorBrush x:Key="ProgressBarErrorForeground" Color="#FF4343"/>

                            <!-- 7. Disabled State -->
                            <SolidColorBrush x:Key="ProgressBarForegroundDisabled" Color="#404040"/>
                            <SolidColorBrush x:Key="ProgressBarBackgroundDisabled" Color="{ThemeResource ControlFillColorDisabled}"/>
                            <SolidColorBrush x:Key="ProgressBarBorderBrushDisabled" Color="Transparent"/>

                            <!-- 8. Corner Radius (Geometry rounding for both track and indicator) -->
                            <CornerRadius x:Key="ProgressBarCornerRadius">3</CornerRadius>
                            <CornerRadius x:Key="ProgressBarTrackCornerRadius">3</CornerRadius>
                        </ProgressBar.Resources>
                    </ProgressBar>
                </StackPanel>
            </TeachingTip>
            <PersonPicture Grid.Row="0" Name="imgArtist" Width="300" Height="300" >
                <PersonPicture.ContextFlyout>
                    <MenuFlyout>

                        <MenuFlyoutItem FontFamily="{StaticResource GlobalFontHolder}" Text="Change Image" Click="btnSetArtistProfilePicture_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE7C5;"></FontIcon>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem FontFamily="{StaticResource GlobalFontHolder}" Text="Remove Image" Name="mnftRemoveImage" Click="mnftRemoveImage_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE894;"></FontIcon>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </PersonPicture.ContextFlyout>
            </PersonPicture>
            <ContentDialog>
                <Grid Name="grdImageLarge">
                    <Image Stretch="Uniform" Name="imgLargeViewer"></Image>
                    <Canvas x:Name="canvasOverlay">
                        <Ellipse x:Name="cropCircle"
                     Width="300"
                     Height="300"
                     Stroke="White"
                  />
                    </Canvas>
                </Grid>
            </ContentDialog>
            <TeachingTip FontFamily="{StaticResource GlobalFontHolder}" MaxWidth="600" Title="Album Info - " Name="ttAlbumInfo" IsOpen="False">
                <Grid Margin="0, 10">


                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Spacing="8" Margin="0,5" VerticalAlignment="Top" Orientation="Vertical">
                            <Button Name="btnChangeAlbumCover" HorizontalAlignment="Stretch" CornerRadius="12" >
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem FontFamily="{StaticResource GlobalFontHolder}" Text="From PC" Click="btnChangeAlbumCover_Click"/>
                                        <MenuFlyoutItem FontFamily="{StaticResource GlobalFontHolder}" Text="Find Online" Click="btnFindOnline_Click"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Image Source="{Binding RefreshImageIcon, Source={StaticResource GlobalIconHolder}}" Width="16" Height="16"/>
                                    <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Text="Change Album Cover"/>
                                </StackPanel>
                            </Button>


                        </StackPanel>
                        <Grid Grid.Row="1" Margin="0, 10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Name="imgAlbumCover"
Source="{Binding AddImageIcon, Source={StaticResource GlobalIconHolder}}" 
Width="90" Height="90" 
Stretch="UniformToFill"/>
                            <Border x:Name="HoverOverlay" CornerRadius="12" Margin="0, 10" PointerEntered="HoverOverlay_PointerEntered" PointerExited="HoverOverlay_PointerExited" Grid.Column="0"  Padding="0" Background="#99000000" Opacity="0">

                            </Border>
                            <Button  Click="btnRemoveImage_Click" Opacity="0" PointerEntered="btnRemoveImage_PointerEntered" PointerExited="btnRemoveImage_PointerExited" Name="btnRemoveImage" CornerRadius="12" HorizontalAlignment="Center"  Background="#99000000" >
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Image Source="{Binding RemoveImage, Source={StaticResource GlobalIconHolder}}" Width="16" Height="16"/>
                                    <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Text="Remove" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <StackPanel Grid.Column="1" Margin="20,0" Spacing="8" VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Name="txtAlbumName" 
                     Text="Album Name"  TextTrimming="CharacterEllipsis"
                     FontSize="20"
                     FontWeight="SemiBold"
                 
                     HorizontalAlignment="Left"
                     MinWidth="200"/>

                                </StackPanel>

                                <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Name="txtCount" Text="• 15 items" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Name="txtDuration" Text="• 55:07" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,5,0,0">
                                    <Image Source="{Binding DefaultArtist, Source={StaticResource GlobalIconHolder}}" Width="25" Height="25"/>
                                    <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Name="txtArtistsInvolved" 
                           Text="• Artists"  IsTextSelectionEnabled="True"
                           VerticalAlignment="Center" 
                           Style="{StaticResource BodyTextBlockStyle}" 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="WrapWholeWords"/>
                                </StackPanel>
                            </StackPanel>

                        </Grid>
                        <MenuFlyoutSeparator Grid.Row="2"/>
                        <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Grid.Row="3" Text="Album Contents" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0, 10"/>
                        <ListView Name="lstViewAlbumSongs" Grid.Row="4" Margin="0, 10">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ToolTipService.ToolTip="{Binding FilePath}" ColumnSpacing="5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem FontFamily="{StaticResource GlobalFontHolder}" Text="Play" Name="mnftPlayAlbumSong" Click="mnftPlayAlbumSong_Click">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE768;"/>
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem FontFamily="{StaticResource GlobalFontHolder}" Text="Copy Path" Name="mnftCopyFilePath" Click="mnftCopyFilePath_Click">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE8C8;"/>
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem FontFamily="{StaticResource GlobalFontHolder}" Text="Open File Location" Name="mnftOpenFileLoc" Click="mnftOpenFileLoc_Click">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE8DA;"/>
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem FontFamily="{StaticResource GlobalFontHolder}" Text="File Info" Name="mnftOpenFileInfo" Click="mnftOpenFileInfo_Click">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE946;"/>
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Grid.ContextFlyout>
                                        <FontIcon FontSize="12" Glyph="{Binding Glyph}"/>
                                        <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Margin="10, 0" Grid.Column="1" FontSize="16"  Text="{Binding Title}"/>
                                        <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource GlobalFontHolder}"  Grid.Column="2" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Artist}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Name="txtEmptySongsAlbum" Grid.Row="4" Visibility="Collapsed" Text="This album is empty!"/>
                    </Grid>



                </Grid>
            </TeachingTip>
            <StackPanel Grid.Row="1" Margin="0, 20" Orientation="Vertical" HorizontalAlignment="Center">
                <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Text="Artist name" Name="txtArtistName" 
               Style="{StaticResource TitleTextBlockStyle}" 
               HorizontalAlignment="Center" 
               TextWrapping="Wrap" />
                <StackPanel Margin="0, 20" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Text="• Artist" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Margin="10, 0" Text="{x:Bind albumCollection.Count, Mode=OneWay, Converter={StaticResource AlbumCountStringConverter }}" Name="txtAlbumCount" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Margin="0, 0" Text="{x:Bind FoundSongs.Count, Mode=OneWay,Converter={StaticResource ItemCountStringConverter}}" Name="txtSongCount" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <TextBlock   Text="&#xE823;" FontFamily="Segoe Fluent Icons" 
Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0, 3" />
                    <TextBlock IsTextSelectionEnabled="True" FontFamily="{StaticResource GlobalFontHolder}"  Margin="5, 0" ToolTipService.ToolTip="Total Runtime of Artist"  Text="{x:Bind FormatTotalDuration(FoundSongs.Count), Mode=OneWay}"
Name="txtTotalDuration" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
            <Border 
Padding="10,0" 
VerticalAlignment="Top" 
HorizontalAlignment="Center"
Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" 
BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
BorderThickness="1" 
CornerRadius="16"
                Grid.Row="2">

                <ItemsControl Grid.Row="2" Margin="0, 10" HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VariableSizedWrapGrid Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <Button CornerRadius="12"  Background="Transparent" BorderBrush="Transparent" Margin="5" Click="btnOpenRenameTT_Click" ToolTipService.ToolTip="Rename Artist" >
                        <Button.Flyout>
                            <Flyout x:Name="flyoutRename">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox FontFamily="{StaticResource GlobalFontHolder}" GotFocus="txtRename_GotFocus" Width="150" Grid.Column="0" 
                             Name="txtRename" PlaceholderText="Rename artist" >
                                        <TextBox.Resources>
                                            <!-- 1. Focused State (Accent Highlight on Border & Caret) -->
                                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource GlobalAccentColor}"/>
                                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{ThemeResource ControlFillColorDisabled}"/>
                                            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFFFFF"/>
                                            <SolidColorBrush x:Key="TextControlButtonForegroundFocused" Color="{StaticResource GlobalAccentColor}"/>

                                            <!-- 2. Resting / Unfocused State -->
                                            <SolidColorBrush x:Key="TextControlBackground" Color="{ThemeResource CardBackgroundFillColorDefault}"/>
                                            <SolidColorBrush x:Key="TextControlForeground" Color="#FFFFFF"/>
                                            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#404040"/>
                                            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#808080"/>

                                            <!-- 3. Pointer Over (Hover) State -->
                                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#2A2A2A"/>
                                            <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FFFFFF"/>
                                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#555555"/>
                                            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#999999"/>

                                            <!-- 4. Text Selection Highlight (Highlight color when selecting text) -->
                                            <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="{StaticResource GlobalAccentColor}"/>

                                            <!-- 5. Inner Clear / Action Button (The "X" delete button) -->
                                            <SolidColorBrush x:Key="TextControlButtonBackground" Color="Transparent"/>
                                            <SolidColorBrush x:Key="TextControlButtonBackgroundPointerOver" Color="#303030"/>
                                            <SolidColorBrush x:Key="TextControlButtonBackgroundPressed" Color="#404040"/>
                                            <SolidColorBrush x:Key="TextControlButtonForeground" Color="#808080"/>
                                            <SolidColorBrush x:Key="TextControlButtonForegroundPointerOver" Color="#FFFFFF"/>
                                            <SolidColorBrush x:Key="TextControlButtonForegroundPressed" Color="#FFFFFF"/>

                                            <!-- 6. Disabled State -->
                                            <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="{ThemeResource CardBackgroundFillColorTertiary}"/>
                                            <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#505050"/>
                                            <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#2A2A2A"/>
                                            <SolidColorBrush x:Key="TextControlPlaceholderForegroundDisabled" Color="#404040"/>
                                        </TextBox.Resources>
                                    </TextBox>
                                    <Button Background="Transparent" BorderBrush="Transparent" Margin="5, 0" Grid.Column="1" Click="btnRenameArtist_Click" Name="btnRenameArtist" >
                                        <Image Margin="5, 0" Width="20" Source="{Binding TickIcon, Source={StaticResource GlobalIconHolder}}" />
                                    </Button>
                                </Grid>
                            </Flyout>
                        </Button.Flyout>
                        <Image Width="25" Source="{Binding EditIcon, Source={StaticResource GlobalIconHolder}}" />
                    </Button>

                    <Button CornerRadius="12" Background="Transparent" BorderBrush="Transparent" Name="btnPlayAll" Click="btnPlayAll_Click" Margin="5"
            ToolTipService.ToolTip="Play all songs of Artist">
                        <StackPanel Orientation="Horizontal">
                            <Image Width="25" Source="{Binding Play, Source={StaticResource GlobalIconHolder}}" />
                            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Margin="5,2" Text="Play all" />
                        </StackPanel>
                    </Button>

                    <ToggleButton CornerRadius="12"  Background="Transparent" BorderBrush="Transparent" Name="btnShuffle" Checked="btnShuffle_Checked" Unchecked="btnShuffle_Checked" Margin="5"
                  ToolTipService.ToolTip="Toggle Shuffle">
                        <ToggleButton.Resources>
                            <!-- 1. Background Fill when CHECKED -->
                            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{StaticResource GlobalAccentColor}"/>
                            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{StaticResource GlobalAccentColorPointerOver}"/>
                            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedDisabled" Color="#2A2A2A"/>

                            <!-- 2. Text / Icon Foreground when CHECKED -->
                            <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#000000"/>
                            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#000000"/>
                            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#000000"/>
                            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedDisabled" Color="#707070"/>

                            <!-- 3. Border Stroke when CHECKED -->
                            <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent"/>
                            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent"/>
                            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedDisabled" Color="Transparent"/>

                            <!-- 4. Background Fill when UNCHECKED -->
                            <SolidColorBrush x:Key="ToggleButtonBackground" Color="{ThemeResource CardBackgroundFillColorDefault}"/>
                            <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="{ThemeResource CardBackgroundFillColorSecondary}"/>
                            <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="{ThemeResource CardBackgroundFillColorTertiary}"/>
                            <SolidColorBrush x:Key="ToggleButtonBackgroundDisabled" Color="{ThemeResource ControlFillColorDisabled}"/>

                            <!-- 5. Text / Icon Foreground when UNCHECKED -->
                            <SolidColorBrush x:Key="ToggleButtonForeground" Color="#FFFFFF"/>
                            <SolidColorBrush x:Key="ToggleButtonForegroundPointerOver" Color="#FFFFFF"/>
                            <SolidColorBrush x:Key="ToggleButtonForegroundPressed" Color="#CCCCCC"/>
                            <SolidColorBrush x:Key="ToggleButtonForegroundDisabled" Color="#505050"/>

                            <!-- 6. Border Stroke when UNCHECKED -->
                            <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="#404040"/>
                            <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="#555555"/>
                            <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="#303030"/>
                            <SolidColorBrush x:Key="ToggleButtonBorderBrushDisabled" Color="#2A2A2A"/>
                        </ToggleButton.Resources>

                        <Image Width="25" Source="{Binding ShuffleIcon, Source={StaticResource GlobalIconHolder}}" />
                    </ToggleButton>

                    <Button CornerRadius="12"  Name="btnAddSongs" Margin="5" Background="Transparent" BorderBrush="Transparent" 
            ToolTipService.ToolTip="Add songs to this Artist" Click="btnAddSongs_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Width="25" Source="{Binding AddIcon, Source={StaticResource GlobalIconHolder}}" />
                            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Margin="5,2" Text="Add Songs" />
                        </StackPanel>

                    </Button>
                    <Button  CornerRadius="12"  Name="btnSetArtistProfilePicture" Margin="5" Background="Transparent" BorderBrush="Transparent" 
ToolTipService.ToolTip="Set Artist Cover">
                        <Button.Flyout>
                            <Flyout>
                                <StackPanel Orientation="Vertical" Spacing="5">
                                    <HyperlinkButton Name="btnFindArtistProfileOnline" Click="btnFindArtistProfileOnline_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Width="25" Source="{Binding ArtistPictureOnline, Source={StaticResource GlobalIconHolder}}" />
                                            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Margin="5,2" Text="Find artist picture online" />
                                        </StackPanel>
                                    </HyperlinkButton>
                                    <HyperlinkButton Name="btnFindArtistProfileLocal" Click="btnSetArtistProfilePicture_Click" >
                                        <StackPanel Orientation="Horizontal">
                                            <Image Width="25" Source="{Binding ArtistPictureLocal, Source={StaticResource GlobalIconHolder}}" />
                                            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Margin="5,2" Text="Find artist picture on disk" />
                                        </StackPanel>
                                    </HyperlinkButton>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal">
                            <Image Width="25" Source="{Binding AddImageIcon, Source={StaticResource GlobalIconHolder}}" />
                            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Margin="5,2" Text="Set Album Cover" />
                        </StackPanel>
                    </Button>
                </ItemsControl>
            </Border>
            <Button Name="btnAddtoQueue" CornerRadius="12" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1"  Grid.Row="3" Margin="0, 20" HorizontalAlignment="Center" Content="Add All Artist's Songs to Queue" Click="btnAddtoQueue_Click"></Button>

        </Grid>
        <TeachingTip Name="ttAddedtoQueue" IsOpen="False">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Image Width="25" Source="{Binding Success, Source={StaticResource GlobalIconHolder}}"/>
                <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Text="Added item(s) to Queue"/>
            </StackPanel>
        </TeachingTip>
        <Grid Margin="10, 0" Grid.Column="1" RowSpacing="30">
            <Grid.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Play all Songs of Artist" Click="btnPlayAll_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE768;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Add Songs to Artist" Click="btnAddSongs_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE710;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="Rename Artist" Click="btnOpenRenameTT_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8AC;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Refresh Artist Discography" Click="btnRefresh_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE72C;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </Grid.ContextFlyout>

            <Grid.RowDefinitions>
                <!-- Row 0: Page header and top collections (Albums, Singles, Most Played) -->
                <RowDefinition Height="Auto" />
                <!-- Row 1: All Songs ListView gets all remaining screen space (Virtualization Enabled!) -->
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Vertical" Spacing="20">
                <InfoBar Name="ifbError" Visibility="Collapsed" CloseButtonClick="ifbError_CloseButtonClick"></InfoBar>

                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Style="{StaticResource TitleLargeTextBlockStyle}" Text="Artist Discography" ></TextBlock>
                    <Button CornerRadius="12"  Margin="20, 0" Background="Transparent" BorderBrush="Transparent" Name="btnRefresh" Click="btnRefresh_Click" ToolTipService.ToolTip="Refresh Discography">
                        <FontIcon Glyph="&#xE72C;" FontSize="16"></FontIcon>
                    </Button>
                </StackPanel>
            </StackPanel>
            <SelectorBar Name="selBarMain" SelectionChanged="selBarMain_SelectionChanged" Grid.Row="1">
                <SelectorBar.Resources>
                    <SolidColorBrush x:Key="SelectorBarItemPillFill" 
  Color="{StaticResource GlobalAccentColor}"/>
                </SelectorBar.Resources>
                <SelectorBar.Items>
                    <SelectorBarItem Name="selBarItemMostPlayed"  FontSize="18"  IsSelected="True" Text="Most Played"/>
                    <SelectorBarItem Name="selBarItemAlbum" FontSize="18" Margin="10, 0"  Text="Albums"/>
                    <SelectorBarItem Name="selBarItemSingles" FontSize="18" Margin="10, 0"  Text="Singles"/>
                    <SelectorBarItem Name="selBarItemAllSongs" FontSize="18" Margin="10, 0" Text="All Songs"/>
                </SelectorBar.Items>
            </SelectorBar>
            <Grid Name="grdMostPlayed" Grid.Row="2" RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Style="{StaticResource TitleTextBlockStyle}" Grid.Row="0" Text="Your most played"></TextBlock>
                <TextBlock FontFamily="{StaticResource GlobalFontHolder}"   Foreground="{ThemeResource TextFillColorSecondaryBrush}"  Style="{StaticResource BodyTextBlockStyle}" Grid.Row="1" Name="txtMostPlayedCount" Text="{x:Bind mostplayedsongs.Count, Mode=OneWay, Converter={StaticResource ItemCountStringConverter}}"></TextBlock>
                <TextBlock FontFamily="{StaticResource GlobalFontHolder}"   Foreground="{ThemeResource TextFillColorSecondaryBrush}"  Style="{StaticResource BodyTextBlockStyle}" Grid.Row="2" Name="txtMostPlayedDuration" Text="{x:Bind FormatMostPlayedDuration(mostplayedsongs.Count), Mode=OneWay}"></TextBlock>
                <StackPanel Orientation="Horizontal" Grid.Row="3" Spacing="10">
                    <Button CornerRadius="12" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"   Click="btnPlayAllMostPlayed_Click" ToolTipService.ToolTip="Play All Songs in List" Name="btnPlayAllMostPlayed" Grid.Row="3" Style="{StaticResource AccentButtonStyle}"  Background="{StaticResource GlobalAccentColor}" >
                        <Button.Resources>
                            <SolidColorBrush x:Key="AccentButtonBackground" Color="{StaticResource GlobalAccentColor}"/>
                            <SolidColorBrush x:Key="AccentButtonForeground" Color="#0B0D13"/>
                            <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent"/>


                            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{StaticResource GlobalAccentColorPointerOver}"/>
                            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#0B0D13"/>
                            <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="Transparent"/>

                            <!-- Pressed State -->
                            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF"/>
                            <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="Transparent"/>

                            <!-- Disabled State -->
                            <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#2A2A2A"/>
                            <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#707070"/>
                            <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="Transparent"/>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE768;"/>
                            <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource GlobalFontHolder}"  Text="Play All"/>
                        </StackPanel>
                    </Button>
                    <Button CornerRadius="12" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"  Click="btnAddtoQueueMostPlayed_Click" ToolTipService.ToolTip="Add all songs in list to Queue" Name="btnAddtoQueueMostPlayed" Grid.Row="3" >
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ImageIcon  Width="20"    Source="{Binding AddToQueue , Source={StaticResource GlobalIconHolder}}"/>
                            <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource GlobalFontHolder}"  Text="Add to Queue"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Text="Play songs of this artist to show them here!" Grid.Row="4" Name="txtEmptyMostPlayed" Visibility="{x:Bind mostplayedsongs.Count, Mode=OneWay, Converter={StaticResource VisibilityOfEmptyContent}}"></TextBlock>
                <vusic:ListViewMedia MediaSource="ArtistNoRearrange" Grid.Row="4" ItemsSource="{x:Bind mostplayedsongs, Mode=OneWay}" Visibility="{x:Bind mostplayedsongs.Count, Mode=OneWay, Converter={StaticResource VisibilityOfMainContent}}" AllowRearranging="False" x:Name="lstViewMasterMostPlayed"></vusic:ListViewMedia>
            </Grid>
            <Grid Name="grdAlbums" Grid.Row="2" Visibility="Collapsed" RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Grid.Row="0" Spacing="20">
                    <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource GlobalFontHolder}"  Style="{StaticResource TitleTextBlockStyle}" Text="Albums"></TextBlock>
                    <CheckBox FontFamily="{StaticResource GlobalFontHolder}"  Content="Select" Margin="0, 5" Checked="chckSelectAlbums_Checked" Unchecked="chckSelectAlbums_Checked" Name="chckSelectAlbums">
                        <CheckBox.Resources>
                            <!-- Checked State (Background box fill) -->
                            <SolidColorBrush x:Key="CheckBoxFillColorDefault" Color="{StaticResource GlobalAccentColor}"/>
                            <SolidColorBrush x:Key="CheckBoxFillColorPointerOver" Color="{StaticResource GlobalAccentColorPointerOver}"/>
                            <SolidColorBrush x:Key="CheckBoxFillColorPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                            <SolidColorBrush x:Key="CheckBoxFillColorDisabled" Color="#2A2A2A"/>

                            <!-- Checkmark Glyph Color (The tick mark inside the box) -->
                            <SolidColorBrush x:Key="CheckBoxCheckGlyphForeground" Color="#000000"/>
                            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundPointerOver" Color="#000000"/>
                            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundPressed" Color="#000000"/>
                            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundDisabled" Color="#707070"/>

                            <!-- Unchecked State (Empty box outline border) -->
                            <SolidColorBrush x:Key="CheckBoxStrokeColorDefault" Color="#808080"/>
                            <SolidColorBrush x:Key="CheckBoxStrokeColorPointerOver" Color="#B0B0B0"/>
                            <SolidColorBrush x:Key="CheckBoxStrokeColorPressed" Color="#606060"/>

                            <!-- Text Label Foreground -->
                            <SolidColorBrush x:Key="CheckBoxForeground" Color="#FFFFFF"/>
                            <SolidColorBrush x:Key="CheckBoxForegroundPointerOver" Color="#FFFFFF"/>
                            <SolidColorBrush x:Key="CheckBoxForegroundPressed" Color="#CCCCCC"/>
                        </CheckBox.Resources>
                    </CheckBox>

                </StackPanel>

                <StackPanel Orientation="Horizontal" Grid.Row="1" Visibility="Collapsed" Spacing="10" Name="stkMultiOptionsAlbums">
                    <Button IsEnabled="False"  CornerRadius="12" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"  Name="btnRemoveSelections" Click="btnRemoveSelections_Click" ToolTipService.ToolTip="Remove Albums" Margin="0, 10" >
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding DeleteAlbum, Source={StaticResource GlobalIconHolder}}" Width="20"></Image>
                        </StackPanel>
                    </Button>

                    <Button  CornerRadius="12" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"  Name="btnSelectAll" ToolTipService.ToolTip="Select All" Margin="0, 10" Click="btnSelectAll_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding SelectAll, Source={StaticResource GlobalIconHolder}}" Width="20"></Image>
                        </StackPanel>
                    </Button>

                    <Button  IsEnabled="False" CornerRadius="12" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"  Name="btnClearSelection" ToolTipService.ToolTip="Clear Selection" Margin="0, 10" Click="btnClearSelection_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding Removeicon, Source={StaticResource GlobalIconHolder}}" Width="20"></Image>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Style="{StaticResource BodyLargeTextBlockStyle}" Text="There are no albums for this artist." Name="txtEmptyAlbums" Visibility="{x:Bind albumCollection.Count, Converter={StaticResource VisibilityOfEmptyContent}, Mode=OneWay}" Grid.Row="2"></TextBlock>
                <GridView SelectionChanged="grdViewAlbums_SelectionChanged" Visibility="{x:Bind albumCollection.Count, Converter={StaticResource VisibilityOfMainContent}, Mode=OneWay}" SelectionMode="Single" Grid.Row="2" ItemsSource="{x:Bind albumCollection, Mode=OneWay}"  Name="grdViewAlbums" IsItemClickEnabled="True" CanReorderItems="True" AllowDrop="True" CanDragItems="True" ItemClick="grdViewAlbums_ItemClick">
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel ToolTipService.ToolTip="{Binding AlbumName}" Width="150">
                                <StackPanel.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem FontFamily="{StaticResource GlobalFontHolder}" Text="Open Album" Name="mnftOpenAlbum" Click="mnftOpenAlbum_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8DA;"></FontIcon>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem FontFamily="{StaticResource GlobalFontHolder}" Text="Rename Album" Name="mnftRenameAlbum" Click="mnftRenameAlbum_Click" >
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8AC;"></FontIcon>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator/>
                                        <MenuFlyoutItem FontFamily="{StaticResource GlobalFontHolder}" Text="View Album Info" Name="mnftAlbumInfo" Click="mnftAlbumInfo_Click" >
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE90B;"></FontIcon>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator/>
                                        <MenuFlyoutItem FontFamily="{StaticResource GlobalFontHolder}" Text="Change Album Cover" Name="mnftChangeAlbumCover" Click="mnftChangeAlbumCover_Click" >
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE93C;"></FontIcon>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem FontFamily="{StaticResource GlobalFontHolder}" Text="Find Album Cover Online" Name="mnftFindAlbumCoverOnline" Click="mnftFindAlbumCoverOnline_Click" >
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xF6FA;"></FontIcon>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator/>
                                        <MenuFlyoutItem FontFamily="{StaticResource GlobalFontHolder}" Text="Remove Album" ToolTipService.ToolTip="Unassociates the album with songs" Name="mnftRemoveAlbum" Click="mnftRemoveAlbum_Click" >
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8DA;"></FontIcon>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>

                                    </MenuFlyout>
                                </StackPanel.ContextFlyout>

                                <Image Source="{Binding AlbumCoverThumbnail}" Width="150" Height="150" Stretch="UniformToFill"/>
                                <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Margin="0, 5" Style="{StaticResource BodyLargeTextBlockStyle}" Text="{Binding AlbumName}" Visibility="Visible" TextWrapping="Wrap" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition></ColumnDefinition>
                                        <ColumnDefinition></ColumnDefinition>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  ToolTipService.ToolTip="Album Count" Grid.Column="0" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Visible" TextWrapping="Wrap">
                                    <Run Text="• " />
                                    <Run Text="{Binding AlbumCount}" />
                                    </TextBlock>
                                    <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Grid.Column="1" FontSize="12" ToolTipService.ToolTip="Album Year" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap">
                                    
                                    <Run Text="{Binding AlbumYear}" />
                                    </TextBlock>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>


            </Grid>
            <Grid Name="grdArtistSingles" Grid.Row="2" Visibility="Collapsed" RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Grid.Row="0" Style="{StaticResource TitleTextBlockStyle}" Text="Singles"></TextBlock>
                <TextBlock FontFamily="{StaticResource GlobalFontHolder}"   Foreground="{ThemeResource TextFillColorSecondaryBrush}" ToolTipService.ToolTip="Total number of singles"  Style="{StaticResource BodyTextBlockStyle}" Grid.Row="1" Name="txtSinglesCount" Text="{x:Bind Singles.Count, Mode=OneWay, Converter={StaticResource ItemCountStringConverter }}"></TextBlock>
                <TextBlock FontFamily="{StaticResource GlobalFontHolder}"   Foreground="{ThemeResource TextFillColorSecondaryBrush}" ToolTipService.ToolTip="Total duration of singles"  Style="{StaticResource BodyTextBlockStyle}" Grid.Row="2" Name="txtSinglesDuration" Text="{x:Bind FormatSinglesDuration(Singles.Count), Mode=OneWay}"></TextBlock>
                <Button Click="btnPlayAllSingles_Click" CornerRadius="12" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"  ToolTipService.ToolTip="Play All Songs in List" Name="btnPlayAllSingles" Grid.Row="3" Style="{StaticResource AccentButtonStyle}"  Background="{StaticResource GlobalAccentColor}" >
                    <Button.Resources>
                        <SolidColorBrush x:Key="AccentButtonBackground" Color="{StaticResource GlobalAccentColor}"/>
                        <SolidColorBrush x:Key="AccentButtonForeground" Color="#0B0D13"/>
                        <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent"/>


                        <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{StaticResource GlobalAccentColorPointerOver}"/>
                        <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#0B0D13"/>
                        <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="Transparent"/>

                        <!-- Pressed State -->
                        <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                        <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="Transparent"/>

                        <!-- Disabled State -->
                        <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#2A2A2A"/>
                        <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#707070"/>
                        <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="Transparent"/>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE768;"/>
                        <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Text="Play All"/>
                    </StackPanel>
                </Button>
                <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Grid.Row="4" Text="There are no singles for this artist." Style="{StaticResource BodyLargeTextBlockStyle}" Visibility="{x:Bind Singles.Count, Mode=OneWay, Converter={StaticResource VisibilityOfEmptyContent}}" Name="txtEmptySingles"></TextBlock>
                <vusic:ListViewMedia ItemsSource="{x:Bind Singles, Mode=OneWay}" x:Name="lstViewSingles" Visibility="{x:Bind Singles.Count, Mode=OneWay, Converter={StaticResource VisibilityOfMainContent}}" MediaSource="Artist" Grid.Row="4"></vusic:ListViewMedia>
            </Grid>
            <Grid Name="grdAllSongs" Grid.Row="2" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0, 20">
                    <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Name="txtPlaylistContentHeader" Style="{StaticResource TitleTextBlockStyle}" Text="All Songs"></TextBlock>
                    <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Margin="10,5" Style="{StaticResource BaseTextBlockStyle}" ToolTipService.ToolTip="Media will play shuffled" Text="shuffled" Name="txtShuffled" Visibility="Collapsed" Foreground="{ThemeResource TextFillColorSecondaryBrush}"></TextBlock>
                </StackPanel>
                <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Grid.Row="1" Text="There are no songs for this artist." Style="{StaticResource BodyLargeTextBlockStyle}" Name="txtEmptySongs" Visibility="{x:Bind FoundSongs.Count, Mode=OneWay, Converter={StaticResource VisibilityOfEmptyContent}}"/>

                <TeachingTip Name="ttRenameAlbum" Visibility="Collapsed" Title="Rename Album">
                    <Grid RowSpacing="15" Margin="0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBox Name="txtRenameAlbum" PlaceholderText="Rename album...">
                            <TextBox.Resources>
                                <!-- 1. Focused State (Accent Highlight on Border & Caret) -->
                                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource GlobalAccentColor}"/>
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{ThemeResource ControlFillColorDisabled}"/>
                                <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFFFFF"/>
                                <SolidColorBrush x:Key="TextControlButtonForegroundFocused" Color="{StaticResource GlobalAccentColor}"/>

                                <!-- 2. Resting / Unfocused State -->
                                <SolidColorBrush x:Key="TextControlBackground" Color="{ThemeResource CardBackgroundFillColorDefault}"/>
                                <SolidColorBrush x:Key="TextControlForeground" Color="#FFFFFF"/>
                                <SolidColorBrush x:Key="TextControlBorderBrush" Color="#404040"/>
                                <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#808080"/>

                                <!-- 3. Pointer Over (Hover) State -->
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#2A2A2A"/>
                                <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FFFFFF"/>
                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#555555"/>
                                <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#999999"/>

                                <!-- 4. Text Selection Highlight (Highlight color when selecting text) -->
                                <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="{StaticResource GlobalAccentColor}"/>

                                <!-- 5. Inner Clear / Action Button (The "X" delete button) -->
                                <SolidColorBrush x:Key="TextControlButtonBackground" Color="Transparent"/>
                                <SolidColorBrush x:Key="TextControlButtonBackgroundPointerOver" Color="#303030"/>
                                <SolidColorBrush x:Key="TextControlButtonBackgroundPressed" Color="#404040"/>
                                <SolidColorBrush x:Key="TextControlButtonForeground" Color="#808080"/>
                                <SolidColorBrush x:Key="TextControlButtonForegroundPointerOver" Color="#FFFFFF"/>
                                <SolidColorBrush x:Key="TextControlButtonForegroundPressed" Color="#FFFFFF"/>

                                <!-- 6. Disabled State -->
                                <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="{ThemeResource CardBackgroundFillColorTertiary}"/>
                                <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#505050"/>
                                <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#2A2A2A"/>
                                <SolidColorBrush x:Key="TextControlPlaceholderForegroundDisabled" Color="#404040"/>
                            </TextBox.Resources>
                        </TextBox>
                        <Button Name="btnRenameAlbum" Content="Rename Album" Style="{StaticResource AccentButtonStyle}" Grid.Row="1" Background="{StaticResource GlobalAccentColor}" >
                            <Button.Resources>
                                <SolidColorBrush x:Key="AccentButtonBackground" Color="{StaticResource GlobalAccentColor}"/>
                                <SolidColorBrush x:Key="AccentButtonForeground" Color="#0B0D13"/>
                                <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent"/>


                                <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{StaticResource GlobalAccentColorPointerOver}"/>
                                <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#0B0D13"/>
                                <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="Transparent"/>

                                <!-- Pressed State -->
                                <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                                <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF"/>
                                <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="Transparent"/>

                                <!-- Disabled State -->
                                <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#2A2A2A"/>
                                <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#707070"/>
                                <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="Transparent"/>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </TeachingTip>
                <vusic:ListViewMedia Visibility="{x:Bind FoundSongs.Count, Mode=OneWay, Converter={StaticResource VisibilityOfMainContent}}"
Grid.Row="1" ItemsSource="{x:Bind FoundSongs, Mode=OneWay}"
                 
x:Name="lstViewAllSongs" 
MediaSource="Artist">
                </vusic:ListViewMedia>
            </Grid>

        </Grid>
    </Grid>

</Page>
