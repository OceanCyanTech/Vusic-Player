<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Vusic_Player.Pages.VideoPlayer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Vusic_Player.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:winui="using:FlyleafLib.Controls.WinUI" xmlns:ui="using:CommunityToolkit.WinUI" xmlns:media="using:CommunityToolkit.WinUI.Media" xmlns:playbackviews="using:Vusic_Player.UI.UserViews.Controls" xmlns:converters="using:Vusic_Player.Configuration.Helper.Converters" xmlns:audioadvanced="using:Vusic_Player.UI.Dialogs.VideoOptions.Audio.AudioAdvanced" xmlns:controls="using:Vusic_Player.UI.Controls"
    mc:Ignorable="d">
    <Page.Resources>
        <!--<converter:DoubleToFormatConverter x:Key="FormatConverter"/>
        <converter:PercentStringConverter x:Key="PercentConverter"></converter:PercentStringConverter>-->
        <Storyboard x:Name="FadeInOutStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="grdInfo"
                                   Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame KeyTime="0:0:0.5" Value="1.0" />

                <LinearDoubleKeyFrame KeyTime="0:0:3.5" Value="1.0" />

                <LinearDoubleKeyFrame KeyTime="0:0:4.0" Value="0.0" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Name="FadeInStoryboardShowInfo">
            <DoubleAnimation Storyboard.TargetName="grdShowInfo"
                     Storyboard.TargetProperty="Opacity"
                     To="1.0" 
                     Duration="0:0:1.5" />
        </Storyboard>

        <Storyboard x:Name="FadeOutStoryboardShowInfo">
            <DoubleAnimation Storyboard.TargetName="grdShowInfo"
                     Storyboard.TargetProperty="Opacity"
                     To="0.0" 
                     Duration="0:0:0.5" />
        </Storyboard>
        <Storyboard x:Name="FadeInStoryboardMultipleOutput">
            <DoubleAnimation Storyboard.TargetName="grdMultipleOutput"
             Storyboard.TargetProperty="Opacity"
             To="1.0" 
             Duration="0:0:1.5" />
        </Storyboard>

        <Storyboard x:Name="FadeOutStoryboardMultipleOutput">
            <DoubleAnimation Storyboard.TargetName="grdMultipleOutput"
             Storyboard.TargetProperty="Opacity"
             To="0.0" 
             Duration="0:0:0.5" />
        </Storyboard>
        <Storyboard x:Name="FadeInStoryboardChapters">
            <DoubleAnimation Storyboard.TargetName="grdVideoChapters"
       Storyboard.TargetProperty="Opacity"
       To="1.0" 
       Duration="0:0:1.5" />
        </Storyboard>

        <Storyboard x:Name="FadeOutStoryboardChapters">
            <DoubleAnimation Storyboard.TargetName="grdVideoChapters"
       Storyboard.TargetProperty="Opacity"
       To="0.0" 
       Duration="0:0:0.5" />
        </Storyboard>
        <Storyboard x:Name="FadeInStoryboardStats">
            <DoubleAnimation Storyboard.TargetName="grdMediaStats"
       Storyboard.TargetProperty="Opacity"
       To="1.0" 
       Duration="0:0:1.5" />
        </Storyboard>

        <Storyboard x:Name="FadeOutStoryboardStats">
            <DoubleAnimation Storyboard.TargetName="grdMediaStats"
       Storyboard.TargetProperty="Opacity"
       To="0.0" 
       Duration="0:0:0.5" />
        </Storyboard>

        <Storyboard x:Name="FadeInOutSeek">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="txtSeek"
                            Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame KeyTime="0:0:0.5" Value="1.0" />

                <LinearDoubleKeyFrame KeyTime="0:0:3.5" Value="1.0" />

                <LinearDoubleKeyFrame KeyTime="0:0:4.0" Value="0.0" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Name="FadeInOutCommands">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="txtCommands"
                            Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame KeyTime="0:0:0.5" Value="1.0" />

                <LinearDoubleKeyFrame KeyTime="0:0:3.5" Value="1.0" />

                <LinearDoubleKeyFrame KeyTime="0:0:4.0" Value="0.0" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <Storyboard x:Name="FadeInOutStoryboardPanel" Completed="FadeInOutStoryboardPanel_Completed">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="grdRootPlayback"
                            Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame KeyTime="0:0:0.1" Value="1.0" />

                <LinearDoubleKeyFrame KeyTime="0:0:3.2" Value="1.0" />

                <LinearDoubleKeyFrame KeyTime="0:0:3.3" Value="0.0" />
            </DoubleAnimationUsingKeyFrames>
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="grdRootPlayback" 
                                   Storyboard.TargetProperty="Visibility">
                <DiscreteObjectKeyFrame KeyTime="0:0:0">
                    <DiscreteObjectKeyFrame.Value>
                        <Visibility>Visible</Visibility>
                    </DiscreteObjectKeyFrame.Value>
                </DiscreteObjectKeyFrame>

                <DiscreteObjectKeyFrame KeyTime="0:0:3.3">
                    <DiscreteObjectKeyFrame.Value>
                        <Visibility>Collapsed</Visibility>
                    </DiscreteObjectKeyFrame.Value>
                </DiscreteObjectKeyFrame>
            </ObjectAnimationUsingKeyFrames>
        </Storyboard>
        <converters:FavoriteToGlyphConverter x:Key="FavoritetoGlyphConv"/>
        <converters:FavoriteToColorConverter x:Key="FavoritetoColorConv"/>
    </Page.Resources>

    <controls:CursorDisappearGrid x:Name="RootGrid" PreviewKeyDown="MainGrid_PreviewKeyDown" KeyboardAcceleratorPlacementMode="Hidden">
        <controls:CursorDisappearGrid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Space" Invoked="Spacebar_Invoked" />
            <KeyboardAccelerator Key="M" Invoked="KeyboardAccelerator_Invoked"/>

        </controls:CursorDisappearGrid.KeyboardAccelerators>
        <Grid Name="SplashGrid" Visibility="Visible" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="20" />

                </TransitionCollection>
            </Grid.ChildrenTransitions>
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <TextBlock Name="txtSplash" Text="No video is playing right now!" Grid.Row="0" Style="{StaticResource TitleTextBlockStyle}"></TextBlock>

            <Button Margin="0, 50" Name="btnOpenVidSplash" Click="btnOpenVidSplash_Click" Grid.Row="1" HorizontalAlignment="Center" Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Image Width="20" Source="{Binding DefaultVideo, Source={StaticResource GlobalIconHolder}}"></Image>
                    <TextBlock Text="Open Video"></TextBlock>
                </StackPanel>
            </Button>
            <Button Name="btnSettings" Content="Settings" Click="btnSettings_Click" Grid.Row="2" HorizontalAlignment="Center"></Button>
        </Grid>
        <Grid Name="MainGrid"  Visibility="Visible" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" PointerMoved="MainGrid_PointerMoved" PointerEntered="MainGrid_PointerEntered">
            <Grid.ContextFlyout>
                <MenuFlyout Opened="MenuFlyout_Opened">
                    <MenuFlyoutItem x:Name="mnftOpenVideo" Text="Open Another Media" Click="mnftOpenVideo_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Name="fntIconVolume"  Glyph="&#xE8E5;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutItem x:Name="mnftVolume" Text="Volume" Click="mnftVolume_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE767;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>


                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Name="mnftFileInfo" Text="File Info" Click="mnftFileInfo_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE946;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Name="mnftOpenFileLocation" Text="Open File Location" Click="mnftOpenFileLocation_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8DA;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />

                    <MenuFlyoutItem x:Name="mnftPrevious" Text="Previous" Click="mnftPrevious_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE892;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutItem x:Name="mnftSkipBack" Text="Skip back 10 secs" Click="mnftSkipBack_Click">
                        <MenuFlyoutItem.Icon>
                            <ImageIcon Source="{Binding SkipBack, Source= {StaticResource GlobalIconHolder}}"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutItem x:Name="mnftPlay" Text="{x:Bind mediacontroller.PlayPauseToolTip, Mode=OneWay}" Click="mnftPlay_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Name="fntIconPlay"  Glyph="&#xE768;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutItem x:Name="mnftSkipForward" Text="Skip Forward 10 secs" Click="mnftSkipForward_Click">
                        <MenuFlyoutItem.Icon>
                            <ImageIcon Source="{Binding SkipForward, Source= {StaticResource GlobalIconHolder}}"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutItem x:Name="mnftNext" Text="Next" Click="mnftNext_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE893;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutSeparator />

                    <ToggleMenuFlyoutItem x:Name="mnftFullScreen" IsChecked="{x:Bind mediacontroller.IsFullScreen, Mode=TwoWay}" Text="{x:Bind mediacontroller.FullScreenToolTip, Mode=OneWay}" Click="mnftFullScreen_Click">
                        <ToggleMenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE740;"/>
                        </ToggleMenuFlyoutItem.Icon>
                    </ToggleMenuFlyoutItem>

                    <MenuFlyoutItem x:Name="mnftSubtitleOptions" Text="Subtitle Options" Click="mnftSubtitleOptions_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xED1E;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutItem x:Name="mnftVideoOptions" Text="Video Options" Click="mnftVideoOptions_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE714;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutItem x:Name="mnftAudioOptions" Text="Audio Options" Click="mnftAudioOptions_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8D6;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutSeparator />

                    <MenuFlyoutItem x:Name="mnftHome" Text="Home" Click="mnftHome_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE80F;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </Grid.ContextFlyout>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
            </Grid.RowDefinitions>
            <winui:FlyleafHost RenderTransformOrigin="0.5, 0.5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Row="0" x:Name="hostMedia">
                <winui:FlyleafHost.RenderTransform>
                    <RotateTransform x:Name="mediaRotation" Angle="{x:Bind AngleRotate.AngleRotation, Mode=OneWay}"
             />
                </winui:FlyleafHost.RenderTransform>
            </winui:FlyleafHost>
            <Grid Name="grdWatermarkValues" Visibility="{x:Bind watermarkFontValues.OverallVisibility, Mode=OneWay}">
                <!-- Label 1 -->
                <TextBlock x:Name="txtLabel1" Text="" Margin="40, 40"
           HorizontalAlignment="{x:Bind watermarkFontValues.Label1HorizontalAlignment, Mode=OneWay}"
           VerticalAlignment="{x:Bind watermarkFontValues.Label1VerticalAlignment, Mode=OneWay}"
           FontFamily="{x:Bind watermarkFontValues.Label1FontFamily, Mode=OneWay}"
           FontSize="{x:Bind watermarkFontValues.Label1FontSize, Mode=OneWay}"
           FontWeight="{x:Bind watermarkFontValues.Label1FontWeight, Mode=OneWay}"
           FontStyle="{x:Bind watermarkFontValues.Label1FontStyle, Mode=OneWay}"
           Visibility="{x:Bind watermarkFontValues.Label1IsVisible, Mode=OneWay}"
           Foreground="{x:Bind watermarkFontValues.Label1FontColor, Mode=OneWay}"/>

                <!-- Label 2 -->
                <TextBlock x:Name="txtLabel2" Text="" Margin="40, 40"
           HorizontalAlignment="{x:Bind watermarkFontValues.Label2HorizontalAlignment, Mode=OneWay}"
           VerticalAlignment="{x:Bind watermarkFontValues.Label2VerticalAlignment, Mode=OneWay}"
           FontFamily="{x:Bind watermarkFontValues.Label2FontFamily, Mode=OneWay}"
           FontSize="{x:Bind watermarkFontValues.Label2FontSize, Mode=OneWay}"
           FontWeight="{x:Bind watermarkFontValues.Label2FontWeight, Mode=OneWay}"
           FontStyle="{x:Bind watermarkFontValues.Label2FontStyle, Mode=OneWay}"
           Visibility="{x:Bind watermarkFontValues.Label2IsVisible, Mode=OneWay}"
           Foreground="{x:Bind watermarkFontValues.Label2FontColor, Mode=OneWay}"/>

                <!-- Label 3 -->
                <TextBlock x:Name="txtLabel3" Text="" Margin="40, 40"
           HorizontalAlignment="{x:Bind watermarkFontValues.Label3HorizontalAlignment, Mode=OneWay}"
           VerticalAlignment="{x:Bind watermarkFontValues.Label3VerticalAlignment, Mode=OneWay}"
           FontFamily="{x:Bind watermarkFontValues.Label3FontFamily, Mode=OneWay}"
           FontSize="{x:Bind watermarkFontValues.Label3FontSize, Mode=OneWay}"
           FontWeight="{x:Bind watermarkFontValues.Label3FontWeight, Mode=OneWay}"
           FontStyle="{x:Bind watermarkFontValues.Label3FontStyle, Mode=OneWay}"
           Visibility="{x:Bind watermarkFontValues.Label3IsVisible, Mode=OneWay}"
           Foreground="{x:Bind watermarkFontValues.Label3FontColor, Mode=OneWay}"/>

                <!-- Label 4 -->
                <TextBlock x:Name="txtLabel4" Text="" Margin="40, 40"
           HorizontalAlignment="{x:Bind watermarkFontValues.Label4HorizontalAlignment, Mode=OneWay}"
           VerticalAlignment="{x:Bind watermarkFontValues.Label4VerticalAlignment, Mode=OneWay}"
           FontFamily="{x:Bind watermarkFontValues.Label4FontFamily, Mode=OneWay}"
           FontSize="{x:Bind watermarkFontValues.Label4FontSize, Mode=OneWay}"
           FontWeight="{x:Bind watermarkFontValues.Label4FontWeight, Mode=OneWay}"
           FontStyle="{x:Bind watermarkFontValues.Label4FontStyle, Mode=OneWay}"
           Visibility="{x:Bind watermarkFontValues.Label4IsVisible, Mode=OneWay}"
           Foreground="{x:Bind watermarkFontValues.Label4FontColor, Mode=OneWay}"/>

                <!-- Label 5 -->
                <TextBlock x:Name="txtLabel5" Text="" Margin="40, 40"
           HorizontalAlignment="{x:Bind watermarkFontValues.Label5HorizontalAlignment, Mode=OneWay}"
           VerticalAlignment="{x:Bind watermarkFontValues.Label5VerticalAlignment, Mode=OneWay}"
           FontFamily="{x:Bind watermarkFontValues.Label5FontFamily, Mode=OneWay}"
           FontSize="{x:Bind watermarkFontValues.Label5FontSize, Mode=OneWay}"
           FontWeight="{x:Bind watermarkFontValues.Label5FontWeight, Mode=OneWay}"
           FontStyle="{x:Bind watermarkFontValues.Label5FontStyle, Mode=OneWay}"
           Visibility="{x:Bind watermarkFontValues.Label5IsVisible, Mode=OneWay}"
           Foreground="{x:Bind watermarkFontValues.Label5FontColor, Mode=OneWay}"/>

                <!-- Label 6 -->
                <TextBlock x:Name="txtLabel6" Text="" Margin="40, 40"
           HorizontalAlignment="{x:Bind watermarkFontValues.Label6HorizontalAlignment, Mode=OneWay}"
           VerticalAlignment="{x:Bind watermarkFontValues.Label6VerticalAlignment, Mode=OneWay}"
           FontFamily="{x:Bind watermarkFontValues.Label6FontFamily, Mode=OneWay}"
           FontSize="{x:Bind watermarkFontValues.Label6FontSize, Mode=OneWay}"
           FontWeight="{x:Bind watermarkFontValues.Label6FontWeight, Mode=OneWay}"
           FontStyle="{x:Bind watermarkFontValues.Label6FontStyle, Mode=OneWay}"
           Visibility="{x:Bind watermarkFontValues.Label6IsVisible, Mode=OneWay}"
           Foreground="{x:Bind watermarkFontValues.Label6FontColor, Mode=OneWay}"/>

                <!-- Label 7 -->
                <TextBlock x:Name="txtLabel7" Text="" Margin="40, 40"
           HorizontalAlignment="{x:Bind watermarkFontValues.Label7HorizontalAlignment, Mode=OneWay}"
           VerticalAlignment="{x:Bind watermarkFontValues.Label7VerticalAlignment, Mode=OneWay}"
           FontFamily="{x:Bind watermarkFontValues.Label7FontFamily, Mode=OneWay}"
           FontSize="{x:Bind watermarkFontValues.Label7FontSize, Mode=OneWay}"
           FontWeight="{x:Bind watermarkFontValues.Label7FontWeight, Mode=OneWay}"
           FontStyle="{x:Bind watermarkFontValues.Label7FontStyle, Mode=OneWay}"
           Visibility="{x:Bind watermarkFontValues.Label7IsVisible, Mode=OneWay}"
           Foreground="{x:Bind watermarkFontValues.Label7FontColor, Mode=OneWay}"/>

                <!-- Label 8 -->
                <TextBlock x:Name="txtLabel8" Text="" Margin="40, 40"
           HorizontalAlignment="{x:Bind watermarkFontValues.Label8HorizontalAlignment, Mode=OneWay}"
           VerticalAlignment="{x:Bind watermarkFontValues.Label8VerticalAlignment, Mode=OneWay}"
           FontFamily="{x:Bind watermarkFontValues.Label8FontFamily, Mode=OneWay}"
           FontSize="{x:Bind watermarkFontValues.Label8FontSize, Mode=OneWay}"
           FontWeight="{x:Bind watermarkFontValues.Label8FontWeight, Mode=OneWay}"
           FontStyle="{x:Bind watermarkFontValues.Label8FontStyle, Mode=OneWay}"
           Visibility="{x:Bind watermarkFontValues.Label8IsVisible, Mode=OneWay}"
           Foreground="{x:Bind watermarkFontValues.Label8FontColor, Mode=OneWay}"/>

                <!-- Label 9 -->
                <TextBlock x:Name="txtLabel9" Text="" Margin="40, 40"
           HorizontalAlignment="{x:Bind watermarkFontValues.Label9HorizontalAlignment, Mode=OneWay}"
           VerticalAlignment="{x:Bind watermarkFontValues.Label9VerticalAlignment, Mode=OneWay}"
           FontFamily="{x:Bind watermarkFontValues.Label9FontFamily, Mode=OneWay}"
           FontSize="{x:Bind watermarkFontValues.Label9FontSize, Mode=OneWay}"
           FontWeight="{x:Bind watermarkFontValues.Label9FontWeight, Mode=OneWay}"
           FontStyle="{x:Bind watermarkFontValues.Label9FontStyle, Mode=OneWay}"
           Visibility="{x:Bind watermarkFontValues.Label9IsVisible, Mode=OneWay}"
           Foreground="{x:Bind watermarkFontValues.Label9FontColor, Mode=OneWay}"/>
            </Grid>
            <StackPanel Name="stkRecording" Visibility="Collapsed" Orientation="Horizontal" Spacing="5" VerticalAlignment="Top" Margin="10, 10">
                <Image Width="15" Source="{Binding RecordIcon, Source={StaticResource GlobalIconHolder}}"></Image>

                <TextBlock Text="SCREEN RECORDING" Margin="0, 10" FontWeight="Bold" Style="{StaticResource BodyTextBlockStyle}" Foreground="Crimson"></TextBlock>
                <TextBlock Text="00:00:00" Margin="0, 10" Name="txtRecordingTimeFrame"></TextBlock>
                <Button Content="Stop Recording" Margin="10, 0" Style="{StaticResource AccentButtonStyle}" Name="btnStopRecording" Click="btnStopRecording_Click"></Button>
            </StackPanel>
            <Rectangle x:Name="RecFrame"  Visibility="Collapsed" Stroke="Cyan"  StrokeThickness="2"  RadiusX="8" RadiusY="8"
StrokeDashArray="3,1.5"
Opacity="0"
IsHitTestVisible="False"
HorizontalAlignment="Stretch" 
VerticalAlignment="Stretch"
Margin="2"/>
            <Grid Name="grdInfo" Visibility="Collapsed" Opacity="0" Margin="20, 40, 0, 0">

                <Border  Padding="5" VerticalAlignment="Top"     HorizontalAlignment="Left" Opacity="1"  Name="brdInformation"
BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
BorderThickness="1" 
CornerRadius="16" >
                    <Border.Background>
                        <media:AcrylicBrush BlurAmount="15"
                                        TintColor="Black"
                                        TintOpacity=".6" />
                    </Border.Background>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                        </Grid.RowDefinitions>
                        <Button Click="btnCloseInformation_Click" Name="btnCloseInformation" HorizontalAlignment="Right" Background="Transparent" BorderBrush="Transparent" ToolTipService.ToolTip="Close" Grid.Row="0">
                            <Image Width="20" Source="{Binding Removeicon, Source={StaticResource GlobalIconHolder}}"></Image>
                        </Button>
                        <TextBlock Grid.Row="1" Text="" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="1" x:Name="txtInformation" Style="{StaticResource TitleTextBlockStyle}" ></TextBlock>
                    </Grid>
                </Border>

            </Grid>
            <Grid MaxHeight="500" Visibility="Collapsed" Opacity="0" Margin="20, 10" Name="grdMultipleOutput" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Border CornerRadius="20">
                    <Border.Background>
                        <media:AcrylicBrush BlurAmount="15"
                     TintColor="Black"
                     TintOpacity=".6" />
                    </Border.Background>
                    <audioadvanced:MultipleOutputMixer x:Name="multiOutputMixer"/>
                </Border>
            </Grid>
            <Grid MaxHeight="500" Visibility="Collapsed" Opacity="0" Margin="20, 10" Name="grdVideoChapters" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Border CornerRadius="20" >
                    <Border.Background>
                        <media:AcrylicBrush BlurAmount="15"
                     TintColor="Black"
                     TintOpacity=".6" />
                    </Border.Background>
                    <Grid Margin="22, 22" RowSpacing="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Button Click="btnCloseChapters_Click" Name="btnCloseChapters" HorizontalAlignment="Right" Background="Transparent" BorderBrush="Transparent" ToolTipService.ToolTip="Close" Grid.Row="0">
                            <Image Width="20" Source="{Binding Removeicon, Source={StaticResource GlobalIconHolder}}"></Image>
                        </Button>
                        <TextBlock Grid.Row="1" Text="Video Chapters" Style="{StaticResource TitleTextBlockStyle}"/>
                        <AutoSuggestBox Visibility="Collapsed" Name="asbSearchChapters" PlaceholderText="Search chapters..." QuerySubmitted="asbSearchChapters_QuerySubmitted" QueryIcon="Find" Grid.Row="2" TextChanged="asbSearchChapters_TextChanged"/>
                        <Grid Grid.Row="3" Name="grdChapterHeaders" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Title"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource BodyStrongTextBlockStyle}"  Text="Start Time"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource BodyStrongTextBlockStyle}"  Text="End Time"/>
                        </Grid>
                        <ListView IsItemClickEnabled="True" Name="lstViewVideoChapters" Grid.Row="4" ItemClick="lstViewVideoChapters_ItemClick">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Grid.Row="1" ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding ChapterTitle}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding StartTimeStr}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding EndTimeStr}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Grid Grid.Row="4" Name="grdNoSearchResultsChapter" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Image Source="{Binding EmptyStuffLeaves, Source={StaticResource GlobalIconHolder}}" Width="20"/>
                            <TextBlock Grid.Column="1" Text="No chapters found based on your search query!"></TextBlock>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
            <Grid MaxHeight="500" Visibility="Collapsed" Opacity="0" Margin="20, 10" Name="grdMediaStats" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Border CornerRadius="20" >
                    <Border.Background>
                        <media:AcrylicBrush BlurAmount="15"
                     TintColor="Black"
                     TintOpacity=".6" />
                    </Border.Background>
                    <Grid Margin="22, 22" RowSpacing="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Button Click="btnCloseStats_Click" Name="btnCloseStats" HorizontalAlignment="Right" Background="Transparent" BorderBrush="Transparent" ToolTipService.ToolTip="Close" Grid.Row="0">
                            <Image Width="20" Source="{Binding Removeicon, Source={StaticResource GlobalIconHolder}}"></Image>
                        </Button>
                        <TextBlock Grid.Row="1" Text="Media Stats" Style="{StaticResource TitleTextBlockStyle}"/>
                        <TabView IsAddTabButtonVisible="False" Grid.Row="2"  Name="tbViewStats">
                            <TabView.TabItems>
                                <TabViewItem Background="Transparent" Header="Video" IsClosable="False">
                                    <Grid ColumnSpacing="24" RowSpacing="8" Margin="0, 20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <!-- 0: Headers -->
                                            <RowDefinition Height="Auto"/>
                                            <!-- 1: Separator -->
                                            <RowDefinition Height="Auto"/>
                                            <!-- 2: Frames Decoded -->
                                            <RowDefinition Height="Auto"/>
                                            <!-- 3: Frames Displayed -->
                                            <RowDefinition Height="Auto"/>
                                            <!-- 4: Frames Dropped -->
                                            <RowDefinition Height="Auto"/>
                                            <!-- 5: Frames Delayed -->
                                            <RowDefinition Height="Auto"/>
                                            <!-- 6: Separator -->
                                            <RowDefinition Height="Auto"/>
                                            <!-- 7: Encoded FPS -->
                                            <RowDefinition Height="Auto"/>
                                            <!-- 8: A/V Offset -->
                                        </Grid.RowDefinitions>

                                        <!-- Headers -->
                                        <TextBlock Text="Parameters" 
               Grid.Row="0" Grid.Column="0" 
               Style="{StaticResource SubtitleTextBlockStyle}"/>
                                        <Grid Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="Corresponding Value" 
                   Grid.Column="0" 
                   VerticalAlignment="Center"
                   Style="{StaticResource SubtitleTextBlockStyle}"/>

                                            <!-- Copy Stats Button -->
                                            <Button x:Name="btnCopyStatsVideo"
                Grid.Column="1"
                Click="btnCopyStatsVideo_Click"
                ToolTipService.ToolTip="Copy Stats to Clipboard"
                Padding="6,4"
                Background="Transparent"
                BorderThickness="0">
                                                <FontIcon Glyph="&#xE8C8;" FontSize="14"/>
                                            </Button>
                                        </Grid>

                                        <!-- Separator 1 -->
                                        <MenuFlyoutSeparator Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,8"/>

                                        <!-- Pipeline Metrics -->
                                        <TextBlock Text="Frames Decoded" 
               Grid.Row="2" Grid.Column="0" 
               Style="{StaticResource BodyStrongTextBlockStyle}" IsTextSelectionEnabled="True"/>
                                        <TextBlock Text="0" 
               Grid.Row="2" Grid.Column="1" 
               Name="txtDecodedFrames" IsTextSelectionEnabled="True"/>

                                        <TextBlock Text="Frames Displayed" 
               Grid.Row="3" Grid.Column="0" 
               Style="{StaticResource BodyStrongTextBlockStyle}" IsTextSelectionEnabled="True"/>
                                        <TextBlock Text="0" 
               Grid.Row="3" Grid.Column="1" 
               Name="txtFramesDisplayed" IsTextSelectionEnabled="True"/>

                                        <TextBlock Text="Frames Dropped" 
               Grid.Row="4" Grid.Column="0" 
               Style="{StaticResource BodyStrongTextBlockStyle}" IsTextSelectionEnabled="True"/>
                                        <TextBlock Text="0" 
               Grid.Row="4" Grid.Column="1" 
               Name="txtFramesDropped" IsTextSelectionEnabled="True"/>

                                        <TextBlock Text="Frames Delayed" 
               Grid.Row="5" Grid.Column="0" 
               Style="{StaticResource BodyStrongTextBlockStyle}" IsTextSelectionEnabled="True"/>
                                        <TextBlock Text="0" 
               Grid.Row="5" Grid.Column="1" 
               Name="txtFramesDelayed" IsTextSelectionEnabled="True"/>

                                        <!-- Separator 2 -->
                                        <MenuFlyoutSeparator Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,8"/>

                                        <!-- Timing & Stream Info -->
                                        <TextBlock Text="Encoded FPS" 
               Grid.Row="7" Grid.Column="0" 
               Style="{StaticResource BodyStrongTextBlockStyle}" IsTextSelectionEnabled="True"/>
                                        <TextBlock Text="0.000 fps" 
               Grid.Row="7" Grid.Column="1" 
               Name="txtEncodedFPS" IsTextSelectionEnabled="True"/>

                                        <TextBlock Text="A/V Offset" 
               Grid.Row="8" Grid.Column="0" 
               Style="{StaticResource BodyStrongTextBlockStyle}" IsTextSelectionEnabled="True"/>
                                        <TextBlock Text="0.0 ms" 
               Grid.Row="8" Grid.Column="1" 
               Name="txtAVOffset" IsTextSelectionEnabled="True"/>
                                    </Grid>
                                </TabViewItem>
                                <TabViewItem Background="Transparent" Header="Audio" IsClosable="False">
                                    <Grid ColumnSpacing="24" RowSpacing="8" Margin="0, 20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <!-- 0: Headers -->
                                            <RowDefinition Height="Auto"/>
                                            <!-- 1: Separator -->
                                            <RowDefinition Height="Auto"/>
                                            <!-- 2: Frames Decoded -->
                                            <RowDefinition Height="Auto"/>
                                            <!-- 3: Frames Displayed -->
                                            <RowDefinition Height="Auto"/>
                                            <!-- 4: Frames Dropped -->
                                            <RowDefinition Height="Auto"/>
                                            <!-- 5: Frames Delayed -->
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Headers -->
                                        <TextBlock Text="Parameters" 
               Grid.Row="0" Grid.Column="0" 
               Style="{StaticResource SubtitleTextBlockStyle}"/>
                                        <Grid Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="Corresponding Value" 
                   Grid.Column="0" 
                   VerticalAlignment="Center"
                   Style="{StaticResource SubtitleTextBlockStyle}"/>

                                            <!-- Copy Stats Button -->
                                            <Button x:Name="btnCopyStatsAudio"
                Grid.Column="1"
                Click="btnCopyStatsAudio_Click"
                ToolTipService.ToolTip="Copy Stats to Clipboard"
                Padding="6,4"
                Background="Transparent"
                BorderThickness="0">
                                                <FontIcon Glyph="&#xE8C8;" FontSize="14"/>
                                            </Button>
                                        </Grid>


                                        <!-- Separator 1 -->
                                        <MenuFlyoutSeparator Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,8"/>

                                        <!-- Pipeline Metrics -->
                                        <TextBlock Text="Decoded" 
               Grid.Row="2" Grid.Column="0" 
               Style="{StaticResource BodyStrongTextBlockStyle}" IsTextSelectionEnabled="True"/>
                                        <TextBlock Text="0" 
               Grid.Row="2" Grid.Column="1" 
               Name="txtDecodedAudio" IsTextSelectionEnabled="True"/>

                                        <TextBlock Text="Played" 
               Grid.Row="3" Grid.Column="0" 
               Style="{StaticResource BodyStrongTextBlockStyle}" IsTextSelectionEnabled="True"/>
                                        <TextBlock Text="0" 
               Grid.Row="3" Grid.Column="1" 
               Name="txtAudioPlayed" IsTextSelectionEnabled="True"/>

                                        <TextBlock Text="Dropped" 
               Grid.Row="4" Grid.Column="0" 
               Style="{StaticResource BodyStrongTextBlockStyle}" IsTextSelectionEnabled="True"/>
                                        <TextBlock Text="0" 
               Grid.Row="4" Grid.Column="1" 
               Name="txtFramesDroppedAudio" IsTextSelectionEnabled="True"/>



                                        <!-- Separator 2 -->
                                        <MenuFlyoutSeparator Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,8"/>

                                        <!-- Timing & Stream Info -->
                                        <TextBlock Text="Device Delay" 
               Grid.Row="7" Grid.Column="0" 
               Style="{StaticResource BodyStrongTextBlockStyle}" IsTextSelectionEnabled="True"/>
                                        <TextBlock Text="0" 
               Grid.Row="7" Grid.Column="1" 
               Name="txtDeviceDelay" IsTextSelectionEnabled="True"/>

                                        <TextBlock Text="Output Device" 
               Grid.Row="8" Grid.Column="0" 
               Style="{StaticResource BodyStrongTextBlockStyle}" IsTextSelectionEnabled="True"/>
                                        <TextBlock Text="null" 
               Grid.Row="8" Grid.Column="1" 
               Name="txtDeviceOutput" IsTextSelectionEnabled="True"/>

                                        <TextBlock Text="Buffer Duration" 
Grid.Row="9" Grid.Column="0" 
Style="{StaticResource BodyStrongTextBlockStyle}" IsTextSelectionEnabled="True"/>
                                        <TextBlock Text="0" 
Grid.Row="9" Grid.Column="1" 
Name="txtBufferDuration" IsTextSelectionEnabled="True"/>
                                    </Grid>
                                </TabViewItem>

                            </TabView.TabItems>
                        </TabView>
                        <!--<ListView IsItemClickEnabled="True" Name="lstViewVideoLogs" Grid.Row="2" >
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Grid.Row="1" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Image Source="{Binding Icon}" Width="20"/>
                                        <TextBlock Grid.Column="1" IsTextSelectionEnabled="True" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding Message}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>-->
                    </Grid>
                </Border>
            </Grid>
            <Grid MaxHeight="600" Visibility="Visible" Opacity="0" Margin="20, 10" Name="grdShowInfo" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Border CornerRadius="20">
                    <Border.Background>
                        <media:AcrylicBrush BlurAmount="15"
                     TintColor="Black"
                     TintOpacity=".6" />
                    </Border.Background>
                    <Grid RowSpacing="20" Margin="20, 10" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition MaxHeight="300" />

                        </Grid.RowDefinitions>
                        <TextBlock Text="Title" Name="txtShowTitle" Grid.Row="1" Style="{StaticResource TitleLargeTextBlockStyle}"></TextBlock>


                        <Button Click="btnCloseShowInfo_Click" Name="btnCloseShowInfo" HorizontalAlignment="Right" Background="Transparent" BorderBrush="Transparent" ToolTipService.ToolTip="Close" Grid.Row="0">
                            <Image Width="20" Source="{Binding Removeicon, Source={StaticResource GlobalIconHolder}}"></Image>
                        </Button>
                        <StackPanel Grid.Row="2" Orientation="Vertical" Spacing="20">
                            <TextBlock Text="• 0 Seasons" Name="txtShowSeasonCount" Style="{StaticResource BodyLargeStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"></TextBlock>
                            <TextBlock Text="• Released on " Name="txtShowReleaseDate" Style="{StaticResource BodyLargeStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"></TextBlock>

                        </StackPanel>
                        <MenuFlyoutSeparator Grid.Row="3"/>
                        <TextBlock Text="Episodes" Grid.Row="4" Style="{StaticResource TitleTextBlockStyle}"></TextBlock>
                        <SelectorBar SelectionChanged="selbarSeasons_SelectionChanged" Name="selbarSeasons" Grid.Row="5">

                        </SelectorBar>
                        <TextBlock Name="txtSeasonEpisodeCount" Text="Loading episodes..." Grid.Row="6" Style="{StaticResource BodyLargeStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"></TextBlock>
                        <Grid Visibility="Collapsed" HorizontalAlignment="Center" Grid.Row="7" Name="grdNoEpisodes" RowSpacing="20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"></RowDefinition>
                                <RowDefinition Height="Auto"></RowDefinition>
                            </Grid.RowDefinitions>
                            <Image Source="{Binding EmptyStuffLeaves, Source={StaticResource GlobalIconHolder}}" Width="30" Grid.Row="0"></Image>
                            <TextBlock Text="No episodes in this season!" Name="txtNoEpisodes" Grid.Row="1"></TextBlock>
                        </Grid>
                        <ListView IsItemClickEnabled="True" ItemClick="lstViewEpisodes_ItemClick" Name="lstViewEpisodes" Grid.Row="7">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0, 10" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition></ColumnDefinition>
                                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0" RowSpacing="10">
                                            <Grid.ContextFlyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem Text="Play" Name="mnftPlayEpisode" Click="mnftPlayEpisode_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE768;"></FontIcon>
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="File Info" Name="mnftFileInfoEpisode" Click="mnftFileInfoEpisode_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE946;"></FontIcon>
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </Grid.ContextFlyout>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>

                                            </Grid.RowDefinitions>
                                            <Viewbox MaxWidth="150" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal" Grid.Row="0" Spacing="20">
                                                    <Button Click="btnPlayEpisode_Click" Name="btnPlayEpisode" ToolTipService.ToolTip="Play" CornerRadius="60" Width="40" Height="40" Style="{StaticResource AccentButtonStyle}">
                                                        <FontIcon Glyph="&#xE768;"></FontIcon>
                                                    </Button>

                                                    <TextBlock ToolTipService.ToolTip="{Binding EpisodeName}"  Style="{StaticResource SubtitleTextBlockStyle}" Text="{Binding EpisodeName}"></TextBlock>

                                                </StackPanel>
                                            </Viewbox>
                                            <TextBlock MaxWidth="100"  TextWrapping="Wrap" Text="{Binding Description}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Grid.Row="1"></TextBlock>
                                            <StackPanel Orientation="Horizontal" Spacing="10" Grid.Row="2">
                                                <Button ToolTipService.ToolTip="File Info" Background="Transparent" Name="btnEpisodeFileInfo" Click="btnEpisodeFileInfo_Click"  Grid.Row="3" Padding="0" BorderBrush="Transparent" >
                                                    <Image Source="{Binding InfoIcon, Source={StaticResource GlobalIconHolder}}" Width="15" ></Image>
                                                </Button>
                                                <TextBlock Text="{Binding Duration}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Grid.Row="2"></TextBlock>

                                            </StackPanel>

                                        </Grid>
                                        <Viewbox Grid.Column="1" MaxWidth="180" MaxHeight="80">
                                            <Border CornerRadius="300" BorderThickness="0" BorderBrush="White" Opacity="0.9 ">
                                                <Border.Shadow>
                                                    <ThemeShadow />
                                                </Border.Shadow>
                                                <Image Source="{Binding Thumbnail}" Stretch="Uniform"></Image>
                                            </Border>
                                        </Viewbox>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                    </Grid>
                </Border>
            </Grid>

            <TeachingTip Name="ttVolume" PreferredPlacement="Center" Title="Volume">
                <StackPanel Orientation="Vertical">
                    <StackPanel Name="volStackPanel" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                        <playbackviews:OceanSlider x:Name="sldVol" IsTooltipEnabled="False" Margin="10, 0" IsEnabled="True" ValueChanged="sldVol_ValueChanged" Maximum="{x:Bind mediacontroller.MaximumVolume, Mode=OneWay}" Value="100" Width="200">
                            <ToolTipService.ToolTip>
                                <ToolTip Visibility="Visible" x:Name="VolumeToolTip" Content="{x:Bind mediacontroller.VolumeString, Mode=OneWay}" />
                            </ToolTipService.ToolTip>
                        </playbackviews:OceanSlider>
                        <StackPanel Margin="0, 10" Orientation="Horizontal" >
                            <TextBlock FontSize="12" Foreground="White" Name="txtVolumepercent" />
                            <TextBlock FontSize="12" Text="{x:Bind mediacontroller.VolumeString, Mode=OneWay}" Foreground="Cyan"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

            </TeachingTip>
            <TextBlock Grid.Row="0" Margin="10, 0"  VerticalAlignment="Center" HorizontalAlignment="Right" Visibility="Visible" Opacity="0" x:Name="txtSeek" Style="{StaticResource DisplayTextBlockStyle}" />
            <TextBlock Grid.Row="0" Margin="10, 0"  VerticalAlignment="Center" HorizontalAlignment="Right" Visibility="Visible" Opacity="0" x:Name="txtCommands" Style="{StaticResource DisplayTextBlockStyle}" />

            <Grid Grid.Row="0" Name="grdPlayback" Visibility="Visible" Opacity="1">
                <Grid.RowDefinitions>
                    <RowDefinition ></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                </Grid.RowDefinitions>
                <TextBlock MaxLines="3" Grid.Row="0" Margin="0, 10" VerticalAlignment="Bottom" HorizontalAlignment="Center"  Opacity="1" x:Name="txtSubtitle" Style="{StaticResource TitleTextBlockStyle}" ></TextBlock>

                <Grid Grid.Row="1" Name="grdRootPlayback" VerticalAlignment="Bottom">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition ></ColumnDefinition>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                        <ColumnDefinition ></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Grid  Margin="0, 10" Grid.Column="1" Background="Transparent" HorizontalAlignment="Center" Name="grdUnpinnedControls">

                        <Grid.Resources>
                            <Storyboard x:Name="NeonPulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation 
           Storyboard.TargetName="NeonGlow" 
           Storyboard.TargetProperty="Opacity" 
           From="0" To="0.9" Duration="0:0:1"/>
                            </Storyboard>
                        </Grid.Resources>
                        <Border Visibility="{x:Bind Glow.GlowEffectVisibility, Mode=OneWay}"       Margin="0,0,0,20" Grid.Column="1" CornerRadius="24" BorderThickness="1" Name="GlowSurround" Background="Transparent">
                            <ui:Effects.Shadow>
                                <ui:AttachedDropShadow 
x:Name="NeonGlow"
Color="{x:Bind Glow.GlowColor, Mode=OneWay}" 
BlurRadius="30" 
                            CastTo="{x:Bind GlowSurround}"
Opacity="0.9" 
Offset="0,0,0">
                                </ui:AttachedDropShadow>
                            </ui:Effects.Shadow>
                        </Border>
                        <Border x:Name="GlassRoot" Grid.Column="1"
        HorizontalAlignment="Center" 
        VerticalAlignment="Bottom"
        Margin="0,0,0,20"
        CornerRadius="24"
        BorderThickness="0"
        IsHitTestVisible="True">

                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#66FFFFFF" Offset="0.0" />
                                    <GradientStop Color="#11FFFFFF" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.BorderBrush>

                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#CC1A1A1A" Offset="0.0" />
                                    <GradientStop Color="#E60A0A0A" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>

                            <Grid Margin="20" HorizontalAlignment="Stretch">
                                <StackPanel Name="ControlsOverlay" Width="650" Padding="20,0,20,0">
                                    <Grid HorizontalAlignment="Stretch" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Button HorizontalAlignment="Left" Grid.Column="0" ToolTipService.ToolTip="Add to Favourites" Padding="3" Margin="0, 0" x:Name="btnFavourite" 
Click="btnFavourite_Click"
Background="Transparent" 
BorderThickness="0"
                                            >
                                            <Grid>
                                                <FontIcon x:Name="HeartIcon" FontSize="16" RenderTransformOrigin="0.5,0.5" Glyph="&#xEB51;" 
  >
                                                    <FontIcon.RenderTransform>
                                                        <ScaleTransform x:Name="HeartScale" ScaleX="1" ScaleY="1"/>
                                                    </FontIcon.RenderTransform>
                                                </FontIcon>
                                            </Grid>
                                        </Button>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">

                                            <Button Content="Next Episode" Background="Transparent" Name="btnNextEpisode" Click="btnNextEpisode_Click" Visibility="Collapsed"></Button>
                                            <Button Click="btnPin_Click" Visibility="Visible" Background="Transparent" Padding="6" ToolTipService.ToolTip="Pin this panel" HorizontalAlignment="Right" Name="btnPin" >
                                                <FontIcon FontSize="14" Glyph="&#xE718;" Name="fntPin"></FontIcon>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    <playbackviews:PlaybackMainControls FileNameTextVisibility="Collapsed" x:Name="playbackMainControls"></playbackviews:PlaybackMainControls>
                                    <playbackviews:VideoControls JumpToTime="videoControls_JumpToTime" MediaStats="videoControls_MediaStats" VideoChapters="videoControls_VideoChapters"  MultiDeviceOutput="videoControls_MultiDeviceOutput" x:Name="videoControls" FullScreenToggled="videoControls_FullScreenToggled"   ViewEpisodeClick="videoControls_ViewEpisodeClick"/>

                                </StackPanel>
                            </Grid>
                        </Border>

                    </Grid>
                    <TextBlock Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20, 0" Name="txtPinFileName" TextWrapping="Wrap"  Text="{x:Bind mediacontroller.MediaDisplayName,Mode=OneWay}"  Visibility="Collapsed" Style="{StaticResource BodyLargeStrongTextBlockStyle}"></TextBlock>
                    <Button Grid.Column="2" Visibility="Collapsed" Margin="20, 0" Background="Transparent" Padding="2" ToolTipService.ToolTip="Unpin this panel" HorizontalAlignment="Right" Name="btnPin2" Click="btnPin_Click" >
                        <FontIcon FontSize="25" Glyph="&#xE718;" Name="fntPin2"></FontIcon>
                    </Button>
                </Grid>

            </Grid>

        </Grid>
        <Button ToolTipService.ToolTip="Go Back" Name="btnBack" Click="btnBack_Click" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Image Width="20" Source="{Binding BackIcon, Source={StaticResource GlobalIconHolder}}"/>
        </Button>
        <TeachingTip Name="ttJumpToTime" Title="Jump To Time">
            <Grid Margin="10, 20"  RowSpacing="30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Vertical" Spacing="20">
                    <TextBlock Text="HH:"/>
                    <NumberBox SpinButtonPlacementMode="Inline" Name="numHour" Value="0" Minimum="0"/>
                    <TextBlock Text="MM:"/>
                    <NumberBox SpinButtonPlacementMode="Inline" Name="numMin"  Value="0" Minimum="0"/>
                    <TextBlock Text="SS"/>
                    <NumberBox SpinButtonPlacementMode="Inline" Name="numSec"  Value="0" Minimum="0"/>
                   
                </StackPanel>
                <Button Name="btnJumpToTime" Click="btnJumpToTime_Click" Content="Jump" Style="{StaticResource AccentButtonStyle}" Grid.Row="1"/>
            </Grid>
        </TeachingTip>
    </controls:CursorDisappearGrid>

</Page>
