<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Vusic_Player.Pages.VideoPlayer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Vusic_Player.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:winui="using:FlyleafLib.Controls.WinUI" xmlns:ui="using:CommunityToolkit.WinUI" xmlns:media="using:CommunityToolkit.WinUI.Media" xmlns:playbackviews="using:Vusic_Player.UI.UserViews.Controls" xmlns:converters="using:Vusic_Player.Configuration.Helper.Converters"
    mc:Ignorable="d">
    <Page.Resources>
        <!--<converter:DoubleToFormatConverter x:Key="FormatConverter"/>
        <converter:PercentStringConverter x:Key="PercentConverter"></converter:PercentStringConverter>-->
        <Storyboard x:Name="FadeInOutStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="grdInfo"
                                   Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame KeyTime="0:0:0.5" Value="1.0" />

                <LinearDoubleKeyFrame KeyTime="0:0:3.5" Value="1.0" />

                <LinearDoubleKeyFrame KeyTime="0:0:4.0" Value="0.0" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Name="FadeInStoryboardShowInfo">
            <DoubleAnimation Storyboard.TargetName="grdShowInfo"
                     Storyboard.TargetProperty="Opacity"
                     To="1.0" 
                     Duration="0:0:1.5" />
        </Storyboard>

        <Storyboard x:Name="FadeOutStoryboardShowInfo">
            <DoubleAnimation Storyboard.TargetName="grdShowInfo"
                     Storyboard.TargetProperty="Opacity"
                     To="0.0" 
                     Duration="0:0:0.5" />
        </Storyboard>
        <Storyboard x:Name="FadeInOutSeek">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="txtSeek"
                            Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame KeyTime="0:0:0.5" Value="1.0" />

                <LinearDoubleKeyFrame KeyTime="0:0:3.5" Value="1.0" />

                <LinearDoubleKeyFrame KeyTime="0:0:4.0" Value="0.0" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Name="FadeInOutStoryboardPanel">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="grdRootPlayback"
                            Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame KeyTime="0:0:0.1" Value="1.0" />

                <LinearDoubleKeyFrame KeyTime="0:0:3.2" Value="1.0" />

                <LinearDoubleKeyFrame KeyTime="0:0:3.3" Value="0.0" />
            </DoubleAnimationUsingKeyFrames>
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="grdRootPlayback" 
                                   Storyboard.TargetProperty="Visibility">
                <DiscreteObjectKeyFrame KeyTime="0:0:0">
                    <DiscreteObjectKeyFrame.Value>
                        <Visibility>Visible</Visibility>
                    </DiscreteObjectKeyFrame.Value>
                </DiscreteObjectKeyFrame>

                <DiscreteObjectKeyFrame KeyTime="0:0:3.3">
                    <DiscreteObjectKeyFrame.Value>
                        <Visibility>Collapsed</Visibility>
                    </DiscreteObjectKeyFrame.Value>
                </DiscreteObjectKeyFrame>
            </ObjectAnimationUsingKeyFrames>
        </Storyboard>
        <converters:FavoriteToGlyphConverter x:Key="FavoritetoGlyphConv"/>
        <converters:FavoriteToColorConverter x:Key="FavoritetoColorConv"/>
    </Page.Resources>

    <Grid Name="RootGrid" PreviewKeyDown="MainGrid_PreviewKeyDown">

        <Grid Name="SplashGrid" Visibility="Visible" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="20" />

                </TransitionCollection>
            </Grid.ChildrenTransitions>
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <TextBlock Name="txtSplash" Text="No video is playing right now!" Grid.Row="0" Style="{StaticResource TitleTextBlockStyle}"></TextBlock>

            <Button Margin="0, 50" Name="btnOpenVidSplash" Click="btnOpenVidSplash_Click" Grid.Row="1" HorizontalAlignment="Center" Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Image Width="20" Source="/Assets/appicon.png"></Image>
                    <TextBlock Text="Open Video"></TextBlock>
                </StackPanel>
            </Button>
            <Button Name="btnSettings" Content="Settings" Click="btnSettings_Click" Grid.Row="2" HorizontalAlignment="Center"></Button>
        </Grid>
        <Grid Name="MainGrid"  Visibility="Visible" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" PointerMoved="MainGrid_PointerMoved" PointerEntered="MainGrid_PointerEntered">
            <Grid.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem x:Name="mnftOpenVideo" Text="Open Video" Click="mnftOpenVideo_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="d"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutItem x:Name="mnftVolume" Text="Volume" Click="mnftVolume_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="d"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutSeparator />

                    <MenuFlyoutItem x:Name="mnftPrevious" Text="Previous" Click="mnftPrevious_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="d"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutItem x:Name="mnftSkipBack" Text="Skip back 10 secs" Click="mnftSkipBack_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="d"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutItem x:Name="mnftPlay" Text="Play" Click="mnftPlay_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="d"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutItem x:Name="mnftSkipForward" Text="Skip Forward 10 secs" Click="mnftSkipForward_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="d"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutItem x:Name="mnftNext" Text="Next" Click="mnftNext_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="d"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutSeparator />

                    <ToggleMenuFlyoutItem x:Name="mnftFullScreen" Text="Full Screen" Click="mnftFullScreen_Click">
                        <ToggleMenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE740;"/>
                        </ToggleMenuFlyoutItem.Icon>
                    </ToggleMenuFlyoutItem>

                    <MenuFlyoutItem x:Name="mnftSubtitleOptions" Text="Subtitle Options" Click="mnftSubtitleOptions_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xED1E;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutItem x:Name="mnftVideoOptions" Text="Video Options" Click="mnftVideoOptions_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE714;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutItem x:Name="mnftAudioOptions" Text="Audio Options" Click="mnftAudioOptions_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8D6;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutSeparator />

                    <MenuFlyoutItem x:Name="mnftHome" Text="Home" Click="mnftHome_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE80F;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </Grid.ContextFlyout>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
            </Grid.RowDefinitions>
            <winui:FlyleafHost RenderTransformOrigin="0.5, 0.5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Row="0" x:Name="hostMedia">
                <winui:FlyleafHost.RenderTransform>
                    <RotateTransform x:Name="mediaRotation" Angle="{x:Bind AngleRotate.AngleRotation, Mode=OneWay}"
             />
                </winui:FlyleafHost.RenderTransform>
            </winui:FlyleafHost>
            <StackPanel Name="stkRecording" Visibility="Collapsed" Orientation="Horizontal" Spacing="5" VerticalAlignment="Top" Margin="10, 10">
                <Image Width="15" Source="/Assets/recordicon.png"></Image>

                <TextBlock Text="SCREEN RECORDING" Margin="0, 10" FontWeight="Bold" Style="{StaticResource BodyTextBlockStyle}" Foreground="Crimson"></TextBlock>
                <TextBlock Text="00:00:00" Margin="0, 10" Name="txtRecordingTimeFrame"></TextBlock>
                <Button Content="Stop Recording" Margin="10, 0" Style="{StaticResource AccentButtonStyle}" Name="btnStopRecording" Click="btnStopRecording_Click"></Button>
            </StackPanel>
            <Rectangle x:Name="RecFrame"  Visibility="Collapsed" Stroke="Cyan"  StrokeThickness="2"  RadiusX="8" RadiusY="8"
StrokeDashArray="3,1.5"
Opacity="0"
IsHitTestVisible="False"
HorizontalAlignment="Stretch" 
VerticalAlignment="Stretch"
Margin="2"/>
            <Grid Name="grdInfo" Visibility="Visible" Opacity="0" Margin="20, 40, 0, 0">

                <Border  Padding="5" VerticalAlignment="Top"     HorizontalAlignment="Left" Opacity="1"  Name="brdInformation"
BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
BorderThickness="1" 
CornerRadius="16" >
                    <Border.Background>
                        <media:AcrylicBrush BlurAmount="15"
                                        TintColor="Black"
                                        TintOpacity=".6" />
                    </Border.Background>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                        </Grid.RowDefinitions>
                        <Button Click="btnCloseInformation_Click" Name="btnCloseInformation" HorizontalAlignment="Right" Background="Transparent" BorderBrush="Transparent" ToolTipService.ToolTip="Close" Grid.Row="0">
                            <Image Width="20" Source="/Assets/removeicon.png"></Image>
                        </Button>
                        <TextBlock Grid.Row="1" Text="" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="1" x:Name="txtInformation" Style="{StaticResource TitleTextBlockStyle}" ></TextBlock>
                    </Grid>
                </Border>

            </Grid>
            <Grid MaxHeight="500" Visibility="Visible" Opacity="0" Margin="20, 10" Name="grdShowInfo" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Border CornerRadius="20">
                    <Border.Background>
                        <media:AcrylicBrush BlurAmount="15"
                     TintColor="Black"
                     TintOpacity=".6" />
                    </Border.Background>
                    <Grid RowSpacing="20" Margin="20, 10" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition MaxHeight="300" />

                        </Grid.RowDefinitions>
                        <TextBlock Text="Title" Name="txtShowTitle" Grid.Row="0" Style="{StaticResource TitleLargeTextBlockStyle}"></TextBlock>


                        <Button Click="btnCloseShowInfo_Click" Name="btnCloseShowInfo" HorizontalAlignment="Right" Background="Transparent" BorderBrush="Transparent" ToolTipService.ToolTip="Close" Grid.Row="0">
                            <Image Width="20" Source="/Assets/removeicon.png"></Image>
                        </Button>
                        <StackPanel Grid.Row="1" Orientation="Vertical" Spacing="20">
                            <TextBlock Text="• 0 Seasons" Name="txtShowSeasonCount" Style="{StaticResource BodyLargeStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"></TextBlock>
                            <TextBlock Text="• Released on " Name="txtShowReleaseDate" Style="{StaticResource BodyLargeStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"></TextBlock>

                        </StackPanel>
                        <MenuFlyoutSeparator Grid.Row="2"/>
                        <TextBlock Text="Episodes" Grid.Row="3" Style="{StaticResource TitleTextBlockStyle}"></TextBlock>
                        <SelectorBar SelectionChanged="selbarSeasons_SelectionChanged" Name="selbarSeasons" Grid.Row="4">
                            <SelectorBar.Items>
                                <SelectorBarItem Text="Season 1"></SelectorBarItem>
                                <SelectorBarItem Text="Season 2"></SelectorBarItem>
                            </SelectorBar.Items>
                        </SelectorBar>
                        <TextBlock Name="txtSeasonEpisodeCount" Text="Loading episodes..." Grid.Row="5" Style="{StaticResource BodyLargeStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"></TextBlock>
                        <Grid Visibility="Collapsed" HorizontalAlignment="Center" Grid.Row="6" Name="grdNoEpisodes" RowSpacing="20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"></RowDefinition>
                                <RowDefinition Height="Auto"></RowDefinition>
                            </Grid.RowDefinitions>
                            <Image Source="/Assets/appicon.png" Width="30" Grid.Row="0"></Image>
                            <TextBlock Text="No episodes in this season!" Name="txtNoEpisodes" Grid.Row="1"></TextBlock>
                        </Grid>
                        <ListView Name="lstViewEpisodes" Grid.Row="6">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0, 10" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition></ColumnDefinition>
                                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0" RowSpacing="10">
                                            <Grid.ContextFlyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem Text="Play">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="d"></FontIcon>
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="File Info" >
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="d"></FontIcon>
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </Grid.ContextFlyout>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>

                                            </Grid.RowDefinitions>
                                            <Viewbox MaxWidth="150" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal" Grid.Row="0" Spacing="20">
                                                    <Button ToolTipService.ToolTip="Play" CornerRadius="60" Width="40" Height="40" Style="{StaticResource AccentButtonStyle}">
                                                        <FontIcon Glyph="d"></FontIcon>
                                                    </Button>

                                                    <TextBlock ToolTipService.ToolTip="{Binding EpisodeName}"  Style="{StaticResource SubtitleTextBlockStyle}" Text="{Binding EpisodeName}"></TextBlock>

                                                </StackPanel>
                                            </Viewbox>
                                            <TextBlock MaxWidth="100"  TextWrapping="Wrap" Text="{Binding Description}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Grid.Row="1"></TextBlock>
                                            <StackPanel Orientation="Horizontal" Spacing="10" Grid.Row="2">
                                                <Button ToolTipService.ToolTip="File Info" Background="Transparent" Grid.Row="3" Padding="0" BorderBrush="Transparent" >
                                                    <Image Source="/Assets/infoicon.png" Width="15" ></Image>
                                                </Button>
                                                <TextBlock Text="{Binding Duration}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Grid.Row="2"></TextBlock>

                                            </StackPanel>

                                        </Grid>
                                        <Viewbox Grid.Column="1" MaxWidth="180" MaxHeight="80">
                                            <Border CornerRadius="300" BorderThickness="0" BorderBrush="White" Opacity="0.9 ">
                                                <Border.Shadow>
                                                    <ThemeShadow />
                                                </Border.Shadow>
                                                <Image Source="{Binding Thumbnail}" Stretch="Uniform"></Image>
                                            </Border>
                                        </Viewbox>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                    </Grid>
                </Border>
            </Grid>

            <TextBlock Grid.Row="0" Margin="10, 0"  VerticalAlignment="Center" HorizontalAlignment="Right" Visibility="Visible" Opacity="0" x:Name="txtSeek" Style="{StaticResource DisplayTextBlockStyle}" ></TextBlock>

            <Grid Grid.Row="0" Name="grdPlayback" Opacity="1">
                <Grid.RowDefinitions>
                    <RowDefinition ></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Margin="0, 0" VerticalAlignment="Bottom" HorizontalAlignment="Center" Opacity="1" x:Name="txtSubtitle" Style="{StaticResource TitleTextBlockStyle}" ></TextBlock>
                <Grid Grid.Row="1" Name="grdRootPlayback" VerticalAlignment="Bottom">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition ></ColumnDefinition>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                        <ColumnDefinition ></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Grid  Margin="0, 10" Grid.Column="1" Background="Transparent" HorizontalAlignment="Center" Name="grdUnpinnedControls">

                        <Grid.Resources>
                            <Storyboard x:Name="NeonPulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation 
           Storyboard.TargetName="NeonGlow" 
           Storyboard.TargetProperty="Opacity" 
           From="0" To="0.9" Duration="0:0:1"/>
                            </Storyboard>
                        </Grid.Resources>
                        <Border Visibility="{x:Bind Glow.GlowEffectVisibility, Mode=OneWay}"       Margin="0,0,0,20" Grid.Column="1" CornerRadius="24" BorderThickness="1" Name="GlowSurround" Background="Transparent">
                            <ui:Effects.Shadow>
                                <ui:AttachedDropShadow 
x:Name="NeonGlow"
Color="{x:Bind Glow.GlowColor, Mode=OneWay}" 
BlurRadius="30" 
                            CastTo="{x:Bind GlowSurround}"
Opacity="0.9" 
Offset="0,0,0">
                                </ui:AttachedDropShadow>
                            </ui:Effects.Shadow>
                        </Border>
                        <Border x:Name="GlassRoot" Grid.Column="1"
        HorizontalAlignment="Center" 
        VerticalAlignment="Bottom"
        Margin="0,0,0,20"
        CornerRadius="24"
        BorderThickness="0"
        IsHitTestVisible="True">

                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#66FFFFFF" Offset="0.0" />
                                    <GradientStop Color="#11FFFFFF" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.BorderBrush>

                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#CC1A1A1A" Offset="0.0" />
                                    <GradientStop Color="#E60A0A0A" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>

                            <Grid Margin="20" HorizontalAlignment="Stretch">
                                <StackPanel Name="ControlsOverlay" Width="650" Padding="20,0,20,0">
                                    <Grid HorizontalAlignment="Stretch" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Button HorizontalAlignment="Left" Grid.Column="0" ToolTipService.ToolTip="Add to Favourites" Padding="3" Margin="0, 0" x:Name="btnFavourite" 
Click="btnFavourite_Click"
Background="Transparent" 
BorderThickness="0"
                                            >
                                            <Grid>
                                                <FontIcon x:Name="HeartIcon" FontSize="16" RenderTransformOrigin="0.5,0.5" Glyph="&#xEB51;" 
  >
                                                    <FontIcon.RenderTransform>
                                                        <ScaleTransform x:Name="HeartScale" ScaleX="1" ScaleY="1"/>
                                                    </FontIcon.RenderTransform>
                                                </FontIcon>
                                            </Grid>
                                        </Button>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">

                                            <Button Content="Next Episode" Background="Transparent" Name="btnNextEpisode" Click="btnNextEpisode_Click" Visibility="Collapsed"></Button>
                                            <Button Click="btnPin_Click" Visibility="Visible" Background="Transparent" Padding="6" ToolTipService.ToolTip="Pin this panel" HorizontalAlignment="Right" Name="btnPin" >
                                                <FontIcon FontSize="14" Glyph="&#xE718;" Name="fntPin"></FontIcon>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    <playbackviews:PlaybackMainControls FileNameTextVisibility="Collapsed" x:Name="playbackMainControls"></playbackviews:PlaybackMainControls>
                                    <playbackviews:VideoControls x:Name="videoControls" FullScreenToggled="videoControls_FullScreenToggled"  ViewEpisodeClick="videoControls_ViewEpisodeClick"/>

                                </StackPanel>
                            </Grid>
                        </Border>

                    </Grid>
                    <TextBlock Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20, 0" Name="txtPinFileName" TextWrapping="Wrap"  Text="{x:Bind mediacontroller.MediaDisplayName,Mode=OneWay}"  Visibility="Collapsed" Style="{StaticResource BodyLargeStrongTextBlockStyle}"></TextBlock>
                    <Button Grid.Column="2" Visibility="Collapsed" Margin="20, 0" Background="Transparent" Padding="2" ToolTipService.ToolTip="Unpin this panel" HorizontalAlignment="Right" Name="btnPin2" Click="btnPin_Click" >
                        <FontIcon FontSize="25" Glyph="&#xE718;" Name="fntPin2"></FontIcon>
                    </Button>
                </Grid>
            </Grid>

        </Grid>
        <Button ToolTipService.ToolTip="Go Back" Name="btnBack" Click="btnBack_Click" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Image Width="20" Source="/Assets/appicon.png"/>
        </Button>
    </Grid>

</Page>
