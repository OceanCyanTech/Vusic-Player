<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Vusic_Player.UI.UserViews.PictureInPicture"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Vusic_Player.UI.UserViews"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:oceancyan="using:Vusic_Player.UI.UserViews.Controls" xmlns:winui="using:FlyleafLib.Controls.WinUI"
    mc:Ignorable="d"
    Title="PictureInPicture">

    <Grid PointerEntered="Grid_PointerEntered" Name="rootGrid" PointerMoved="Grid_PointerMoved">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition ></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
            </Grid.RowDefinitions>

            <winui:FlyleafHost RenderTransformOrigin="0.5, 0.5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Row="0" x:Name="hostMedia">
                <winui:FlyleafHost.RenderTransform>
                    <RotateTransform x:Name="mediaRotation" 
                />
                </winui:FlyleafHost.RenderTransform>
            </winui:FlyleafHost>
            <Image Source="{x:Bind mediacontroller.CoverThumbnail, Mode=OneWay}" Width="220" Name="imgCover" Grid.Row="0" Visibility="Collapsed"/>
            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  VerticalAlignment="Bottom" Visibility="Collapsed" Name="txtTitle" Text="{x:Bind mediacontroller.MediaDisplayName, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center" Margin="20, 20"/>
            <oceancyan:OceanSlider x:Name="sldMain" DragStarted="sldMain_DragStarted" DragCompleted="sldMain_DragCompleted" Grid.Row="1" Value="{x:Bind mediacontroller.CurrentPosition, Mode=TwoWay}" Maximum="{x:Bind mediacontroller.TotalDuration, Mode=TwoWay}" IsThumbVisible="Collapsed" VerticalAlignment="Bottom"></oceancyan:OceanSlider>
            <Grid x:Name="CustomTitleBar" 
          Background="Transparent" 
          VerticalAlignment="Stretch">

                <Grid Name="grdOverlay" Background="#99000000" Opacity="0">

                    <Grid.Resources>
                        <Storyboard x:Name="FadeInOutStoryboard">
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="grdOverlay"
                           Storyboard.TargetProperty="Opacity">
                                <LinearDoubleKeyFrame KeyTime="0:0:0.05" Value="1.0" />

                                <LinearDoubleKeyFrame KeyTime="0:0:0.90" Value="1.0" />

                                <LinearDoubleKeyFrame KeyTime="0:0:1.00" Value="0.0" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </Grid.Resources>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" VerticalAlignment="Center" >
                        <Button BorderBrush="Transparent"  Background="Transparent" CornerRadius="20" ToolTipService.ToolTip="Play">
                            <Image Source="{Binding Previous, Source={StaticResource GlobalIconHolder}}" Width="26"></Image>
                        </Button>
                        <Button Name="btnPlayPause" Click="btnPlayPause_Click"  CornerRadius="20" ToolTipService.ToolTip="{x:Bind mediacontroller.PlayPauseToolTip, Mode=OneWay}" Background="Transparent" BorderBrush="Transparent">
                            <Image Name="imgPlayPause" Source="{x:Bind mediacontroller.Thumbnail, Mode=OneWay}" Width="26"  />
                        </Button>
                        <Button BorderBrush="Transparent"   Background="Transparent" CornerRadius="20" ToolTipService.ToolTip="Play">
                            <Image Source="{Binding Next, Source={StaticResource GlobalIconHolder}}" Width="26"></Image>
                        </Button>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" BorderBrush="Transparent"   Background="Transparent" Name="btnOptions" CornerRadius="16" ToolTipService.ToolTip="Restore" >
                        <Button.Flyout>
                            <MenuFlyout Opened="MenuFlyout_Opened">
                                <MenuFlyoutItem FontFamily="{StaticResource GlobalFontHolder}"  x:Name="mnftOpenVideo" Text="Open Another Media" Click="mnftOpenVideo_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE838;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                                <MenuFlyoutItem FontFamily="{StaticResource GlobalFontHolder}"  x:Name="mnftVolume" Text="Volume" Click="mnftVolume_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Name="fntIconVolume" Glyph="&#xE767;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem FontFamily="{StaticResource GlobalFontHolder}"  x:Name="mnftFileInfo" Text="File Info" Click="mnftFileInfo_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE946;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem FontFamily="{StaticResource GlobalFontHolder}"  x:Name="mnftOpenFileLocation" Text="Open File Location" Click="mnftOpenFileLocation_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE838;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />

                                <MenuFlyoutItem FontFamily="{StaticResource GlobalFontHolder}"  x:Name="mnftPrevious" Text="Previous" Click="mnftPrevious_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE892;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                                <MenuFlyoutItem FontFamily="{StaticResource GlobalFontHolder}"  x:Name="mnftSkipBack" Text="Skip back 10 secs" Click="mnftSkipBack_Click">
                                    <MenuFlyoutItem.Icon>
                                        <ImageIcon Source="{Binding SkipBack, Source= {StaticResource GlobalIconHolder}}"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                                <MenuFlyoutItem FontFamily="{StaticResource GlobalFontHolder}"  x:Name="mnftPlay" Text="{x:Bind mediacontroller.PlayPauseToolTip, Mode=OneWay}" Click="mnftPlay_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Name="fntIconPlay" Glyph="&#xE768;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                                <MenuFlyoutItem FontFamily="{StaticResource GlobalFontHolder}"  x:Name="mnftSkipForward" Text="Skip Forward 10 secs" Click="mnftSkipForward_Click">
                                    <MenuFlyoutItem.Icon>
                                        <ImageIcon Source="{Binding SkipAhead, Source= {StaticResource GlobalIconHolder}}"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                                <MenuFlyoutItem FontFamily="{StaticResource GlobalFontHolder}"  x:Name="mnftNext" Text="Next" Click="mnftNext_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE893;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem FontFamily="{StaticResource GlobalFontHolder}"  x:Name="mnftRestore" Text="Restore" Click="btnRestore_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE944;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>

                        <Image Source="{Binding Options, Source={StaticResource GlobalIconHolder}}" Width="26"></Image>
                    </Button>
                    <Button HorizontalAlignment="Left" VerticalAlignment="Bottom" BorderBrush="Transparent"   Background="Transparent" Name="btnRestore" CornerRadius="16" ToolTipService.ToolTip="Restore" Click="btnRestore_Click">
                        <Image Source="{Binding MiniPlayer, Source={StaticResource GlobalIconHolder}}" Width="26"></Image>
                    </Button>
                    <StackPanel Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Top" 
                    Margin="6">
                        <Button x:Name="CloseButton" 
        Content="&#xE8BB;" 
        Click="CloseButton_Click" 
        FontFamily="Segoe MDL2 Assets" 
        FontSize="12"
                                ToolTipService.ToolTip="Close"
        Width="45" Height="32"
        Background="Transparent"
        BorderBrush="Transparent">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid x:Name="RootGrid" Background="{TemplateBinding Background}" CornerRadius="4">
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="CommonStates">

                                                <VisualState x:Name="Normal">
                                                    <Storyboard>
                                                        <ColorAnimation Storyboard.TargetName="RootGrid" 
                                Storyboard.TargetProperty="(Grid.Background).(SolidColorBrush.Color)" 
                                To="Transparent" Duration="0:0:0.3"/>
                                                        <ColorAnimation Storyboard.TargetName="Content" 
                                Storyboard.TargetProperty="(ContentPresenter.Foreground).(SolidColorBrush.Color)" 
                                To="White" Duration="0:0:0.3"/>
                                                    </Storyboard>
                                                </VisualState>

                                                <VisualState x:Name="PointerOver">
                                                    <Storyboard>
                                                        <ColorAnimation Storyboard.TargetName="RootGrid" 
                                Storyboard.TargetProperty="(Grid.Background).(SolidColorBrush.Color)" 
                                To="#E81123" Duration="0:0:0.1"/>
                                                        <ColorAnimation Storyboard.TargetName="Content" 
                                Storyboard.TargetProperty="(ContentPresenter.Foreground).(SolidColorBrush.Color)" 
                                To="White" Duration="0:0:0.1"/>
                                                    </Storyboard>
                                                </VisualState>

                                                <VisualState x:Name="Pressed">
                                                    <Storyboard>
                                                        <ColorAnimation Storyboard.TargetName="RootGrid" 
                                Storyboard.TargetProperty="(Grid.Background).(SolidColorBrush.Color)" 
                                To="Crimson" Duration="0"/>
                                                    </Storyboard>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                        <ContentPresenter x:Name="Content"
                                  Content="{TemplateBinding Content}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                                    </Grid>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                    <TeachingTip FontFamily="{StaticResource GlobalFontHolder}"  Name="ttVolume" PreferredPlacement="Center" Title="Volume">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Name="volStackPanel" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                                <oceancyan:OceanSlider x:Name="sldVol" IsTooltipEnabled="False" Margin="10, 0" IsEnabled="True" ValueChanged="sldVol_ValueChanged" Maximum="{x:Bind mediacontroller.MaximumVolume, Mode=OneWay}" Value="100" Width="200">
                                    <ToolTipService.ToolTip>
                                        <ToolTip Visibility="Visible" x:Name="VolumeToolTip" Content="{x:Bind mediacontroller.VolumeString, Mode=OneWay}" />
                                    </ToolTipService.ToolTip>
                                </oceancyan:OceanSlider>
                                <StackPanel Margin="0, 10" Orientation="Horizontal" >
                                    <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  FontSize="12" Foreground="White" Name="txtVolumepercent" />
                                    <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  FontSize="12" Text="{x:Bind mediacontroller.VolumeString, Mode=OneWay}" Foreground="Cyan"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                    </TeachingTip>

                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
