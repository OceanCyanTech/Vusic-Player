<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Vusic_Player.UI.UserViews.Grids.Favourites"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Vusic_Player.UI.UserViews.Grids"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vusic_player="using:Vusic_Player.UI.UserViews.Controls" xmlns:ani="using:CommunityToolkit.WinUI.Animations"
    mc:Ignorable="d">

    <Grid ColumnSpacing="30" Margin="0, 10" HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>

        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Visibility="Collapsed" Margin="15, 0" Name="grdRecents">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="20">
                <CheckBox Content="Select" Grid.Row="1" Margin="0, 5" Name="chkSelect" Checked="chkSelect_Checked" Unchecked="chkSelect_Checked"></CheckBox>
                <StackPanel Name="selectMoreOptions" Visibility="Collapsed" Margin="0, 5" Orientation="Horizontal">
                    <CheckBox Content="Select all" Tag="Selectallcontinuewatch" Name="chckSelectAllContinuePlaying" Visibility="Visible" Checked="chckSelectAllContinuePlaying_Checked" Unchecked="chckSelectAllContinuePlaying_Checked"></CheckBox>
                    <Button ToolTipService.ToolTip="Remove from Recents" Background="Transparent" BorderBrush="Transparent" Visibility="Visible" Margin="0, 0"  Click="btnRemove_Click"  Name="btnRemove" >
                        <StackPanel Orientation="Horizontal">
                            <Image Width="20" Source="/Assets/removeicon.png"></Image>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
            <Button Grid.Row="1" Name="btnPlayAll" Click="btnPlayAll_Click" CornerRadius="12" >
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Image Width="20" Source="/Assets/play.png"/>
                    <TextBlock Text="Play all"/>
                </StackPanel>
            </Button>
            <GridView Grid.Row="2" Visibility="Visible"  VerticalAlignment="Stretch"
 x:Name="grdvFavourites" SelectionMode="Single" IsItemClickEnabled="True" ItemsSource="{x:Bind FinalList, Mode=OneWay}"
ItemClick="grdvFavourites_ItemClick"  Margin="0, 20" >
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="150" Height="150" 
                  CornerRadius="6"
                    ToolTipService.ToolTip="{Binding FileName}">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Play" Click="mnftPlay_Click" Name="mnftPlay">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8DA;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Remove from Favourites" Click="mnftRemoveFromFav_Click" Name="mnftRemoveFromFav" Icon="Remove" />
                                    <MenuFlyoutItem Text="Go to File Location" Click="mnftGoToFileLocation_Click" >
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8DA;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Add to Queue" Click="mnftAddtoQueue_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8DA;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="View File Info" Click="mnftViewFileInfo_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE946;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Grid.ContextFlyout>

                            <!-- Thumbnail Image -->
                            <Border CornerRadius="6">
                                <Image Source="{Binding Thumbnail}" 
                       Width="150" 
                                       MaxHeight="90"
                       Stretch="Uniform" 
                       HorizontalAlignment="Center" />
                            </Border>

                            <!-- Text Block with 2-line wrap + ellipsis -->
                            <TextBlock Text="{Binding FileName}" 
                       TextWrapping="Wrap" 
                       MaxLines="2" Grid.Row="1"
                       TextTrimming="CharacterEllipsis"
                       TextAlignment="Center"
                       HorizontalAlignment="Stretch" />
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

        </Grid>
        <Grid Name="grdEmptySuggestions" HorizontalAlignment="Center" Grid.Column="0" Visibility="Visible" >
            <StackPanel Orientation="Vertical" Spacing="15">
                <StackPanel Orientation="Vertical" Spacing="20">
                    <Image Width="90" Source="/Assets/favicon.png"></Image>
                    <TextBlock HorizontalAlignment="Center" TextWrapping="Wrap" Text="Heart media to show them here!" Style="{StaticResource SubtitleTextBlockStyle}"></TextBlock>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>

</UserControl>
