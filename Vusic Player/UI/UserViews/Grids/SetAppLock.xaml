<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Vusic_Player.UI.UserViews.Grids.SetAppLock"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Vusic_Player.UI.UserViews.Grids"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:authentication="using:Vusic_Player.UI.UserViews.Authentication"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Storyboard x:Name="ShakeStoryboard">
            <DoubleAnimationUsingKeyFrames 
            Storyboard.TargetName="ShakeTransform"
            Storyboard.TargetProperty="X">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.05" Value="-12" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.10" Value="10" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.15" Value="-8" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.20" Value="6" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.25" Value="-3" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.30" Value="0" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </UserControl.Resources>
    <Grid>
        <Grid Name="grdWinAuth" Visibility="Collapsed" Margin="0,20" HorizontalAlignment="Center" VerticalAlignment="Center" RowSpacing="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock HorizontalAlignment="Center" Text="Windows Authentication has been set!" Style="{StaticResource TitleTextBlockStyle}"/>
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="10" Grid.Row="1">
                <Button Name="btnRemoveAuthentication" Click="btnRemoveAuthentication_Click" Content="Remove Windows Authentication"/>
            </StackPanel>
        </Grid>
        <Grid Name="grdDashboard" Visibility="Collapsed"  Margin="0,20" HorizontalAlignment="Center" VerticalAlignment="Center" RowSpacing="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock HorizontalAlignment="Center" Text="What do you want to do?" Style="{StaticResource TitleTextBlockStyle}"/>
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="10" Grid.Row="1">
                <Button Style="{StaticResource AccentButtonStyle}" Content="Change Current PIN" Name="btnChangeCurrentPin" Click="btnChangeCurrentPin_Click"  Background="{StaticResource GlobalAccentColor}" >
                    <Button.Resources>
                        <SolidColorBrush x:Key="AccentButtonBackground" Color="{StaticResource GlobalAccentColor}"/>
                        <SolidColorBrush x:Key="AccentButtonForeground" Color="#0B0D13"/>
                        <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent"/>

                        <!-- Pointer Over (Hover) -->
                        <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{StaticResource GlobalAccentColorPointerOver}"/>
                        <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#0B0D13"/>
                        <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="Transparent"/>

                        <!-- Pressed State -->
                        <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                        <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="Transparent"/>

                        <!-- Disabled State -->
                        <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#2A2A2A"/>
                        <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#707070"/>
                        <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="Transparent"/>
                    </Button.Resources>
                </Button>
                <Button Style="{StaticResource AccentButtonStyle}"  Content="Remove PIN" Name="btnRemoveCurrentPin" Click="btnRemoveCurrentPin_Click"  Background="{StaticResource GlobalAccentColor}" >
                    <Button.Resources>
                        <SolidColorBrush x:Key="AccentButtonBackground" Color="{StaticResource GlobalAccentColor}"/>
                        <SolidColorBrush x:Key="AccentButtonForeground" Color="#0B0D13"/>
                        <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent"/>

                        <!-- Pointer Over (Hover) -->
                        <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{StaticResource GlobalAccentColorPointerOver}"/>
                        <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#0B0D13"/>
                        <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="Transparent"/>

                        <!-- Pressed State -->
                        <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                        <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="Transparent"/>

                        <!-- Disabled State -->
                        <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#2A2A2A"/>
                        <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#707070"/>
                        <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="Transparent"/>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
        <Grid Name="grdVerify" Visibility="Collapsed"  Margin="0,20" HorizontalAlignment="Center" VerticalAlignment="Center" RowSpacing="30">
            <authentication:AppAuthVerify x:Name="AppAuthVer"/>
        </Grid>
        <Grid Name="grdRemove" Visibility="Collapsed" Margin="0, 20" HorizontalAlignment="Center" VerticalAlignment="Center" RowSpacing="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Are you sure you want to remove the set PIN?" Style="{StaticResource BodyLargeStrongTextBlockStyle}"/>
            <StackPanel Orientation="Horizontal" Spacing="10" Grid.Row="1">
             
                <Button Content="Yes" Name="btnYes" Click="btnYes_Click"/>
                <Button Content="No" Name="btnNo" Click="btnNo_Click"/>
            </StackPanel>
        </Grid>
        <Grid Name="grdSuccess" Visibility="Collapsed" Margin="0, 20" HorizontalAlignment="Center" VerticalAlignment="Center" RowSpacing="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Style="{StaticResource BodyLargeStrongTextBlockStyle}" Text="PIN has been successfully set."/>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="30" HorizontalAlignment="Center">

                <Button Content="Remove PIN" Click="btnRemovePassword_Click" Name="btnRemovePassword"/>
                <Button Content="Change PIN" Click="btnChangePassword_Click" Name="btnChangePassword"/>
                <Button Content="Done" Click="btnDone_Click" Name="btnDone"/>
            </StackPanel>
        </Grid>
        <Grid Name="grdConfirmation" Visibility="Collapsed" Margin="0, 20" HorizontalAlignment="Center" VerticalAlignment="Center" RowSpacing="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Style="{StaticResource BodyLargeStrongTextBlockStyle}" Text="If you forget the pin, all the app settings will be reset to default. Are you sure you want to proceed?"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="30" HorizontalAlignment="Center">

                <Button Content="Go Back" Click="btnGoBack_Click" Name="btnGoBack"/>
                <Button Content="Proceed" Click="btnProceed_Click" Name="btnProceed" Style="{StaticResource AccentButtonStyle}" Background="{StaticResource GlobalAccentColor}" >
                    <Button.Resources>
                        <SolidColorBrush x:Key="AccentButtonBackground" Color="{StaticResource GlobalAccentColor}"/>
                        <SolidColorBrush x:Key="AccentButtonForeground" Color="#0B0D13"/>
                        <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent"/>

                        <!-- Pointer Over (Hover) -->
                        <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{StaticResource GlobalAccentColorPointerOver}"/>
                        <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#0B0D13"/>
                        <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="Transparent"/>

                        <!-- Pressed State -->
                        <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                        <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="Transparent"/>

                        <!-- Disabled State -->
                        <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#2A2A2A"/>
                        <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#707070"/>
                        <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="Transparent"/>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
        <Grid RowSpacing="30" Margin="0, 20" Name="grdMain" PreviewKeyDown="Grid_PreviewKeyDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource BodyLargeStrongTextBlockStyle}" Text="Set a 4 or 6-digit pin as app lock. Start typing your pin."/>
            <TextBlock Grid.Row="1" Style="{StaticResource BodyLargeStrongTextBlockStyle}" Text="If you forget the pin, all the app settings will be reset to default."/>
            <CheckBox Name="chkIsSixDigit" Content="6-Digit Pin" Grid.Row="2" Checked="chkIsSixDigit_Checked" Unchecked="chkIsSixDigit_Checked">
                <CheckBox.Resources>
                    <!-- Checked State (Background box fill) -->
                    <SolidColorBrush x:Key="CheckBoxFillColorDefault" Color="{StaticResource GlobalAccentColor}"/>
                    <SolidColorBrush x:Key="CheckBoxFillColorPointerOver" Color="{StaticResource GlobalAccentColorPointerOver}"/>
                    <SolidColorBrush x:Key="CheckBoxFillColorPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                    <SolidColorBrush x:Key="CheckBoxFillColorDisabled" Color="#2A2A2A"/>

                    <!-- Checkmark Glyph Color (The tick mark inside the box) -->
                    <SolidColorBrush x:Key="CheckBoxCheckGlyphForeground" Color="#000000"/>
                    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundPointerOver" Color="#000000"/>
                    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundPressed" Color="#000000"/>
                    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundDisabled" Color="#707070"/>

                    <!-- Unchecked State (Empty box outline border) -->
                    <SolidColorBrush x:Key="CheckBoxStrokeColorDefault" Color="#808080"/>
                    <SolidColorBrush x:Key="CheckBoxStrokeColorPointerOver" Color="#B0B0B0"/>
                    <SolidColorBrush x:Key="CheckBoxStrokeColorPressed" Color="#606060"/>

                    <!-- Text Label Foreground -->
                    <SolidColorBrush x:Key="CheckBoxForeground" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="CheckBoxForegroundPointerOver" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="CheckBoxForegroundPressed" Color="#CCCCCC"/>
                </CheckBox.Resources>
            </CheckBox>

