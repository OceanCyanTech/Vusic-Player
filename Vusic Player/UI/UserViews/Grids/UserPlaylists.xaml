<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Vusic_Player.UI.UserViews.Grids.UserPlaylists"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Vusic_Player.UI.UserViews.Grids"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:ani="using:CommunityToolkit.WinUI.Animations" xmlns:oceandialogcontrols="using:Vusic_Player.UI.UserViews.Controls.OceanDialogControls"
    mc:Ignorable="d">
    <UserControl.Resources>
        <local:CountToVisibility x:Key="CountToEmpty"/>
        <local:CountToVisibilityReverse x:Key="CountToGridView"/>
    </UserControl.Resources>
    <Grid ColumnSpacing="30" Margin="0, 30" HorizontalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1"  Visibility="{x:Bind Instance.PlaylistsMaster.Count, Converter={StaticResource CountToGridView}, Mode=OneWay}"  Name="grdRecents" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="20">
                <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Text="Playlists" Grid.Row="0" Style="{StaticResource SubtitleTextBlockStyle}"/>
                <CheckBox FontFamily="{StaticResource GlobalFontHolder}"  Content="Select" Grid.Row="1" Margin="0, 0" Name="chkSelect" Checked="chkSelect_Toggled" Unchecked="chkSelect_Toggled">
                    <CheckBox.Resources>
                        <!-- Checked State (Background box fill) -->
                        <SolidColorBrush x:Key="CheckBoxFillColorDefault" Color="{StaticResource GlobalAccentColor}"/>
                        <SolidColorBrush x:Key="CheckBoxFillColorPointerOver" Color="{StaticResource GlobalAccentColorPointerOver}"/>
                        <SolidColorBrush x:Key="CheckBoxFillColorPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                        <SolidColorBrush x:Key="CheckBoxFillColorDisabled" Color="#2A2A2A"/>

                        <!-- Checkmark Glyph Color (The tick mark inside the box) -->
                        <SolidColorBrush x:Key="CheckBoxCheckGlyphForeground" Color="#000000"/>
                        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundPointerOver" Color="#000000"/>
                        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundPressed" Color="#000000"/>
                        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundDisabled" Color="#707070"/>

                        <!-- Unchecked State (Empty box outline border) -->
                        <SolidColorBrush x:Key="CheckBoxStrokeColorDefault" Color="#808080"/>
                        <SolidColorBrush x:Key="CheckBoxStrokeColorPointerOver" Color="#B0B0B0"/>
                        <SolidColorBrush x:Key="CheckBoxStrokeColorPressed" Color="#606060"/>

                        <!-- Text Label Foreground -->
                        <SolidColorBrush x:Key="CheckBoxForeground" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="CheckBoxForegroundPointerOver" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="CheckBoxForegroundPressed" Color="#CCCCCC"/>
                    </CheckBox.Resources>
                </CheckBox>

                <StackPanel Name="selectMoreOptions" Visibility="Collapsed" Margin="0, 5" Orientation="Horizontal">
                    <CheckBox FontFamily="{StaticResource GlobalFontHolder}"  Content="Select all" Tag="Selectallcontinuewatch" Name="chckSelectAll" Visibility="Visible" Checked="chckSelectAllContinuePlaying_Checked" Unchecked="chckSelectAllContinuePlaying_Checked">
                        <CheckBox.Resources>
                            <!-- Checked State (Background box fill) -->
                            <SolidColorBrush x:Key="CheckBoxFillColorDefault" Color="{StaticResource GlobalAccentColor}"/>
                            <SolidColorBrush x:Key="CheckBoxFillColorPointerOver" Color="{StaticResource GlobalAccentColorPointerOver}"/>
                            <SolidColorBrush x:Key="CheckBoxFillColorPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                            <SolidColorBrush x:Key="CheckBoxFillColorDisabled" Color="#2A2A2A"/>

                            <!-- Checkmark Glyph Color (The tick mark inside the box) -->
                            <SolidColorBrush x:Key="CheckBoxCheckGlyphForeground" Color="#000000"/>
                            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundPointerOver" Color="#000000"/>
                            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundPressed" Color="#000000"/>
                            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundDisabled" Color="#707070"/>

                            <!-- Unchecked State (Empty box outline border) -->
                            <SolidColorBrush x:Key="CheckBoxStrokeColorDefault" Color="#808080"/>
                            <SolidColorBrush x:Key="CheckBoxStrokeColorPointerOver" Color="#B0B0B0"/>
                            <SolidColorBrush x:Key="CheckBoxStrokeColorPressed" Color="#606060"/>

                            <!-- Text Label Foreground -->
                            <SolidColorBrush x:Key="CheckBoxForeground" Color="#FFFFFF"/>
                            <SolidColorBrush x:Key="CheckBoxForegroundPointerOver" Color="#FFFFFF"/>
                            <SolidColorBrush x:Key="CheckBoxForegroundPressed" Color="#CCCCCC"/>
                        </CheckBox.Resources>
                    </CheckBox>

                    <Button ToolTipService.ToolTip="Delete Playlists" Background="Transparent" BorderBrush="Transparent" Visibility="Visible" Margin="0, 0"  Click="btnRemoveMultiplePlaylists_Click"  Name="btnRemoveMultiplePlaylists" >
                        <StackPanel Orientation="Horizontal">
                            <Image Width="20" Source="{Binding Removeicon, Source={StaticResource GlobalIconHolder}}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
            <GridView Grid.Row="1" Visibility="Visible"  VerticalAlignment="Stretch"  ItemsSource="{x:Bind Instance.PlaylistsMaster, Mode=OneWay}"
 x:Name="grdViewPlaylists" SelectionMode="Single" IsItemClickEnabled="True" CanDragItems="True" AllowDrop="True" CanReorderItems="True"
ItemClick="grdViewPlaylists_ItemClick"  Margin="0, 20" >
                <GridView.ItemTemplate>
                    <DataTemplate >
                        <StackPanel ToolTipService.ToolTip="{Binding PlaylistName}" Orientation="Vertical">
                            <ani:Implicit.Animations>
                                <ani:ImplicitAnimationSet>
                                    <ani:ScaleAnimation Duration="0:0:0.2" />
                                </ani:ImplicitAnimationSet>
                            </ani:Implicit.Animations>
                            <StackPanel  VerticalAlignment="Stretch">
                                <StackPanel.ContextFlyout>
                                    <MenuFlyout Opened="MenuFlyout_Opened">
                                        <MenuFlyoutItem FontFamily="{StaticResource GlobalFontHolder}"  Name="mnftOpenPlaylist" Click="mnftOpenPlaylist_Click" Text="Open Playlist">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8A7;"></FontIcon>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator/>
                                        <MenuFlyoutItem FontFamily="{StaticResource GlobalFontHolder}"  Name="mnftPlayAll" Click="mnftPlayAll_Click" Text="Play all">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE768;"></FontIcon>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem FontFamily="{StaticResource GlobalFontHolder}"  Name="mnftAddtoQueue" Click="mnftAddtoQueue_Click" Text="Add to Queue">
                                            <MenuFlyoutItem.Icon>
                                                <ImageIcon  Width="20"   Source="/Assets/addtoqueuefonticon.png"/>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem FontFamily="{StaticResource GlobalFontHolder}"  Name="mnftShufflePlay" Click="mnftShufflePlay_Click" Text="Shuffle and Play">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8B1;"></FontIcon>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem FontFamily="{StaticResource GlobalFontHolder}"  Name="mnftEditPlaylist" Click="mnftEditPlaylist_Click" Text="Edit Playlist">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE70F;"></FontIcon>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator/>
                                        <MenuFlyoutItem FontFamily="{StaticResource GlobalFontHolder}"  Name="mnftDeletePlaylist" Click="mnftDeletePlaylist_Click" Text="Delete Playlist">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE74D;"></FontIcon>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </StackPanel.ContextFlyout>

                                <Image Source="{Binding Thumbnail}" Width="150" Height="100" Stretch="UniformToFill"/>

                                <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Text="{Binding PlaylistName}" Visibility="Visible" TextWrapping="Wrap" />
                                <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding PlaylistCount}" Visibility="Visible" TextWrapping="Wrap" />
                                <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Text="{Binding PlaylistNowPlaying}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Visibility="Visible" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </Grid>
        <TeachingTip  FontFamily="{StaticResource GlobalFontHolder}"  Title="Edit Playlist" HorizontalContentAlignment="Stretch" Name="ttEditPlaylist" Target="{x:Bind grdViewPlaylists}">
            <TeachingTip.Resources>
                <x:Double x:Key="TeachingTipMinWidth">800</x:Double>
                <x:Double x:Key="TeachingTipMaxWidth">600</x:Double>
            </TeachingTip.Resources>
            <Grid >
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <oceandialogcontrols:NewPlaylistCreation x:Name="newPlaylistCreationEdit"/>
                <Grid ColumnSpacing="10" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button FontFamily="{StaticResource GlobalFontHolder}"  Name="btnSavePlaylistEdited" Content="Save" Style="{StaticResource AccentButtonStyle}" Background="{StaticResource GlobalAccentColor}" >
                        <Button.Resources>
                            <SolidColorBrush x:Key="AccentButtonBackground" Color="{StaticResource GlobalAccentColor}"/>
                            <SolidColorBrush x:Key="AccentButtonForeground" Color="#0B0D13"/>
                            <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent"/>

                            <!-- Pointer Over (Hover) -->
                            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{StaticResource GlobalAccentColorPointerOver}"/>
                            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#0B0D13"/>
                            <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="Transparent"/>

                            <!-- Pressed State -->
                            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF"/>
                            <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="Transparent"/>

                            <!-- Disabled State -->
                            <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#2A2A2A"/>
                            <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#707070"/>
                            <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="Transparent"/>
                        </Button.Resources>
                    </Button>
                    <Button FontFamily="{StaticResource GlobalFontHolder}"  Name="btnCancelEdit" Click="btnCancelEdit_Click" Content="Cancel" Grid.Column="1" Background="{StaticResource GlobalAccentColor}" >
                        <Button.Resources>
                            <SolidColorBrush x:Key="AccentButtonBackground" Color="{StaticResource GlobalAccentColor}"/>
                            <SolidColorBrush x:Key="AccentButtonForeground" Color="#0B0D13"/>
                            <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent"/>

                            <!-- Pointer Over (Hover) -->
                            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{StaticResource GlobalAccentColorPointerOver}"/>
                            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#0B0D13"/>
                            <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="Transparent"/>

                            <!-- Pressed State -->
                            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF"/>
                            <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="Transparent"/>

                            <!-- Disabled State -->
                            <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#2A2A2A"/>
                            <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#707070"/>
                            <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="Transparent"/>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Grid>
        </TeachingTip>

        <Grid HorizontalAlignment="Center" Name="grdEmptySuggestions"  Visibility="{x:Bind Instance.PlaylistsMaster.Count, Converter={StaticResource CountToEmpty}, Mode=OneWay}" Grid.Column="1">
            <StackPanel Orientation="Vertical" Spacing="15">
                <StackPanel Orientation="Vertical" Spacing="20">
                    <Image Width="90" Source="{Binding PlaylistIcon, Source={StaticResource GlobalIconHolder}}"></Image>
                    <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  HorizontalAlignment="Center" TextWrapping="Wrap" Text="You have no playlists created!" Style="{StaticResource SubtitleTextBlockStyle}"></TextBlock>
                </StackPanel>
                <Button Style="{StaticResource AccentButtonStyle}" Margin="0, 20" Name="btnNewPlaylist" HorizontalAlignment="Center" Click="btnNewPlaylist_Click"  Background="{StaticResource GlobalAccentColor}" >
                    <Button.Resources>
                        <SolidColorBrush x:Key="AccentButtonBackground" Color="{StaticResource GlobalAccentColor}"/>
                        <SolidColorBrush x:Key="AccentButtonForeground" Color="#0B0D13"/>
                        <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent"/>

                        <!-- Pointer Over (Hover) -->
                        <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{StaticResource GlobalAccentColorPointerOver}"/>
                        <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#0B0D13"/>
                        <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="Transparent"/>

                        <!-- Pressed State -->
                        <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                        <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="Transparent"/>

                        <!-- Disabled State -->
                        <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#2A2A2A"/>
                        <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#707070"/>
                        <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="Transparent"/>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{Binding AddIcon, Source={StaticResource GlobalIconHolder}}" Width="25"/>

                        <TextBlock Text="New Playlist" FontFamily="{StaticResource GlobalFontHolder}"  
 Margin="8,0,0,0" 
 VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>

</UserControl>
