<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Vusic_Player.UI.UserViews.Controls.MasterSearchControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Vusic_Player.UI.UserViews.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <TextBox Loaded="asbSearchOptions_Loaded" Grid.Row="0" Name="asbSearchOptions" PlaceholderText="Search for media across your library..." PreviewKeyDown="asbSearchOptions_PreviewKeyDown"
TextChanged="asbSearchOptions_TextChanged" GotFocus="asbSearchOptions_GotFocus" LostFocus="asbSearchOptions_LostFocus"/>
        <Button x:Name="btnSearchQuery"
            Click="btnSearchQuery_Click"
            Content="&#xE721;" Visibility="Visible"
            FontFamily="{ThemeResource SymbolThemeFontFamily}"
            Background="Transparent"
            BorderBrush="Transparent"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Width="40"
            Height="32"
            Margin="0,0,0,0"/>
        <Popup HorizontalAlignment="Stretch"  Name="popupSearch" Grid.Row="1"   IsLightDismissEnabled="True" >

            <Border AllowFocusOnInteraction="False"  CornerRadius="0, 0, 16, 16" >
                <Border.Background>
                    <AcrylicBrush TintColor="Black" 
TintOpacity="0.8" 
           
FallbackColor="Transparent" 
AlwaysUseFallback="False"/>
                </Border.Background>
                <ListView Width="{Binding ElementName=asbSearchOptions, Path=ActualWidth}" HorizontalAlignment="Stretch"   VerticalAlignment="Top" Grid.Row="1" Name="lstViewSearchOptions" Visibility="Collapsed" SelectionMode="Single" ItemClick="lstViewSearchOptions_ItemClick" >

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ToolTipService.ToolTip="{Binding ResultMain}" Padding="8,0" ColumnSpacing="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image Source="{Binding ImageThumbnail}" Width="20"/>
                                <TextBlock Text="{Binding ResultMain}" Grid.Column="1"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding SubInformation}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Grid.Column="2"/>


                            </Grid>
                        </DataTemplate>

                    </ListView.ItemTemplate>

                </ListView>
            </Border>
        </Popup>

    </Grid>
</UserControl>
