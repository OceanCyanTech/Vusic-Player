<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Vusic_Player.UI.UserViews.Controls.MasterSearchControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Vusic_Player.UI.UserViews.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <TextBox FontFamily="{StaticResource GlobalFontHolder}"  Loaded="asbSearchOptions_Loaded" Grid.Row="0" Name="asbSearchOptions" PlaceholderText="Search for media across your library..." PreviewKeyDown="asbSearchOptions_PreviewKeyDown"
TextChanged="asbSearchOptions_TextChanged" GotFocus="asbSearchOptions_GotFocus" LostFocus="asbSearchOptions_LostFocus">
            <TextBox.Resources>
                <!-- 1. Focused State (Accent Highlight on Border & Caret) -->
                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource GlobalAccentColor}"/>
                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1E1E1E"/>
                <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFFFFF"/>
                <SolidColorBrush x:Key="TextControlButtonForegroundFocused" Color="{StaticResource GlobalAccentColor}"/>

                <!-- 2. Resting / Unfocused State -->
                <SolidColorBrush x:Key="TextControlBackground" Color="#202020"/>
                <SolidColorBrush x:Key="TextControlForeground" Color="#FFFFFF"/>
                <SolidColorBrush x:Key="TextControlBorderBrush" Color="#404040"/>
                <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#808080"/>

                <!-- 3. Pointer Over (Hover) State -->
                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#2A2A2A"/>
                <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FFFFFF"/>
                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#555555"/>
                <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#999999"/>

                <!-- 4. Text Selection Highlight (Highlight color when selecting text) -->
                <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="{StaticResource GlobalAccentColor}"/>

                <!-- 5. Inner Clear / Action Button (The "X" delete button) -->
                <SolidColorBrush x:Key="TextControlButtonBackground" Color="Transparent"/>
                <SolidColorBrush x:Key="TextControlButtonBackgroundPointerOver" Color="#303030"/>
                <SolidColorBrush x:Key="TextControlButtonBackgroundPressed" Color="#404040"/>
                <SolidColorBrush x:Key="TextControlButtonForeground" Color="#808080"/>
                <SolidColorBrush x:Key="TextControlButtonForegroundPointerOver" Color="#FFFFFF"/>
                <SolidColorBrush x:Key="TextControlButtonForegroundPressed" Color="#FFFFFF"/>

                <!-- 6. Disabled State -->
                <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#181818"/>
                <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#505050"/>
                <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#2A2A2A"/>
                <SolidColorBrush x:Key="TextControlPlaceholderForegroundDisabled" Color="#404040"/>
            </TextBox.Resources>

        </TextBox>
        <Button x:Name="btnSearchQuery"
            Click="btnSearchQuery_Click"
            Content="&#xE721;" Visibility="Visible"
            FontFamily="{ThemeResource SymbolThemeFontFamily}"
            Background="Transparent"
            BorderBrush="Transparent"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Width="40"
            Height="32"
            Margin="0,0,0,0"/>
        <Popup HorizontalAlignment="Stretch"  Name="popupSearch" Grid.Row="1"   IsLightDismissEnabled="True" >

            <Border AllowFocusOnInteraction="False"  CornerRadius="0, 0, 16, 16" >
                <Border.Background>
                    <AcrylicBrush TintColor="Black" 
TintOpacity="0.8" 
           
FallbackColor="Transparent" 
AlwaysUseFallback="False"/>
                </Border.Background>
                <ListView IsItemClickEnabled="True" Width="{Binding ElementName=asbSearchOptions, Path=ActualWidth}" HorizontalAlignment="Stretch"   VerticalAlignment="Top" Grid.Row="1" Name="lstViewSearchOptions" Visibility="Collapsed" SelectionMode="Single" ItemClick="lstViewSearchOptions_ItemClick" >

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid  ToolTipService.ToolTip="{Binding ResultMain}" Padding="8,0" ColumnSpacing="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image Source="{Binding ImageThumbnail}" Width="20"/>
                                <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Text="{Binding ResultMain}" Grid.Column="1"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Text="{Binding SubInformation}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Grid.Column="2"/>


                            </Grid>
                        </DataTemplate>

                    </ListView.ItemTemplate>

                </ListView>
            </Border>
        </Popup>

    </Grid>
</UserControl>
