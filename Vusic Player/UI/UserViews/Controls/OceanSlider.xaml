<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Vusic_Player.UI.UserViews.Controls.OceanSlider"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Vusic_Player.UI.UserViews.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="ControlRoot" 
  
          Background="Transparent" 
          SizeChanged="ControlRoot_SizeChanged">

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="Width" To="22" Duration="0:0:0.1" />
                        <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="Height" To="22" Duration="0:0:0.1" />
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="Pressed">
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="Width" To="24" Duration="0:0:0.1" />
                        <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="Height" To="24" Duration="0:0:0.1" />
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <ItemsControl x:Name="TickBar" IsHitTestVisible="False" Visibility="Collapsed">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas Background="Transparent" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Rectangle Fill="#808080" Width="2" Height="8" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border x:Name="Track"
                Height="6"
                Background="#404040"
                CornerRadius="4"
                VerticalAlignment="Center"
                Margin="0"/>

        <Border x:Name="Progress"
                Height="6"
                Background="Cyan"
                CornerRadius="4"
                VerticalAlignment="Center"
                HorizontalAlignment="Left"
                Width="0"/>

        <Canvas x:Name="InputLayer"
                Background="Transparent"
                PointerPressed="Root_PointerPressed"
                PointerMoved="Root_PointerMoved"
                PointerReleased="Root_PointerReleased"
                PointerEntered="InputLayer_PointerEntered"
                PointerExited="InputLayer_PointerExited">

            <Popup x:Name="TimePopup" IsHitTestVisible="False" VerticalOffset="-30">
                <Border Background="#222222" CornerRadius="4" Padding="8,4" BorderBrush="#444444" BorderThickness="1">
                    <TextBlock x:Name="TimeLabel" Text="00:00" Foreground="White" FontSize="12" FontWeight="Bold"/>
                </Border>
            </Popup>
            <Ellipse x:Name="Thumb"
                     Width="16" 
                     Height="16"
                     Fill="Cyan"
                     Stroke="DarkSlateGray"
                     StrokeThickness="3"
                     Canvas.Top="8"/>
        </Canvas>
    </Grid>

</UserControl>
