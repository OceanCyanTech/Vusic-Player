<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Vusic_Player.UI.UserViews.Controls.PlaybackMainControls"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Vusic_Player.UI.UserViews.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:oceancyan="using:Vusic_Player"
    mc:Ignorable="d">

    <StackPanel Orientation="Vertical">
        <local:OceanSlider x:Name="sldMain" ChaptersEnabled="{x:Bind mediacontroller.ChaptersEnabled, Mode=OneWay}" DragStarted="sldMain_DragStarted" DragCompleted="sldMain_DragCompleted"  Value="{x:Bind mediacontroller.CurrentPosition, Mode=TwoWay}" Maximum="{x:Bind mediacontroller.TotalDuration, Mode=TwoWay}"
HorizontalAlignment="Stretch" 
Margin="0,7,0,10"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Spacing="200">
            <TextBlock Text="{x:Bind mediacontroller.MediaDisplayName,Mode=OneWay}" Visibility="{x:Bind mediacontroller.DisplayTextVisibility, Mode=OneWay}" Margin="0, 0, 0, 10" Foreground="White" Style="{StaticResource BodyStrongTextBlockStyle}" Name="txtFileName"></TextBlock>
        </StackPanel>
        <Grid x:Name="grdTexts" Margin="5,0,5, 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" HorizontalAlignment="Left" Foreground="White" Text="{x:Bind mediacontroller.RunningDurationString, Mode=OneWay}" Name="txtRunningDuration" FontSize="11" Opacity="0.8"/>

            <TextBlock Grid.Column="1" HorizontalAlignment="Right" Foreground="White" Text="{x:Bind mediacontroller.TotalDurationString, Mode=OneWay}" Name="txtTotalDuration" FontSize="11" Opacity="0.8"/>
        </Grid>

    </StackPanel>
</UserControl>
