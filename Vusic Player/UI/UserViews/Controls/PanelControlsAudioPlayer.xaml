<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Vusic_Player.UI.UserViews.Controls.PanelControlsAudioPlayer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Vusic_Player.UI.UserViews.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:videogeneral="using:Vusic_Player.UI.Dialogs.VideoOptions.VideoGeneral" xmlns:audioadvanced="using:Vusic_Player.UI.Dialogs.VideoOptions.Audio.AudioAdvanced" xmlns:audiogeneral="using:Vusic_Player.UI.Dialogs.VideoOptions.Audio.AudioGeneral" xmlns:audioequalizer="using:Vusic_Player.UI.Dialogs.VideoOptions.Audio.AudioEqualizer"
    mc:Ignorable="d">

    <Grid >
        <StackPanel Name="panelControls" CornerRadius="16" Padding="10" Orientation="Horizontal" HorizontalAlignment="Center">

            <Button Name="btnSpeed" Background="Transparent" BorderBrush="Transparent" ToolTipService.ToolTip="Adjust Speed" >
                <Button.Flyout>
                    <MenuFlyout>
                        <RadioMenuFlyoutItem Tag="0.25" Text="0.25" Name="spquarter" Click="btnSpeedfly_Click"></RadioMenuFlyoutItem>
                        <RadioMenuFlyoutItem Text="0.50" Name="sphalf" Click="btnSpeedfly_Click"></RadioMenuFlyoutItem>
                        <RadioMenuFlyoutItem Text="0.75" Name="spthreefourth" Click="btnSpeedfly_Click"></RadioMenuFlyoutItem>
                        <RadioMenuFlyoutItem IsChecked="True" Name="spone" Text="1.00" Click="btnSpeedfly_Click"></RadioMenuFlyoutItem>
                        <RadioMenuFlyoutItem Text="1.25" Name="sponequarter" Click="btnSpeedfly_Click"></RadioMenuFlyoutItem>
                        <RadioMenuFlyoutItem Text="1.50" Name="sponehalf" Click="btnSpeedfly_Click"></RadioMenuFlyoutItem>
                        <RadioMenuFlyoutItem Text="1.75" Name="sponethreefourth" Click="btnSpeedfly_Click"></RadioMenuFlyoutItem>
                        <RadioMenuFlyoutItem Text="2" Name="sptwo" Click="btnSpeedfly_Click"></RadioMenuFlyoutItem>
                        <RadioMenuFlyoutItem Text="Custom" Click="customSpeed_Click" Name="customSpeed">
                            <RadioMenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE9E9;"></FontIcon>
                            </RadioMenuFlyoutItem.Icon>
                        </RadioMenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>

                <Image Name="imgSpeed" Width="26" Source="{Binding Speed, Source={StaticResource GlobalIconHolder}}"/>
            </Button>
            <TeachingTip Name="ttMultiDeviceOutput" IsOpen="False" >
                <Grid>
                <Grid Name="grdNoMediaPlaying" RowSpacing="10" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="No Media is Playing..."/>
                    <Button Content="Refresh" Style="{StaticResource AccentButtonStyle}" Grid.Row="1" Name="btnRefreshDevices" Click="btnRefreshDevices_Click"/>
                </Grid>
                <audioadvanced:MultipleOutputMixer x:Name="multiOutputMixer"/>
                </Grid>
            </TeachingTip>
            <TeachingTip   Closed="ttSpeedCustom_Closed" Name="ttSpeedCustom"  IsOpen="False" PreferredPlacement="Auto">
                <ScrollViewer>
                    <videogeneral:PlaybackSpeed SliderWidth="100"></videogeneral:PlaybackSpeed>
                </ScrollViewer>
            </TeachingTip>
            <TeachingTip Title="Pitch Control" Name="ttPitch" IsOpen="False">
                <audiogeneral:Pitch x:Name="pitchControl" Margin="20, 20"/>
            </TeachingTip>
            <TeachingTip Name="ttReverb" Closed="ttReverb_Closed"  IsOpen="False" Title="Audio Reverb" PreferredPlacement="Auto">

                <TeachingTip.Content>
                    <ScrollViewer Width="280" >

                        <ScrollViewer.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Close" Click="MenuFlyoutItem_Click"/>
                            </MenuFlyout>
                        </ScrollViewer.ContextFlyout>
                        <audioadvanced:AudioReverb x:Name="audioReverbControl" Margin="2, 0"/>
                    </ScrollViewer>
                </TeachingTip.Content>
            </TeachingTip>
            <Button Visibility="Visible" Background="Transparent" BorderBrush="Transparent" ToolTipService.ToolTip="Mini Player"  Name="btnMiniPlayer" IsEnabled="True" Click="btnMiniPlayer_Click">
                <Image  Width="26" Source="{Binding MiniPlayer, Source={StaticResource GlobalIconHolder}}"/>
            </Button>
            <Button Visibility="Visible" Background="Transparent" BorderBrush="Transparent" ToolTipService.ToolTip="{x:Bind ExpandedViewButtonToolTip, Mode=OneWay}"  Name="btnFullView" IsEnabled="True" Click="btnFullView_Click">
                <Image  Width="26" Source="{Binding ExpandedIcon, Source={StaticResource GlobalIconHolder}}"/>
            </Button>
            <Button Visibility="Visible" ToolTipService.ToolTip="Options" Background="Transparent" BorderBrush="Transparent"  Name="btnEffects" Margin="5, 0" Click="btnEffects_Click">
                <Image  Width="24" Source="{Binding Options, Source={StaticResource GlobalIconHolder}}"/>
                <Button.Flyout>
                    <Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                            <Button Visibility="Visible" Background="Transparent" BorderBrush="Transparent" ToolTipService.ToolTip="Media Tools"  Name="btnTools" IsEnabled="True" >
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Pitch" Click="mnftPitch_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE789;"></FontIcon>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Equalizer" Name="mnftEqualizer" Click="mnftEqualizer_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE9E9;"/>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Reverb" Name="mnftReverb" Click="mnftReverb_Click">
                                            <MenuFlyoutItem.Icon>
                                                <ImageIcon Source="/Assets/reverbfonticon.png"></ImageIcon>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="File Format Converter" Name="mnftFormatConverter" Click="mnftFormatConverter_Click">
                                            <MenuFlyoutItem.Icon>
                                                <ImageIcon Source="/Assets/fileformatconverterfonticon.png"></ImageIcon>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Jump To Time" Name="mnftJumpToTime" Click="mnftJumpToTime_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xEC57;"/>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator/>
                                        <MenuFlyoutItem IsEnabled="{x:Bind media.MultiDeviceOutputFeature, Mode=OneWay}"  Text="Multi-Device Output Mixer" Name="mnftMultiDevice" Click="mnftMultiDevice_Click">
                                            <MenuFlyoutItem.Icon>
                                                <ImageIcon Source="/Assets/multioutputfonticon.png"></ImageIcon>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                               
                                    </MenuFlyout>
                                </Button.Flyout>
                                <Image  Width="26" Source="{Binding ToolsIcon, Source={StaticResource GlobalIconHolder}}"/>
                            </Button>
                            
                            <Button Visibility="Visible" Background="Transparent" BorderBrush="Transparent" ToolTipService.ToolTip="Find Lyrics Online"  Name="btnLyrics" IsEnabled="True" Click="btnLyrics_Click">
                                <Image  Width="26" Source="{Binding FindLyricsOnline, Source={StaticResource GlobalIconHolder}}"/>
                            </Button>
                            <Button Visibility="Visible" Background="Transparent" BorderBrush="Transparent" ToolTipService.ToolTip="{x:Bind GetFavToolTip(media.IsFavourite), Mode=OneWay}"  Name="btnAddtoFavourites" IsEnabled="True" Click="btnAddtoFavourites_Click">
                                <Image  Width="26" Source="{Binding FavIcon, Source={StaticResource GlobalIconHolder}}"/>
                            </Button>
                            <Button Visibility="Visible" Background="Transparent" BorderBrush="Transparent" ToolTipService.ToolTip="File Info"  Name="btnInfo" IsEnabled="True" Click="btnInfo_Click">
                                <Image  Width="26" Source="{Binding FileInfo, Source={StaticResource GlobalIconHolder}}"/>
                            </Button>
                            <ToggleButton Visibility="Visible" Background="Transparent" BorderBrush="Transparent" ToolTipService.ToolTip="Toggle Loop"  Name="btnLoopToggle" Checked="btnLoopToggle_Checked" Unchecked="btnLoopToggle_Checked">
                                <Image  Width="26" Source="{Binding InfoIcon, Source={StaticResource GlobalIconHolder}}"/>
                            </ToggleButton>
                       
                        </StackPanel>

                    </Flyout>
                </Button.Flyout>
            </Button>

        </StackPanel>
        <TeachingTip Name="ttJumpToTime" Title="Jump To Time">
            <Grid Margin="10, 20"  RowSpacing="30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Vertical" Spacing="20">
                    <TextBlock Text="HH:"/>
                    <NumberBox SpinButtonPlacementMode="Inline" Name="numHour" Value="0" Minimum="0"/>
                    <TextBlock Text="MM:"/>
                    <NumberBox SpinButtonPlacementMode="Inline" Name="numMin"  Value="0" Minimum="0"/>
                    <TextBlock Text="SS"/>
                    <NumberBox SpinButtonPlacementMode="Inline" Name="numSec"  Value="0" Minimum="0"/>

                </StackPanel>
                <Button Name="btnJumpToTime" Click="btnJumpToTime_Click" Content="Jump" Style="{StaticResource AccentButtonStyle}" Grid.Row="1"/>
            </Grid>
        </TeachingTip>
        <TeachingTip Title="Equalizer"  Name="popUpEqualizer" >
            <TeachingTip.Resources>
                <!-- Overrides WinUI's internal max width constraint for the popup surface -->
                <x:Double x:Key="TeachingTipContentMaxWidth">1200</x:Double>
                <x:Double x:Key="TeachingTipMaxWidth">1200</x:Double>
            </TeachingTip.Resources>
            <Grid CornerRadius="12" Padding="20, 20" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
        
                <audioequalizer:Equalizer Grid.Row="1"/>
            </Grid>
        </TeachingTip>

    </Grid>
</UserControl>
