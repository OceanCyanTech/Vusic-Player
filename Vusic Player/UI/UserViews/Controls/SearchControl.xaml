<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Vusic_Player.UI.UserViews.Controls.SearchControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Vusic_Player.UI.UserViews.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Storyboard x:Name="ClosePopupAnimation">
            <DoubleAnimation Storyboard.TargetName="PopupTransform"
                             Storyboard.TargetProperty="ScaleX"
                             To="0.8" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase Exponent="6" EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="PopupTransform"
                             Storyboard.TargetProperty="ScaleY"
                             To="0.8" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase Exponent="6" EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="SubtitleSearch"
                             Storyboard.TargetProperty="Opacity"
                             To="0.0" Duration="0:0:0.15"/>
        </Storyboard>

    </UserControl.Resources>
    <Grid Name="SearchPanel">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Vertical" Spacing="10" Grid.Row="0">
            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Text="Search" Style="{StaticResource BaseTextBlockStyle}"></TextBlock>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="5">
                <AutoSuggestBox FontFamily="{StaticResource GlobalFontHolder}"  PreviewKeyDown="asbSearch_PreviewKeyDown" QuerySubmitted="asbSearch_QuerySubmitted" Width="200" Name="asbSearch" TextChanged="asbSearch_TextChanged"  PlaceholderText="{x:Bind SearchPlaceHolderText, Mode=OneWay}" QueryIcon="Find" Grid.Row="0">
                    <AutoSuggestBox.Resources>
                        <!-- 1. Focused State (Accent Highlight on Border & Caret) -->
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource GlobalAccentColor}"/>
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1E1E1E"/>
                        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFFFFF"/>

                        <!-- 2. Resting / Unfocused State -->
                        <SolidColorBrush x:Key="TextControlBackground" Color="#202020"/>
                        <SolidColorBrush x:Key="TextControlForeground" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="#404040"/>
                        <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#808080"/>

                        <!-- 3. Pointer Over (Hover) State -->
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#2A2A2A"/>
                        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#555555"/>
                        <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#999999"/>

                        <!-- 4. Text Selection Highlight -->
                        <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="{StaticResource GlobalAccentColor}"/>

                        <!-- 5. Query / Search Icon Button & Clear ("X") Button -->
                        <SolidColorBrush x:Key="AutoSuggestBoxButtonForeground" Color="#808080"/>
                        <SolidColorBrush x:Key="AutoSuggestBoxButtonForegroundPointerOver" Color="{StaticResource GlobalAccentColorPointerOver}"/>
                        <SolidColorBrush x:Key="AutoSuggestBoxButtonForegroundPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                        <SolidColorBrush x:Key="AutoSuggestBoxButtonBackgroundPointerOver" Color="#303030"/>
                        <SolidColorBrush x:Key="AutoSuggestBoxButtonBackgroundPressed" Color="#404040"/>

                        <!-- 6. Suggestions Dropdown Popup (ListView items) -->
                        <!-- Background surface of the dropdown overlay -->
                        <SolidColorBrush x:Key="AutoSuggestBoxSuggestionsListBackground" Color="#1E1E1E"/>

                        <!-- Hovered suggestion item -->
                        <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#2C2C2C"/>
                        <SolidColorBrush x:Key="ListViewItemForegroundPointerOver" Color="#FFFFFF"/>

                        <!-- Selected suggestion item (Focused or Arrow-Key Navigated) -->
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#333333"/>
                        <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#383838"/>

                        <!-- Selection Indicator Pill on the left of the item -->
                        <SolidColorBrush x:Key="ListViewItemSelectionIndicatorFill" Color="{StaticResource GlobalAccentColor}"/>
                        <SolidColorBrush x:Key="ListViewItemSelectionIndicatorFillPointerOver" Color="{StaticResource GlobalAccentColorPointerOver}"/>

                        <!-- 7. Disabled State -->
                        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#181818"/>
                        <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#505050"/>
                        <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#2A2A2A"/>
                    </AutoSuggestBox.Resources>
                </AutoSuggestBox>
                <Button Name="btnCloseSubtitleSearch" Click="btnCloseSubtitleSearch_Click" ToolTipService.ToolTip="Close Search" Background="Transparent" BorderBrush="Transparent">
                    <Image Width="20" Source="{Binding Removeicon, Source={StaticResource GlobalIconHolder}}"></Image>
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Escape"></KeyboardAccelerator>
                    </Button.KeyboardAccelerators>
                </Button>
            </StackPanel>
        </StackPanel>
        <ListView Margin="0, 10" Grid.Row="1" SelectionMode="Single" ItemClick="lstViewSearchResults_ItemClick" SelectionChanged="lstViewSearchResults_SelectionChanged" Name="lstViewSearchResults">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Height="40" Padding="8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Text="{Binding ResultString}" 
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>


                    </Grid>
                </DataTemplate>

            </ListView.ItemTemplate>
        </ListView>
        <StackPanel Margin="0, 10" Grid.Row="1" Orientation="Horizontal" Name="stkNoSearchResultsFound" Visibility="Collapsed" Spacing="5">
            <Image Width="20" Source="{Binding SearchIcon, Source={StaticResource GlobalIconHolder}}"></Image>
            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Text="{x:Bind NoSearchResultsDisplayString, Mode=OneWay}"></TextBlock>
        </StackPanel>
    </Grid>
</UserControl>
