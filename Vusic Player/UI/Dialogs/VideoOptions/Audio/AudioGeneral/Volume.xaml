<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Vusic_Player.UI.Dialogs.VideoOptions.Audio.AudioGeneral.Volume"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Vusic_Player.UI.Dialogs.VideoOptions.Audio.AudioGeneral"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:converters="using:Vusic_Player.Configuration.Helper.Converters" xmlns:oceancyan="using:Vusic_Player.UI.UserViews.Controls"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:RoundedPercentStringConverter x:Key="Percenter"/>
    </UserControl.Resources>
    <StackPanel Spacing="8" Name="stkVolume" >
        <Grid>
            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"    Text="Audio Volume" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"    Text="{x:Bind VolumeSlider.Value, Converter={StaticResource Percenter}, Mode=OneWay}" 
                HorizontalAlignment="Right" 
                Foreground="{StaticResource GlobalAccentColor}"/>
        </Grid>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <oceancyan:OceanSlider x:Name= "VolumeSlider" 
                            Minimum="0" 
                            Maximum="{x:Bind mediacontroller.MaximumVolume, Mode=OneWay}" 
                            Value="{x:Bind mediacontroller.VolumeValue, Mode=TwoWay}" 
                            Margin="5,0"
                            IsTooltipEnabled="False" 
                            ValueChanged="VolumeSlider_ValueChanged"/>

            <NumberBox Grid.Column="1" 
                Value="{Binding ElementName=VolumeSlider, Path=Value, Mode=TwoWay}"
                Minimum="0" Name="numVolume" ValueChanged="numVolume_ValueChanged"
                Maximum="250"  FontFamily="{StaticResource GlobalFontHolder}"   
                SpinButtonPlacementMode="Compact"
                SmallChange="1" 
                LargeChange="10">
                <NumberBox.Resources>
                    <!-- 1. Focused State (Accent Border & Caret) -->
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource GlobalAccentColor}"/>
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1E1E1E"/>
                    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFFFFF"/>

                    <!-- 2. Resting / Unfocused State -->
                    <SolidColorBrush x:Key="TextControlBackground" Color="#202020"/>
                    <SolidColorBrush x:Key="TextControlForeground" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#404040"/>
                    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#808080"/>

                    <!-- 3. Pointer Over (Hover) State -->
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#2A2A2A"/>
                    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#555555"/>

                    <!-- 4. Text Selection Highlight -->
                    <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="{StaticResource GlobalAccentColor}"/>

                    <!-- 5. Spin Up/Down Repeat Buttons (Resting) -->
                    <SolidColorBrush x:Key="NumberBoxSpinButtonBackground" Color="Transparent"/>
                    <SolidColorBrush x:Key="NumberBoxSpinButtonForeground" Color="#AAAAAA"/>
                    <SolidColorBrush x:Key="NumberBoxSpinButtonBorderBrush" Color="Transparent"/>

                    <!-- 6. Spin Up/Down Repeat Buttons (Pointer Over) -->
                    <SolidColorBrush x:Key="NumberBoxSpinButtonBackgroundPointerOver" Color="#303030"/>
                    <SolidColorBrush x:Key="NumberBoxSpinButtonForegroundPointerOver" Color="{StaticResource GlobalAccentColor}"/>
                    <SolidColorBrush x:Key="NumberBoxSpinButtonBorderBrushPointerOver" Color="Transparent"/>

                    <!-- 7. Spin Up/Down Repeat Buttons (Pressed) -->
                    <SolidColorBrush x:Key="NumberBoxSpinButtonBackgroundPressed" Color="#404040"/>
                    <SolidColorBrush x:Key="NumberBoxSpinButtonForegroundPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                    <SolidColorBrush x:Key="NumberBoxSpinButtonBorderBrushPressed" Color="Transparent"/>

                    <!-- 8. Spin Up/Down Repeat Buttons (Disabled) -->
                    <SolidColorBrush x:Key="NumberBoxSpinButtonBackgroundDisabled" Color="Transparent"/>
                    <SolidColorBrush x:Key="NumberBoxSpinButtonForegroundDisabled" Color="#404040"/>
                    <SolidColorBrush x:Key="NumberBoxSpinButtonBorderBrushDisabled" Color="Transparent"/>

                    <!-- 9. Header / Label Foreground -->
                    <SolidColorBrush x:Key="NumberBoxHeaderForeground" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="NumberBoxHeaderForegroundDisabled" Color="#707070"/>

                    <!-- 10. Disabled NumberBox State -->
                    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#181818"/>
                    <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#505050"/>
                    <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#2A2A2A"/>
                </NumberBox.Resources>
            </NumberBox>

            <Button Grid.Column="2" 
             Content="Reset"  FontFamily="{StaticResource GlobalFontHolder}"   
             Name="btnVolumeReset" 
             Click="btnVolumeReset_Click"/>
        </Grid>
        <Rectangle Height="1" Fill="{ThemeResource SystemControlBackgroundBaseLowBrush}" Margin="0,4" Grid.Row="3"/>

    </StackPanel>
</UserControl>
