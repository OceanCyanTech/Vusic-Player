<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Vusic_Player.UI.Dialogs.VideoOptions.Audio.AudioGeneral.Device"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Vusic_Player.UI.Dialogs.VideoOptions.Audio.AudioGeneral"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:oceancyan="using:Vusic_Player.UI.UserViews.Controls"
    mc:Ignorable="d">

    <StackPanel Orientation="Vertical" Spacing="10">
        <StackPanel Name="stkAudioDevice" Spacing="8" Margin="0,0,0,10" Grid.Row="2">
            <TextBlock Text="Audio Device" Style="{StaticResource BodyStrongTextBlockStyle}"/>
            <oceancyan:SearchControl Margin="0, 10" 
                         CloseSearch="srchAudioDevice_CloseSearch" 
                         SearchPlaceHolderText="Search audio devices..."  
                         NoSearchResultsDisplayString="No audio device found!" 
                         MaxHeight="200" Width="300" 
                         HorizontalAlignment="Left" 
                         Visibility="Collapsed" 
                         ItemSelected="srchAudioDevice_ItemSelected" 
                         x:Name="srchAudioDevice">
            </oceancyan:SearchControl>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox Name="cmbAudioDevice"
                  VerticalAlignment="Stretch"
                  HorizontalAlignment="Stretch" 
                          ItemsSource="{x:Bind ViewModel.Devices}"
                          SelectedItem="{x:Bind ViewModel.CurrentDevice, Mode=TwoWay}"
                  PlaceholderText="Default Audio Device" 
                  SelectionChanged="cmbAudioDevice_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE7F5;" FontSize="16" Foreground="Cyan" />
                                <TextBlock Text="{Binding Name}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button ToolTipService.ToolTip="Search Audio Devices" 
                Name="btnSearchAudioDevice" 
                VerticalAlignment="Stretch" 
                Click="btnSearchAudioDevice_Click" 
                Background="Transparent" 
                BorderBrush="Transparent" 
                Grid.Column="1" 
                Margin="4,0,0,0" 
                Padding="4">
                    <Image Source="ms-appx:///Assets/searchicon.png" Width="16" Height="16"/>
                </Button>
            </Grid>

        </StackPanel>

        <Rectangle Height="1" Fill="{ThemeResource SystemControlBackgroundBaseLowBrush}" Margin="0,4" Grid.Row="3"/>

    </StackPanel>

</UserControl>
