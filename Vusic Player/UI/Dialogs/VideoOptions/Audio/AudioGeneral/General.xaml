<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Vusic_Player.UI.Dialogs.VideoOptions.Audio.AudioGeneral.General"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Vusic_Player.UI.Dialogs.VideoOptions.Audio.AudioGeneral"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:oceancyan="using:Vusic_Player.UI.UserViews.Controls" xmlns:flyleaf="using:FlyleafLib.MediaFramework.MediaStream"
    mc:Ignorable="d">

    <StackPanel Orientation="Vertical" Spacing="10">
        <StackPanel Name="stkAudioStream" Spacing="8" Margin="0,0,0,10" Grid.Row="0">
            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"    Text="Audio Stream" Style="{StaticResource BodyStrongTextBlockStyle}"/>
            <oceancyan:SearchControl Margin="0, 10" CloseSearch="srchAudio_CloseSearch" SearchPlaceHolderText="Search audio streams..."  NoSearchResultsDisplayString="No audio stream found based on your search!" MaxHeight="200" Width="320" HorizontalAlignment="Left" Visibility="Collapsed" ItemSelected="srchAudio_ItemSelected" x:Name="srchAudio">

            </oceancyan:SearchControl>
            <Grid >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <ComboBox Name="cmbAudioTrack"  VerticalAlignment="Stretch"
HorizontalAlignment="Stretch"  FontFamily="{StaticResource GlobalFontHolder}"   
PlaceholderText="Select Audio Track"  ItemsSource="{x:Bind ViewModel.AudStreams, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.CurrentStream, Mode=TwoWay}"

SelectionChanged="cmbAudioTrack_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="flyleaf:AudioStream">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8D6;" FontSize="16" Foreground="{StaticResource GlobalAccentColor}"/>

                                <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource GlobalFontHolder}"   >
       <Run Text="Stream"/>
       <Run Text="{x:Bind StreamIndex}"/>
       <Run Text="["/>
       <Run Text="{x:Bind Language}"/>
       <Run Text="]"/>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Click="btnSearchAudio_Click" ToolTipService.ToolTip="Search Audio Tracks" Name="btnSearchAudio" VerticalAlignment="Stretch" Background="Transparent" BorderBrush="Transparent" Grid.Column="1" Margin="4,0,0,0" Padding="4">
                    <Image Source="{Binding SearchIcon, Source={StaticResource GlobalIconHolder}}" Width="16" Height="16"/>
                </Button>
            </Grid>
            <ToggleButton Checked="tglDisableAudioTrack_Checked" 
Unchecked="tglDisableAudioTrack_Unchecked" Name="tglDisableAudioTrack"
Content="Disable Audio"  FontFamily="{StaticResource GlobalFontHolder}"   
HorizontalAlignment="Left">
                <ToggleButton.Resources>
                    <!-- 1. Background Fill when CHECKED -->
                    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{StaticResource GlobalAccentColor}"/>
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{StaticResource GlobalAccentColorPointerOver}"/>
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedDisabled" Color="#2A2A2A"/>

                    <!-- 2. Text / Icon Foreground when CHECKED -->
                    <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#000000"/>
                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#000000"/>
                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#000000"/>
                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedDisabled" Color="#707070"/>

                    <!-- 3. Border Stroke when CHECKED -->
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent"/>
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent"/>
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedDisabled" Color="Transparent"/>

                    <!-- 4. Background Fill when UNCHECKED -->
                    <SolidColorBrush x:Key="ToggleButtonBackground" Color="#202020"/>
                    <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#2D2D2D"/>
                    <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#181818"/>
                    <SolidColorBrush x:Key="ToggleButtonBackgroundDisabled" Color="#1E1E1E"/>

                    <!-- 5. Text / Icon Foreground when UNCHECKED -->
                    <SolidColorBrush x:Key="ToggleButtonForeground" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="ToggleButtonForegroundPointerOver" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="ToggleButtonForegroundPressed" Color="#CCCCCC"/>
                    <SolidColorBrush x:Key="ToggleButtonForegroundDisabled" Color="#505050"/>

                    <!-- 6. Border Stroke when UNCHECKED -->
                    <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="#404040"/>
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="#555555"/>
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="#303030"/>
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushDisabled" Color="#2A2A2A"/>
                </ToggleButton.Resources>
            </ToggleButton>
        </StackPanel>
        <Rectangle Height="1" Grid.Row="1" Fill="{ThemeResource SystemControlBackgroundBaseLowBrush}" Margin="0,4"/>

    </StackPanel>

</UserControl>
