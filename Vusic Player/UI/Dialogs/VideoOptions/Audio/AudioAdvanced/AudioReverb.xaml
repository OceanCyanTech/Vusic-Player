<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Vusic_Player.UI.Dialogs.VideoOptions.Audio.AudioAdvanced.AudioReverb"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Vusic_Player.UI.Dialogs.VideoOptions.Audio.AudioAdvanced"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowSpacing="15" Margin="0, 10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>
        <ComboBox FontFamily="{StaticResource GlobalFontHolder}"  SelectionChanged="cmbReverb_SelectionChanged" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"  Header="Style" SelectedIndex="2" Grid.Row="0" Name="cmbReverb">
            <ComboBoxItem FontFamily="{StaticResource GlobalFontHolder}"  Content="Small Room"/>
            <ComboBoxItem FontFamily="{StaticResource GlobalFontHolder}"  Content="Large Hall"/>
            <ComboBoxItem FontFamily="{StaticResource GlobalFontHolder}"  Content="Cathedral (Recommended)"/>
            <ComboBoxItem FontFamily="{StaticResource GlobalFontHolder}"  Content="Normal"/>
            <ComboBoxItem FontFamily="{StaticResource GlobalFontHolder}"  Content="Cave"/>
            <ComboBoxItem FontFamily="{StaticResource GlobalFontHolder}"  Content="Bathroom"/>
            <ComboBoxItem FontFamily="{StaticResource GlobalFontHolder}"  Content="Ethereal"/>
        </ComboBox>
        <StackPanel Grid.Row="1" Spacing="10">
            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Name="txtApplyReverbProgress" Text="" Visibility="Collapsed"></TextBlock>
            <ProgressBar Visibility="Collapsed" Name="prgApplyingReverb" Grid.Row="1" Value="20" IsIndeterminate="False">
                <ProgressBar.Resources>
                    <!-- 1. Determinate State: Active Track Indicator Fill -->
                    <SolidColorBrush x:Key="ProgressBarForeground" Color="{StaticResource GlobalAccentColor}"/>

                    <!-- 2. Track Background (The empty track/trough behind the progress) -->
                    <SolidColorBrush x:Key="ProgressBarBackground" Color="#2A2A2A"/>

                    <!-- 3. Outer Border Stroke (Default is transparent in WinUI) -->
                    <SolidColorBrush x:Key="ProgressBarBorderBrush" Color="Transparent"/>

                    <!-- 4. Indeterminate State (Looping pulse animation / loading bar) -->
                    <SolidColorBrush x:Key="ProgressBarIndeterminateForeground" Color="{StaticResource GlobalAccentColor}"/>

                    <!-- 5. Paused State (When ShowPaused="True") -->
                    <SolidColorBrush x:Key="ProgressBarPausedForeground" Color="#FFC83B"/>

                    <!-- 6. Error State (When ShowError="True") -->
                    <SolidColorBrush x:Key="ProgressBarErrorForeground" Color="#FF4343"/>

                    <!-- 7. Disabled State -->
                    <SolidColorBrush x:Key="ProgressBarForegroundDisabled" Color="#404040"/>
                    <SolidColorBrush x:Key="ProgressBarBackgroundDisabled" Color="#1E1E1E"/>
                    <SolidColorBrush x:Key="ProgressBarBorderBrushDisabled" Color="Transparent"/>

                    <!-- 8. Corner Radius (Geometry rounding for both track and indicator) -->
                    <CornerRadius x:Key="ProgressBarCornerRadius">3</CornerRadius>
                    <CornerRadius x:Key="ProgressBarTrackCornerRadius">3</CornerRadius>
                </ProgressBar.Resources>
            </ProgressBar>
        </StackPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <CheckBox FontFamily="{StaticResource GlobalFontHolder}"    Checked="CheckBox_Checked" Unchecked="CheckBox_Checked" Content="Show More Options" Grid.Column="0">
                <CheckBox.Resources>
                    <!-- Checked State (Background box fill) -->
                    <SolidColorBrush x:Key="CheckBoxFillColorDefault" Color="{StaticResource GlobalAccentColor}"/>
                    <SolidColorBrush x:Key="CheckBoxFillColorPointerOver" Color="{StaticResource GlobalAccentColorPointerOver}"/>
                    <SolidColorBrush x:Key="CheckBoxFillColorPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                    <SolidColorBrush x:Key="CheckBoxFillColorDisabled" Color="#2A2A2A"/>

                    <!-- Checkmark Glyph Color (The tick mark inside the box) -->
                    <SolidColorBrush x:Key="CheckBoxCheckGlyphForeground" Color="#000000"/>
                    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundPointerOver" Color="#000000"/>
                    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundPressed" Color="#000000"/>
                    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundDisabled" Color="#707070"/>

                    <!-- Unchecked State (Empty box outline border) -->
                    <SolidColorBrush x:Key="CheckBoxStrokeColorDefault" Color="#808080"/>
                    <SolidColorBrush x:Key="CheckBoxStrokeColorPointerOver" Color="#B0B0B0"/>
                    <SolidColorBrush x:Key="CheckBoxStrokeColorPressed" Color="#606060"/>

                    <!-- Text Label Foreground -->
                    <SolidColorBrush x:Key="CheckBoxForeground" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="CheckBoxForegroundPointerOver" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="CheckBoxForegroundPressed" Color="#CCCCCC"/>
                </CheckBox.Resources>
            </CheckBox>

            <Button FontFamily="{StaticResource GlobalFontHolder}"    HorizontalAlignment="Right" Content="Apply Reverb" Name="btnApply" Click="btnApply_Click" Style="{StaticResource AccentButtonStyle}" Grid.Column="1" Background="{StaticResource GlobalAccentColor}" >
                <Button.Resources>
                    <SolidColorBrush x:Key="AccentButtonBackground" Color="{StaticResource GlobalAccentColor}"/>
                    <SolidColorBrush x:Key="AccentButtonForeground" Color="#0B0D13"/>
                    <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent"/>

                    <!-- Pointer Over (Hover) -->
                    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{StaticResource GlobalAccentColorPointerOver}"/>
                    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#0B0D13"/>
                    <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="Transparent"/>

                    <!-- Pressed State -->
                    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="Transparent"/>

                    <!-- Disabled State -->
                    <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#2A2A2A"/>
                    <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#707070"/>
                    <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="Transparent"/>
                </Button.Resources>
            </Button>
        </Grid>
        <MenuFlyoutSeparator Grid.Row="3" Name="mnfs1" Visibility="Collapsed"/>
        <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Visibility="Collapsed" Text="More Options" Style="{StaticResource BodyLargeStrongTextBlockStyle}" Name="txtMore" Grid.Row="4"/>
        <Grid Visibility="Collapsed" Name="grdMoreOptions"  Grid.Row="5" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Button FontFamily="{StaticResource GlobalFontHolder}"    Name="btnApplyMultiple" Click="btnApplyMultiple_Click" Style="{StaticResource AccentButtonStyle}" Content="Apply Reverb to Multiple Files" Background="{StaticResource GlobalAccentColor}" >
                <Button.Resources>
                    <SolidColorBrush x:Key="AccentButtonBackground" Color="{StaticResource GlobalAccentColor}"/>
                    <SolidColorBrush x:Key="AccentButtonForeground" Color="#0B0D13"/>
                    <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent"/>

                    <!-- Pointer Over (Hover) -->
                    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{StaticResource GlobalAccentColorPointerOver}"/>
                    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#0B0D13"/>
                    <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="Transparent"/>

                    <!-- Pressed State -->
                    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="Transparent"/>

                    <!-- Disabled State -->
                    <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#2A2A2A"/>
                    <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#707070"/>
                    <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="Transparent"/>
                </Button.Resources>
            </Button>
            <TextBox FontFamily="{StaticResource GlobalFontHolder}"    Header="File Name" Name="txtFileName" Grid.Row="1" TextChanged="txtFileName_TextChanged" Visibility="Collapsed" PlaceholderText="Enter file name....">
                <TextBox.Resources>
                    <!-- 1. Focused State (Accent Highlight on Border & Caret) -->
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource GlobalAccentColor}"/>
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1E1E1E"/>
                    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="TextControlButtonForegroundFocused" Color="{StaticResource GlobalAccentColor}"/>

                    <!-- 2. Resting / Unfocused State -->
                    <SolidColorBrush x:Key="TextControlBackground" Color="#202020"/>
                    <SolidColorBrush x:Key="TextControlForeground" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#404040"/>
                    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#808080"/>

                    <!-- 3. Pointer Over (Hover) State -->
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#2A2A2A"/>
                    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#555555"/>
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#999999"/>

                    <!-- 4. Text Selection Highlight (Highlight color when selecting text) -->
                    <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="{StaticResource GlobalAccentColor}"/>

                    <!-- 5. Inner Clear / Action Button (The "X" delete button) -->
                    <SolidColorBrush x:Key="TextControlButtonBackground" Color="Transparent"/>
                    <SolidColorBrush x:Key="TextControlButtonBackgroundPointerOver" Color="#303030"/>
                    <SolidColorBrush x:Key="TextControlButtonBackgroundPressed" Color="#404040"/>
                    <SolidColorBrush x:Key="TextControlButtonForeground" Color="#808080"/>
                    <SolidColorBrush x:Key="TextControlButtonForegroundPointerOver" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="TextControlButtonForegroundPressed" Color="#FFFFFF"/>

                    <!-- 6. Disabled State -->
                    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#181818"/>
                    <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#505050"/>
                    <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#2A2A2A"/>
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundDisabled" Color="#404040"/>
                </TextBox.Resources>
            </TextBox>
            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Text="Enter File Name!" Grid.Row="2" Visibility="Collapsed" Foreground="Red" Name="txtEnterFileNameWarning"></TextBlock>
            <Grid Grid.Row="3" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <ComboBox FontFamily="{StaticResource GlobalFontHolder}"  SelectionChanged="cmbOutput_SelectionChanged" SelectedIndex="0" Name="cmbOutput" Header="Output" Grid.Column="0">
                    <ComboBox.Items>
                        <ComboBoxItem  FontFamily="{StaticResource GlobalFontHolder}"  Content="Memory Stream" ToolTipService.ToolTip="Create reverb output in RAM (Quicker)"/>
                        <ComboBoxItem FontFamily="{StaticResource GlobalFontHolder}"  Content="Temporary File on Disk" ToolTipService.ToolTip="Create output as temporary file on Disk (Saves RAM)"/>
                    </ComboBox.Items>
                </ComboBox>
                <CheckBox FontFamily="{StaticResource GlobalFontHolder}"    Name="chckExporttoFile" Content="Export to File" Checked="CheckBox_Checked_1" Unchecked="CheckBox_Checked_1" Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" ToolTipService.ToolTip="When Apply Reverb is clicked, you can choose to export the output to your PC and play">
                    <CheckBox.Resources>
                        <!-- Checked State (Background box fill) -->
                        <SolidColorBrush x:Key="CheckBoxFillColorDefault" Color="{StaticResource GlobalAccentColor}"/>
                        <SolidColorBrush x:Key="CheckBoxFillColorPointerOver" Color="{StaticResource GlobalAccentColorPointerOver}"/>
                        <SolidColorBrush x:Key="CheckBoxFillColorPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                        <SolidColorBrush x:Key="CheckBoxFillColorDisabled" Color="#2A2A2A"/>

                        <!-- Checkmark Glyph Color (The tick mark inside the box) -->
                        <SolidColorBrush x:Key="CheckBoxCheckGlyphForeground" Color="#000000"/>
                        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundPointerOver" Color="#000000"/>
                        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundPressed" Color="#000000"/>
                        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundDisabled" Color="#707070"/>

                        <!-- Unchecked State (Empty box outline border) -->
                        <SolidColorBrush x:Key="CheckBoxStrokeColorDefault" Color="#808080"/>
                        <SolidColorBrush x:Key="CheckBoxStrokeColorPointerOver" Color="#B0B0B0"/>
                        <SolidColorBrush x:Key="CheckBoxStrokeColorPressed" Color="#606060"/>

                        <!-- Text Label Foreground -->
                        <SolidColorBrush x:Key="CheckBoxForeground" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="CheckBoxForegroundPointerOver" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="CheckBoxForegroundPressed" Color="#CCCCCC"/>
                    </CheckBox.Resources>
                </CheckBox>

            </Grid>
            <Grid Grid.Row="4" RowSpacing="10" ColumnSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <NumberBox FontFamily="{StaticResource GlobalFontHolder}"    x:Name="numReverberance" Minimum="0" Maximum="100" Value="80" SpinButtonPlacementMode="Compact" Header="Reverberance %" Grid.Row="0" Grid.Column="0">
                    <NumberBox.Resources>
                        <!-- 1. Focused State (Accent Border & Caret) -->
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource GlobalAccentColor}"/>
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1E1E1E"/>
                        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFFFFF"/>

                        <!-- 2. Resting / Unfocused State -->
                        <SolidColorBrush x:Key="TextControlBackground" Color="#202020"/>
                        <SolidColorBrush x:Key="TextControlForeground" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="#404040"/>
                        <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#808080"/>

                        <!-- 3. Pointer Over (Hover) State -->
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#2A2A2A"/>
                        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#555555"/>

                        <!-- 4. Text Selection Highlight -->
                        <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="{StaticResource GlobalAccentColor}"/>

                        <!-- 5. Spin Up/Down Repeat Buttons (Resting) -->
                        <SolidColorBrush x:Key="NumberBoxSpinButtonBackground" Color="Transparent"/>
                        <SolidColorBrush x:Key="NumberBoxSpinButtonForeground" Color="#AAAAAA"/>
                        <SolidColorBrush x:Key="NumberBoxSpinButtonBorderBrush" Color="Transparent"/>

                        <!-- 6. Spin Up/Down Repeat Buttons (Pointer Over) -->
                        <SolidColorBrush x:Key="NumberBoxSpinButtonBackgroundPointerOver" Color="#303030"/>
                        <SolidColorBrush x:Key="NumberBoxSpinButtonForegroundPointerOver" Color="{StaticResource GlobalAccentColor}"/>
                        <SolidColorBrush x:Key="NumberBoxSpinButtonBorderBrushPointerOver" Color="Transparent"/>

                        <!-- 7. Spin Up/Down Repeat Buttons (Pressed) -->
                        <SolidColorBrush x:Key="NumberBoxSpinButtonBackgroundPressed" Color="#404040"/>
                        <SolidColorBrush x:Key="NumberBoxSpinButtonForegroundPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                        <SolidColorBrush x:Key="NumberBoxSpinButtonBorderBrushPressed" Color="Transparent"/>

                        <!-- 8. Spin Up/Down Repeat Buttons (Disabled) -->
                        <SolidColorBrush x:Key="NumberBoxSpinButtonBackgroundDisabled" Color="Transparent"/>
                        <SolidColorBrush x:Key="NumberBoxSpinButtonForegroundDisabled" Color="#404040"/>
                        <SolidColorBrush x:Key="NumberBoxSpinButtonBorderBrushDisabled" Color="Transparent"/>

                        <!-- 9. Header / Label Foreground -->
                        <SolidColorBrush x:Key="NumberBoxHeaderForeground" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="NumberBoxHeaderForegroundDisabled" Color="#707070"/>

                        <!-- 10. Disabled NumberBox State -->
                        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#181818"/>
                        <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#505050"/>
                        <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#2A2A2A"/>
                    </NumberBox.Resources>
                </NumberBox>
                <NumberBox FontFamily="{StaticResource GlobalFontHolder}"    x:Name="numHfDamping" Minimum="0" Maximum="100" Value="40" SpinButtonPlacementMode="Compact" Header="HF Damping %" Grid.Row="0" Grid.Column="1">
                    <NumberBox.Resources>
                        <!-- 1. Focused State (Accent Border & Caret) -->
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource GlobalAccentColor}"/>
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1E1E1E"/>
                        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFFFFF"/>

                        <!-- 2. Resting / Unfocused State -->
                        <SolidColorBrush x:Key="TextControlBackground" Color="#202020"/>
                        <SolidColorBrush x:Key="TextControlForeground" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="#404040"/>
                        <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#808080"/>

                        <!-- 3. Pointer Over (Hover) State -->
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#2A2A2A"/>
                        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#555555"/>

                        <!-- 4. Text Selection Highlight -->
                        <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="{StaticResource GlobalAccentColor}"/>

                        <!-- 5. Spin Up/Down Repeat Buttons (Resting) -->
                        <SolidColorBrush x:Key="NumberBoxSpinButtonBackground" Color="Transparent"/>
                        <SolidColorBrush x:Key="NumberBoxSpinButtonForeground" Color="#AAAAAA"/>
                        <SolidColorBrush x:Key="NumberBoxSpinButtonBorderBrush" Color="Transparent"/>

                        <!-- 6. Spin Up/Down Repeat Buttons (Pointer Over) -->
                        <SolidColorBrush x:Key="NumberBoxSpinButtonBackgroundPointerOver" Color="#303030"/>
                        <SolidColorBrush x:Key="NumberBoxSpinButtonForegroundPointerOver" Color="{StaticResource GlobalAccentColor}"/>
                        <SolidColorBrush x:Key="NumberBoxSpinButtonBorderBrushPointerOver" Color="Transparent"/>

                        <!-- 7. Spin Up/Down Repeat Buttons (Pressed) -->
                        <SolidColorBrush x:Key="NumberBoxSpinButtonBackgroundPressed" Color="#404040"/>
                        <SolidColorBrush x:Key="NumberBoxSpinButtonForegroundPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                        <SolidColorBrush x:Key="NumberBoxSpinButtonBorderBrushPressed" Color="Transparent"/>

                        <!-- 8. Spin Up/Down Repeat Buttons (Disabled) -->
                        <SolidColorBrush x:Key="NumberBoxSpinButtonBackgroundDisabled" Color="Transparent"/>
                        <SolidColorBrush x:Key="NumberBoxSpinButtonForegroundDisabled" Color="#404040"/>
                        <SolidColorBrush x:Key="NumberBoxSpinButtonBorderBrushDisabled" Color="Transparent"/>

                        <!-- 9. Header / Label Foreground -->
                        <SolidColorBrush x:Key="NumberBoxHeaderForeground" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="NumberBoxHeaderForegroundDisabled" Color="#707070"/>

                        <!-- 10. Disabled NumberBox State -->
                        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#181818"/>
                        <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#505050"/>
                        <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#2A2A2A"/>
                    </NumberBox.Resources>
                </NumberBox>
                <NumberBox FontFamily="{StaticResource GlobalFontHolder}"    x:Name="numRoomScale" Minimum="0" Maximum="100" Value="100" SpinButtonPlacementMode="Compact" Header="Room Scale %" Grid.Row="1" Grid.Column="0">
                    <NumberBox.Resources>
                        <!-- 1. Focused State (Accent Border & Caret) -->
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource GlobalAccentColor}"/>
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1E1E1E"/>
                        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFFFFF"/>

                        <!-- 2. Resting / Unfocused State -->
                        <SolidColorBrush x:Key="TextControlBackground" Color="#202020"/>
                        <SolidColorBrush x:Key="TextControlForeground" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="#404040"/>
                        <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#808080"/>

                        <!-- 3. Pointer Over (Hover) State -->
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#2A2A2A"/>
                        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#555555"/>

                        <!-- 4. Text Selection Highlight -->
                        <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="{StaticResource GlobalAccentColor}"/>

                        <!-- 5. Spin Up/Down Repeat Buttons (Resting) -->
                        <SolidColorBrush x:Key="NumberBoxSpinButtonBackground" Color="Transparent"/>
                        <SolidColorBrush x:Key="NumberBoxSpinButtonForeground" Color="#AAAAAA"/>
                        <SolidColorBrush x:Key="NumberBoxSpinButtonBorderBrush" Color="Transparent"/>

                        <!-- 6. Spin Up/Down Repeat Buttons (Pointer Over) -->
                        <SolidColorBrush x:Key="NumberBoxSpinButtonBackgroundPointerOver" Color="#303030"/>
                        <SolidColorBrush x:Key="NumberBoxSpinButtonForegroundPointerOver" Color="{StaticResource GlobalAccentColor}"/>
                        <SolidColorBrush x:Key="NumberBoxSpinButtonBorderBrushPointerOver" Color="Transparent"/>

                        <!-- 7. Spin Up/Down Repeat Buttons (Pressed) -->
                        <SolidColorBrush x:Key="NumberBoxSpinButtonBackgroundPressed" Color="#404040"/>
                        <SolidColorBrush x:Key="NumberBoxSpinButtonForegroundPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                        <SolidColorBrush x:Key="NumberBoxSpinButtonBorderBrushPressed" Color="Transparent"/>

                        <!-- 8. Spin Up/Down Repeat Buttons (Disabled) -->
                        <SolidColorBrush x:Key="NumberBoxSpinButtonBackgroundDisabled" Color="Transparent"/>
                        <SolidColorBrush x:Key="NumberBoxSpinButtonForegroundDisabled" Color="#404040"/>
                        <SolidColorBrush x:Key="NumberBoxSpinButtonBorderBrushDisabled" Color="Transparent"/>

                        <!-- 9. Header / Label Foreground -->
                        <SolidColorBrush x:Key="NumberBoxHeaderForeground" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="NumberBoxHeaderForegroundDisabled" Color="#707070"/>

                        <!-- 10. Disabled NumberBox State -->
                        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#181818"/>
                        <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#505050"/>
                        <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#2A2A2A"/>
                    </NumberBox.Resources>
                </NumberBox>
                <NumberBox FontFamily="{StaticResource GlobalFontHolder}"    x:Name="numStereoDepth" Minimum="0" Maximum="100" Value="100" SpinButtonPlacementMode="Compact" Header="Stereo Depth %" Grid.Row="1" Grid.Column="1">
                    <NumberBox.Resources>
                        <!-- 1. Focused State (Accent Border & Caret) -->
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource GlobalAccentColor}"/>
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1E1E1E"/>
                        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFFFFF"/>

                        <!-- 2. Resting / Unfocused State -->
                        <SolidColorBrush x:Key="TextControlBackground" Color="#202020"/>
                        <SolidColorBrush x:Key="TextControlForeground" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="#404040"/>
                        <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#808080"/>

                        <!-- 3. Pointer Over (Hover) State -->
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#2A2A2A"/>
                        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#555555"/>

                        <!-- 4. Text Selection Highlight -->
                        <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="{StaticResource GlobalAccentColor}"/>

                        <!-- 5. Spin Up/Down Repeat Buttons (Resting) -->
                        <SolidColorBrush x:Key="NumberBoxSpinButtonBackground" Color="Transparent"/>
                        <SolidColorBrush x:Key="NumberBoxSpinButtonForeground" Color="#AAAAAA"/>
                        <SolidColorBrush x:Key="NumberBoxSpinButtonBorderBrush" Color="Transparent"/>

                        <!-- 6. Spin Up/Down Repeat Buttons (Pointer Over) -->
                        <SolidColorBrush x:Key="NumberBoxSpinButtonBackgroundPointerOver" Color="#303030"/>
                        <SolidColorBrush x:Key="NumberBoxSpinButtonForegroundPointerOver" Color="{StaticResource GlobalAccentColor}"/>
                        <SolidColorBrush x:Key="NumberBoxSpinButtonBorderBrushPointerOver" Color="Transparent"/>

                        <!-- 7. Spin Up/Down Repeat Buttons (Pressed) -->
                        <SolidColorBrush x:Key="NumberBoxSpinButtonBackgroundPressed" Color="#404040"/>
                        <SolidColorBrush x:Key="NumberBoxSpinButtonForegroundPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                        <SolidColorBrush x:Key="NumberBoxSpinButtonBorderBrushPressed" Color="Transparent"/>

                        <!-- 8. Spin Up/Down Repeat Buttons (Disabled) -->
                        <SolidColorBrush x:Key="NumberBoxSpinButtonBackgroundDisabled" Color="Transparent"/>
                        <SolidColorBrush x:Key="NumberBoxSpinButtonForegroundDisabled" Color="#404040"/>
                        <SolidColorBrush x:Key="NumberBoxSpinButtonBorderBrushDisabled" Color="Transparent"/>

                        <!-- 9. Header / Label Foreground -->
                        <SolidColorBrush x:Key="NumberBoxHeaderForeground" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="NumberBoxHeaderForegroundDisabled" Color="#707070"/>

                        <!-- 10. Disabled NumberBox State -->
                        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#181818"/>
                        <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#505050"/>
                        <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#2A2A2A"/>
                    </NumberBox.Resources>
                </NumberBox>
                <NumberBox FontFamily="{StaticResource GlobalFontHolder}"    x:Name="numPreDelay" Minimum="0" Maximum="500" Value="20" SpinButtonPlacementMode="Compact" Header="Pre-Delay (ms)" Grid.Row="2" Grid.Column="0">
                    <NumberBox.Resources>
                        <!-- 1. Focused State (Accent Border & Caret) -->
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource GlobalAccentColor}"/>
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1E1E1E"/>
                        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFFFFF"/>

                        <!-- 2. Resting / Unfocused State -->
                        <SolidColorBrush x:Key="TextControlBackground" Color="#202020"/>
                        <SolidColorBrush x:Key="TextControlForeground" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="#404040"/>
                        <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#808080"/>

