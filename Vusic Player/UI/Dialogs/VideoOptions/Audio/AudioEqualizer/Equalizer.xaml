<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Vusic_Player.UI.Dialogs.VideoOptions.Audio.AudioEqualizer.Equalizer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Vusic_Player.UI.Dialogs.VideoOptions.Audio.AudioEqualizer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:controls="using:Vusic_Player.UI.UserViews.Controls"
    mc:Ignorable="d">
    <UserControl.Resources>
        <local:GainDisplayConverter x:Key="GainDisplayConverter"/>
    </UserControl.Resources>
    <Grid RowSpacing="30">
        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <CheckBox  FontFamily="{StaticResource GlobalFontHolder}"    Checked="chkVerticalMode_Checked" Unchecked="chkVerticalMode_Checked" Content="Vertical Mode" Name="chkVerticalMode" Grid.Row="0">
            <CheckBox.Resources>
                <!-- Checked State (Background box fill) -->
                <SolidColorBrush x:Key="CheckBoxFillColorDefault" Color="{StaticResource GlobalAccentColor}"/>
                <SolidColorBrush x:Key="CheckBoxFillColorPointerOver" Color="{StaticResource GlobalAccentColorPointerOver}"/>
                <SolidColorBrush x:Key="CheckBoxFillColorPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                <SolidColorBrush x:Key="CheckBoxFillColorDisabled" Color="#2A2A2A"/>

                <!-- Checkmark Glyph Color (The tick mark inside the box) -->
                <SolidColorBrush x:Key="CheckBoxCheckGlyphForeground" Color="#000000"/>
                <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundPointerOver" Color="#000000"/>
                <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundPressed" Color="#000000"/>
                <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundDisabled" Color="#707070"/>

                <!-- Unchecked State (Empty box outline border) -->
                <SolidColorBrush x:Key="CheckBoxStrokeColorDefault" Color="#808080"/>
                <SolidColorBrush x:Key="CheckBoxStrokeColorPointerOver" Color="#B0B0B0"/>
                <SolidColorBrush x:Key="CheckBoxStrokeColorPressed" Color="#606060"/>

                <!-- Text Label Foreground -->
                <SolidColorBrush x:Key="CheckBoxForeground" Color="#FFFFFF"/>
                <SolidColorBrush x:Key="CheckBoxForegroundPointerOver" Color="#FFFFFF"/>
                <SolidColorBrush x:Key="CheckBoxForegroundPressed" Color="#CCCCCC"/>
            </CheckBox.Resources>
        </CheckBox>

        <StackPanel Orientation="Horizontal" Spacing="10" Grid.Row="1" HorizontalAlignment="Center">
            <TextBlock Text="Presets" Style="{StaticResource BodyStrongTextBlockStyle}"/>
            <ComboBox Name="cmbPresets" ItemsSource="{x:Bind inst.EqPresetsGlobal, Mode=OneWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding PresetName}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>
        <Grid Grid.Row="2" Visibility="Visible" RowSpacing="12" ColumnSpacing="16" Name="grdHorizontalSliders" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <!-- Frequency Label -->
                <ColumnDefinition Width="Auto"/>
                <!-- Slider -->
                <ColumnDefinition Width="Auto"/>
                <!-- Value Label -->
                <ColumnDefinition Width="60"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 31 Hz -->
            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Grid.Row="0" Grid.Column="0" Text="31 Hz" VerticalAlignment="Center"/>
            <controls:OceanSlider x:Name="gain31" Grid.Row="0" Grid.Column="1" Width="120" Minimum="-12" Maximum="12"
                          TicksEnabled="True" IsSnapToTickEnabled="True" TickFrequency="6"
                          IsTooltipEnabled="False" ValueChanged="gainCommon_ValueChanged"/>
            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"   Grid.Row="0" Grid.Column="2" VerticalAlignment="Center"
               Text="{x:Bind gain31.Value, Mode=OneWay, Converter={StaticResource GainDisplayConverter}}"/>

            <!-- 63 Hz -->
            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Grid.Row="1" Grid.Column="0" Text="63 Hz" VerticalAlignment="Center"/>
            <controls:OceanSlider x:Name="gain63" Grid.Row="1" Grid.Column="1" Width="120" Minimum="-12" Maximum="12"
                          TicksEnabled="True" IsSnapToTickEnabled="True" TickFrequency="6"
                          IsTooltipEnabled="False" ValueChanged="gainCommon_ValueChanged"/>
            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Grid.Row="1" Grid.Column="2" VerticalAlignment="Center"
               Text="{x:Bind gain63.Value, Mode=OneWay, Converter={StaticResource GainDisplayConverter}}"/>

            <!-- 125 Hz -->
            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Grid.Row="2" Grid.Column="0" Text="125 Hz" VerticalAlignment="Center"/>
            <controls:OceanSlider x:Name="gain125" Grid.Row="2" Grid.Column="1" Width="120" Minimum="-12" Maximum="12"
                          TicksEnabled="True" IsSnapToTickEnabled="True" TickFrequency="6"
                          IsTooltipEnabled="False" ValueChanged="gainCommon_ValueChanged"/>
            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Grid.Row="2" Grid.Column="2" VerticalAlignment="Center"
               Text="{x:Bind gain125.Value, Mode=OneWay, Converter={StaticResource GainDisplayConverter}}"/>

            <!-- 250 Hz -->
            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Grid.Row="3" Grid.Column="0" Text="250 Hz" VerticalAlignment="Center"/>
            <controls:OceanSlider x:Name="gain250" Grid.Row="3" Grid.Column="1" Width="120" Minimum="-12" Maximum="12"
                          TicksEnabled="True" IsSnapToTickEnabled="True" TickFrequency="6"
                          IsTooltipEnabled="False" ValueChanged="gainCommon_ValueChanged"/>
            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Grid.Row="3" Grid.Column="2" VerticalAlignment="Center"
               Text="{x:Bind gain250.Value, Mode=OneWay, Converter={StaticResource GainDisplayConverter}}"/>

            <!-- 500 Hz -->
            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Grid.Row="4" Grid.Column="0" Text="500 Hz" VerticalAlignment="Center"/>
            <controls:OceanSlider x:Name="gain500" Grid.Row="4" Grid.Column="1" Width="120" Minimum="-12" Maximum="12"
                          TicksEnabled="True" IsSnapToTickEnabled="True" TickFrequency="6"
                          IsTooltipEnabled="False" ValueChanged="gainCommon_ValueChanged"/>
            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Grid.Row="4" Grid.Column="2" VerticalAlignment="Center"
               Text="{x:Bind gain500.Value, Mode=OneWay, Converter={StaticResource GainDisplayConverter}}"/>

            <!-- 1 kHz -->
            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Grid.Row="5" Grid.Column="0" Text="1 kHz" VerticalAlignment="Center"/>
            <controls:OceanSlider x:Name="gain1000" Grid.Row="5" Grid.Column="1" Width="120" Minimum="-12" Maximum="12"
                          TicksEnabled="True" IsSnapToTickEnabled="True" TickFrequency="6"
                          IsTooltipEnabled="False" ValueChanged="gainCommon_ValueChanged"/>
            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Grid.Row="5" Grid.Column="2" VerticalAlignment="Center"
               Text="{x:Bind gain1000.Value, Mode=OneWay, Converter={StaticResource GainDisplayConverter}}"/>

            <!-- 2 kHz -->
            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Grid.Row="6" Grid.Column="0" Text="2 kHz" VerticalAlignment="Center"/>
            <controls:OceanSlider x:Name="gain2000" Grid.Row="6" Grid.Column="1" Width="120" Minimum="-12" Maximum="12"
                          TicksEnabled="True" IsSnapToTickEnabled="True" TickFrequency="6"
                          IsTooltipEnabled="False" ValueChanged="gainCommon_ValueChanged"/>
            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Grid.Row="6" Grid.Column="2" VerticalAlignment="Center"
               Text="{x:Bind gain2000.Value, Mode=OneWay, Converter={StaticResource GainDisplayConverter}}"/>

            <!-- 4 kHz -->
            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Grid.Row="7" Grid.Column="0" Text="4 kHz" VerticalAlignment="Center"/>
            <controls:OceanSlider x:Name="gain4000" Grid.Row="7" Grid.Column="1" Width="120" Minimum="-12" Maximum="12"
                          TicksEnabled="True" IsSnapToTickEnabled="True" TickFrequency="6"
                          IsTooltipEnabled="False" ValueChanged="gainCommon_ValueChanged"/>
            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Grid.Row="7" Grid.Column="2" VerticalAlignment="Center"
               Text="{x:Bind gain4000.Value, Mode=OneWay, Converter={StaticResource GainDisplayConverter}}"/>

            <!-- 8 kHz -->
            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Grid.Row="8" Grid.Column="0" Text="8 kHz" VerticalAlignment="Center"/>
            <controls:OceanSlider x:Name="gain8000" Grid.Row="8" Grid.Column="1" Width="120" Minimum="-12" Maximum="12"
                          TicksEnabled="True" IsSnapToTickEnabled="True" TickFrequency="6"
                          IsTooltipEnabled="False" ValueChanged="gainCommon_ValueChanged"/>
            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Grid.Row="8" Grid.Column="2" VerticalAlignment="Center"
               Text="{x:Bind gain8000.Value, Mode=OneWay, Converter={StaticResource GainDisplayConverter}}"/>

            <!-- 16 kHz -->
            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Grid.Row="9" Grid.Column="0" Text="16 kHz" VerticalAlignment="Center"/>
            <controls:OceanSlider x:Name="gain16000" Grid.Row="9" Grid.Column="1" Width="120" Minimum="-12" Maximum="12"
                          TicksEnabled="True" IsSnapToTickEnabled="True" TickFrequency="6"
                          IsTooltipEnabled="False" ValueChanged="gainCommon_ValueChanged"/>
            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Grid.Row="9" Grid.Column="2" VerticalAlignment="Center"
               Text="{x:Bind gain16000.Value, Mode=OneWay, Converter={StaticResource GainDisplayConverter}}"/>
        </Grid>
        <Grid Visibility="Collapsed" 
      Grid.Row="2" 
      RowSpacing="16" 
      ColumnSpacing="8" 
      Name="grdVerticalSliders" 
      HorizontalAlignment="Stretch">

            <!-- 2 tiers of sliders: Row 0-2 (Lower Bands), Row 3 (Spacer), Row 4-6 (Upper Bands) -->
            <Grid.RowDefinitions>
                <!-- Top Half (31 Hz - 500 Hz) -->
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <!-- Divider spacing between tiers -->
                <RowDefinition Height="12"/>
                <!-- Bottom Half (1 kHz - 16 kHz) -->
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 5 equal columns -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ==================== TIER 1: 31 Hz - 500 Hz ==================== -->

            <!-- 31 Hz -->
            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" FontSize="11"
               Text="{x:Bind gain31Vertical.Value, Mode=OneWay, Converter={StaticResource GainDisplayConverter}}"/>
            <controls:OceanSlider Width="100" Height="120" x:Name="gain31Vertical" Grid.Row="1" Grid.Column="0" Minimum="-12" Maximum="12"
                          TicksEnabled="True" IsSnapToTickEnabled="True" Orientation="Vertical" TickFrequency="6"
                          IsTooltipEnabled="False" HorizontalAlignment="Center"/>
            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Grid.Row="2" Grid.Column="0" Text="31 Hz" HorizontalAlignment="Center" FontSize="11"/>

            <!-- 63 Hz -->
            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" FontSize="11"
               Text="{x:Bind gain63Vertical.Value, Mode=OneWay, Converter={StaticResource GainDisplayConverter}}"/>
            <controls:OceanSlider Width="100" Height="120" x:Name="gain63Vertical" Grid.Row="1" Grid.Column="1" Minimum="-12" Maximum="12"
                          TicksEnabled="True" IsSnapToTickEnabled="True" Orientation="Vertical" TickFrequency="6"
                          IsTooltipEnabled="False" HorizontalAlignment="Center"/>
            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Grid.Row="2" Grid.Column="1" Text="63 Hz" HorizontalAlignment="Center" FontSize="11"/>

            <!-- 125 Hz -->
            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Grid.Row="0" Grid.Column="2" HorizontalAlignment="Center" FontSize="11"
               Text="{x:Bind gain125Vertical.Value, Mode=OneWay, Converter={StaticResource GainDisplayConverter}}"/>
            <controls:OceanSlider   Width="100" Height="120" x:Name="gain125Vertical" Grid.Row="1" Grid.Column="2" Minimum="-12" Maximum="12"
                          TicksEnabled="True" IsSnapToTickEnabled="True" Orientation="Vertical" TickFrequency="6"
                          IsTooltipEnabled="False" HorizontalAlignment="Center"/>
            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Grid.Row="2" Grid.Column="2" Text="125 Hz" HorizontalAlignment="Center" FontSize="11"/>

            <!-- 250 Hz -->
            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Grid.Row="0" Grid.Column="3" HorizontalAlignment="Center" FontSize="11"
               Text="{x:Bind gain250Vertical.Value, Mode=OneWay, Converter={StaticResource GainDisplayConverter}}"/>
            <controls:OceanSlider Height="120" Width="100" x:Name="gain250Vertical" Grid.Row="1" Grid.Column="3" Minimum="-12" Maximum="12"
                          TicksEnabled="True" IsSnapToTickEnabled="True" Orientation="Vertical" TickFrequency="6"
                          IsTooltipEnabled="False" HorizontalAlignment="Center"/>
            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Grid.Row="2" Grid.Column="3" Text="250 Hz" HorizontalAlignment="Center" FontSize="11"/>

            <!-- 500 Hz -->
            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Grid.Row="0" Grid.Column="4" HorizontalAlignment="Center" FontSize="11"
               Text="{x:Bind gain500Vertical.Value, Mode=OneWay, Converter={StaticResource GainDisplayConverter}}"/>
            <controls:OceanSlider  Height="120" Width="100" x:Name="gain500Vertical" Grid.Row="1" Grid.Column="4" Minimum="-12" Maximum="12"
                          TicksEnabled="True" IsSnapToTickEnabled="True" Orientation="Vertical" TickFrequency="6"
                          IsTooltipEnabled="False" HorizontalAlignment="Center"/>
            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Grid.Row="2" Grid.Column="4" Text="500 Hz" HorizontalAlignment="Center" FontSize="11"/>

            <!-- Optional Divider Line between rows -->
            <Rectangle Grid.Row="3" Grid.ColumnSpan="5" Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Center" Margin="8,0"/>

            <!-- ==================== TIER 2: 1 kHz - 16 kHz ==================== -->

            <!-- 1 kHz -->
            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Grid.Row="4" Grid.Column="0" HorizontalAlignment="Center" FontSize="11"
               Text="{x:Bind gain1000Vertical.Value, Mode=OneWay, Converter={StaticResource GainDisplayConverter}}"/>
            <controls:OceanSlider Width="100" Height="120" x:Name="gain1000Vertical" Grid.Row="5" Grid.Column="0" Minimum="-12" Maximum="12"
                          TicksEnabled="True" IsSnapToTickEnabled="True" Orientation="Vertical" TickFrequency="6"
                          IsTooltipEnabled="False" HorizontalAlignment="Center"/>
            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Grid.Row="6" Grid.Column="0" Text="1 kHz" HorizontalAlignment="Center" FontSize="11"/>

            <!-- 2 kHz -->
            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Grid.Row="4" Grid.Column="1" HorizontalAlignment="Center" FontSize="11"
               Text="{x:Bind gain2000Vertical.Value, Mode=OneWay, Converter={StaticResource GainDisplayConverter}}"/>
            <controls:OceanSlider Width="100" Height="120" x:Name="gain2000Vertical" Grid.Row="5" Grid.Column="1" Minimum="-12" Maximum="12"
                          TicksEnabled="True" IsSnapToTickEnabled="True" Orientation="Vertical" TickFrequency="6"
                          IsTooltipEnabled="False" HorizontalAlignment="Center"/>
            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Grid.Row="6" Grid.Column="1" Text="2 kHz" HorizontalAlignment="Center" FontSize="11"/>

            <!-- 4 kHz -->
            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Grid.Row="4" Grid.Column="2" HorizontalAlignment="Center" FontSize="11"
               Text="{x:Bind gain4000Vertical.Value, Mode=OneWay, Converter={StaticResource GainDisplayConverter}}"/>
            <controls:OceanSlider Width="100" Height="120" x:Name="gain4000Vertical" Grid.Row="5" Grid.Column="2" Minimum="-12" Maximum="12"
                          TicksEnabled="True" IsSnapToTickEnabled="True" Orientation="Vertical" TickFrequency="6"
                          IsTooltipEnabled="False" HorizontalAlignment="Center"/>
            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Grid.Row="6" Grid.Column="2" Text="4 kHz" HorizontalAlignment="Center" FontSize="11"/>

            <!-- 8 kHz -->
            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Grid.Row="4" Grid.Column="3" HorizontalAlignment="Center" FontSize="11"
               Text="{x:Bind gain8000Vertical.Value, Mode=OneWay, Converter={StaticResource GainDisplayConverter}}"/>
            <controls:OceanSlider Width="100" Height="120" x:Name="gain8000Vertical" Grid.Row="5" Grid.Column="3" Minimum="-12" Maximum="12"
                          TicksEnabled="True" IsSnapToTickEnabled="True" Orientation="Vertical" TickFrequency="6"
                          IsTooltipEnabled="False" HorizontalAlignment="Center"/>
            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Grid.Row="6" Grid.Column="3" Text="8 kHz" HorizontalAlignment="Center" FontSize="11"/>

            <!-- 16 kHz -->
            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Grid.Row="4" Grid.Column="4" HorizontalAlignment="Center" FontSize="11"
               Text="{x:Bind gain16000Vertical.Value, Mode=OneWay, Converter={StaticResource GainDisplayConverter}}"/>
            <controls:OceanSlider Width="100" Height="120" x:Name="gain16000Vertical" Grid.Row="5" Grid.Column="4" Minimum="-12" Maximum="12"
                          TicksEnabled="True" IsSnapToTickEnabled="True" Orientation="Vertical" TickFrequency="6"
                          IsTooltipEnabled="False" HorizontalAlignment="Center"/>
            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Grid.Row="6" Grid.Column="4" Text="16 kHz" HorizontalAlignment="Center" FontSize="11"/>
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="10" Grid.Row="3" HorizontalAlignment="Center">
            <Button  FontFamily="{StaticResource GlobalFontHolder}"  HorizontalAlignment="Center" Name="btnApply" Content="Apply" Click="btnApply_Click" Grid.Row="2" Style="{StaticResource AccentButtonStyle}" Background="{StaticResource GlobalAccentColor}" >
                <Button.Resources>
                    <SolidColorBrush x:Key="AccentButtonBackground" Color="{StaticResource GlobalAccentColor}"/>
                    <SolidColorBrush x:Key="AccentButtonForeground" Color="#0B0D13"/>
                    <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent"/>

                    <!-- Pointer Over (Hover) -->
                    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{StaticResource GlobalAccentColorPointerOver}"/>
                    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#0B0D13"/>
                    <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="Transparent"/>

                    <!-- Pressed State -->
                    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="Transparent"/>

                    <!-- Disabled State -->
                    <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#2A2A2A"/>
                    <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#707070"/>
                    <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="Transparent"/>
                </Button.Resources>
            </Button>
            <Button Content="Save Preset" Name="btnSavePreset" Click="btnSavePreset_Click" FontFamily="{StaticResource GlobalFontHolder}" />
        </StackPanel>
        <TeachingTip Name="ttPresetName">
            <StackPanel Orientation="Vertical" Spacing="10">
                <TextBox PlaceholderText="Enter preset name..." Name="txtPresetName">
                    <TextBox.Resources>
                        <!-- 1. Focused State (Accent Highlight on Border & Caret) -->
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource GlobalAccentColor}"/>
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1E1E1E"/>
                        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="TextControlButtonForegroundFocused" Color="{StaticResource GlobalAccentColor}"/>

                        <!-- 2. Resting / Unfocused State -->
                        <SolidColorBrush x:Key="TextControlBackground" Color="#202020"/>
                        <SolidColorBrush x:Key="TextControlForeground" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="#404040"/>
                        <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#808080"/>

                        <!-- 3. Pointer Over (Hover) State -->
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#2A2A2A"/>
                        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#555555"/>
                        <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#999999"/>

                        <!-- 4. Text Selection Highlight (Highlight color when selecting text) -->
                        <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="{StaticResource GlobalAccentColor}"/>

                        <!-- 5. Inner Clear / Action Button (The "X" delete button) -->
                        <SolidColorBrush x:Key="TextControlButtonBackground" Color="Transparent"/>
                        <SolidColorBrush x:Key="TextControlButtonBackgroundPointerOver" Color="#303030"/>
                        <SolidColorBrush x:Key="TextControlButtonBackgroundPressed" Color="#404040"/>
                        <SolidColorBrush x:Key="TextControlButtonForeground" Color="#808080"/>
                        <SolidColorBrush x:Key="TextControlButtonForegroundPointerOver" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="TextControlButtonForegroundPressed" Color="#FFFFFF"/>

                        <!-- 6. Disabled State -->
                        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#181818"/>
                        <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#505050"/>
                        <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#2A2A2A"/>
                        <SolidColorBrush x:Key="TextControlPlaceholderForegroundDisabled" Color="#404040"/>
                    </TextBox.Resources>
                </TextBox>
                <Button Style="{StaticResource AccentButtonStyle}" Name="btnCreatePreset" Click="btnCreatePreset_Click" ToolTipService.ToolTip="Create Preset" Background="{StaticResource GlobalAccentColor}" >
                    <Button.Resources>
                        <SolidColorBrush x:Key="AccentButtonBackground" Color="{StaticResource GlobalAccentColor}"/>
                        <SolidColorBrush x:Key="AccentButtonForeground" Color="#0B0D13"/>
                        <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent"/>

                        <!-- Pointer Over (Hover) -->
                        <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{StaticResource GlobalAccentColorPointerOver}"/>
                        <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#0B0D13"/>
                        <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="Transparent"/>

                        <!-- Pressed State -->
                        <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                        <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="Transparent"/>

                        <!-- Disabled State -->
                        <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#2A2A2A"/>
                        <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#707070"/>
                        <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="Transparent"/>
                    </Button.Resources>
                <Image Source="{Binding TickIcon, Source={StaticResource GlobalIconHolder}}" Width="25"/>
                </Button>
            </StackPanel>
        </TeachingTip>
    </Grid>
</UserControl>
