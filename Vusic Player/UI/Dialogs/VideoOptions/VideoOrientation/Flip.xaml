<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Vusic_Player.UI.Dialogs.VideoOptions.VideoOrientation.Flip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Vusic_Player.UI.Dialogs.VideoOptions.VideoOrientation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Name="stkFlip" Spacing="12">
        <TextBlock FontFamily="{StaticResource GlobalFontHolder}"    Text="Mirroring" Style="{StaticResource BodyStrongTextBlockStyle}"/>
        <StackPanel Orientation="Horizontal" Spacing="10">
            <ToggleButton  FontFamily="{StaticResource GlobalFontHolder}"   Name="btnFlipHorizontal" Content="Flip Horizontal" Checked="btnFlipHorizontal_Checked" Unchecked="btnFlipHorizontal_Unchecked" Padding="12,8">
                <ToggleButton.Resources>
                    <!-- 1. Background Fill when CHECKED -->
                    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{StaticResource GlobalAccentColor}"/>
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{StaticResource GlobalAccentColorPointerOver}"/>
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedDisabled" Color="#2A2A2A"/>

                    <!-- 2. Text / Icon Foreground when CHECKED -->
                    <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#000000"/>
                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#000000"/>
                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#000000"/>
                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedDisabled" Color="#707070"/>

                    <!-- 3. Border Stroke when CHECKED -->
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent"/>
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent"/>
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedDisabled" Color="Transparent"/>

                    <!-- 4. Background Fill when UNCHECKED -->
                    <SolidColorBrush x:Key="ToggleButtonBackground" Color="#202020"/>
                    <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#2D2D2D"/>
                    <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#181818"/>
                    <SolidColorBrush x:Key="ToggleButtonBackgroundDisabled" Color="#1E1E1E"/>

                    <!-- 5. Text / Icon Foreground when UNCHECKED -->
                    <SolidColorBrush x:Key="ToggleButtonForeground" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="ToggleButtonForegroundPointerOver" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="ToggleButtonForegroundPressed" Color="#CCCCCC"/>
                    <SolidColorBrush x:Key="ToggleButtonForegroundDisabled" Color="#505050"/>

                    <!-- 6. Border Stroke when UNCHECKED -->
                    <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="#404040"/>
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="#555555"/>
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="#303030"/>
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushDisabled" Color="#2A2A2A"/>
                </ToggleButton.Resources>
            </ToggleButton>
            <ToggleButton  FontFamily="{StaticResource GlobalFontHolder}"   Name="btnFlipVertical" Content="Flip Vertical" Checked="btnFlipVertical_Checked" Unchecked="btnFlipVertical_Unchecked" Padding="12,8">
                <ToggleButton.Resources>
                    <!-- 1. Background Fill when CHECKED -->
                    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{StaticResource GlobalAccentColor}"/>
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{StaticResource GlobalAccentColorPointerOver}"/>
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedDisabled" Color="#2A2A2A"/>

                    <!-- 2. Text / Icon Foreground when CHECKED -->
                    <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#000000"/>
                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#000000"/>
                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#000000"/>
                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedDisabled" Color="#707070"/>

                    <!-- 3. Border Stroke when CHECKED -->
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent"/>
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent"/>
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent"/>
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedDisabled" Color="Transparent"/>

                    <!-- 4. Background Fill when UNCHECKED -->
                    <SolidColorBrush x:Key="ToggleButtonBackground" Color="#202020"/>
                    <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#2D2D2D"/>
                    <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#181818"/>
                    <SolidColorBrush x:Key="ToggleButtonBackgroundDisabled" Color="#1E1E1E"/>

                    <!-- 5. Text / Icon Foreground when UNCHECKED -->
                    <SolidColorBrush x:Key="ToggleButtonForeground" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="ToggleButtonForegroundPointerOver" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="ToggleButtonForegroundPressed" Color="#CCCCCC"/>
                    <SolidColorBrush x:Key="ToggleButtonForegroundDisabled" Color="#505050"/>

                    <!-- 6. Border Stroke when UNCHECKED -->
                    <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="#404040"/>
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="#555555"/>
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="#303030"/>
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushDisabled" Color="#2A2A2A"/>
                </ToggleButton.Resources>
            </ToggleButton>
        </StackPanel>
    </StackPanel>
</UserControl>
