<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Vusic_Player.UI.Dialogs.VideoOptions.VideoAspectRatio.AspectRatioCustom"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Vusic_Player.UI.Dialogs.VideoOptions.VideoAspectRatio"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Orientation="Vertical" Spacing="10">
        <TextBlock FontFamily="{StaticResource GlobalFontHolder}"    Text="Custom Ratio" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>

        <Grid ColumnSpacing="8" Name="grdcustomAspectRatio">
            <Grid.ColumnDefinitions>

            </Grid.ColumnDefinitions>

            <StackPanel  Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <NumberBox FontFamily="{StaticResource GlobalFontHolder}"    x:Name="numARWidth" 
               Header="Width" 
               Value="{x:Bind AspectValues.Width, Mode=OneWay}" 
               SpinButtonPlacementMode="Compact" 
               ValueChanged="numARWidth_ValueChanged"/>

                    <TextBlock FontFamily="{StaticResource GlobalFontHolder}"    Text=":" 
               VerticalAlignment="Bottom" 
               Margin="0,0,0,8" 
               Style="{StaticResource BodyStrongTextBlockStyle}"/>

                    <NumberBox FontFamily="{StaticResource GlobalFontHolder}"    x:Name="numARHeight" 
               Header="Height" 
     Value="{x:Bind AspectValues.Height, Mode=OneWay}" 
               SpinButtonPlacementMode="Compact" 
               ValueChanged="numARHeight_ValueChanged"/>
                </StackPanel>
                <CheckBox FontFamily="{StaticResource GlobalFontHolder}"    Visibility="Collapsed" x:Name="LockRatioCheckBox" Checked="LockRatioCheckBox_Checked" Unchecked="LockRatioCheckBox_Unchecked"
              Content="Lock Aspect Ratio" 
              IsChecked="False" 
              VerticalAlignment="Bottom" 
              Margin="8,0,0,4">
                    <CheckBox.Resources>
                        <!-- Checked State (Background box fill) -->
                        <SolidColorBrush x:Key="CheckBoxFillColorDefault" Color="{StaticResource GlobalAccentColor}"/>
                        <SolidColorBrush x:Key="CheckBoxFillColorPointerOver" Color="{StaticResource GlobalAccentColorPointerOver}"/>
                        <SolidColorBrush x:Key="CheckBoxFillColorPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                        <SolidColorBrush x:Key="CheckBoxFillColorDisabled" Color="#2A2A2A"/>

                        <!-- Checkmark Glyph Color (The tick mark inside the box) -->
                        <SolidColorBrush x:Key="CheckBoxCheckGlyphForeground" Color="#000000"/>
                        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundPointerOver" Color="#000000"/>
                        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundPressed" Color="#000000"/>
                        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundDisabled" Color="#707070"/>

                        <!-- Unchecked State (Empty box outline border) -->
                        <SolidColorBrush x:Key="CheckBoxStrokeColorDefault" Color="#808080"/>
                        <SolidColorBrush x:Key="CheckBoxStrokeColorPointerOver" Color="#B0B0B0"/>
                        <SolidColorBrush x:Key="CheckBoxStrokeColorPressed" Color="#606060"/>

                        <!-- Text Label Foreground -->
                        <SolidColorBrush x:Key="CheckBoxForeground" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="CheckBoxForegroundPointerOver" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="CheckBoxForegroundPressed" Color="#CCCCCC"/>
                    </CheckBox.Resources>
                </CheckBox>

                <CheckBox FontFamily="{StaticResource GlobalFontHolder}"    Visibility="Collapsed" x:Name="RoundToIntegersCheckBox" 
Content="Round off to nearest whole number" Checked="RoundToIntegersCheckBox_Checked" Unchecked="RoundToIntegersCheckBox_Unchecked"
IsChecked="False" 
VerticalAlignment="Bottom" 
Margin="8,0,0,4">
                    <CheckBox.Resources>
                        <!-- Checked State (Background box fill) -->
                        <SolidColorBrush x:Key="CheckBoxFillColorDefault" Color="{StaticResource GlobalAccentColor}"/>
                        <SolidColorBrush x:Key="CheckBoxFillColorPointerOver" Color="{StaticResource GlobalAccentColorPointerOver}"/>
                        <SolidColorBrush x:Key="CheckBoxFillColorPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                        <SolidColorBrush x:Key="CheckBoxFillColorDisabled" Color="#2A2A2A"/>

                        <!-- Checkmark Glyph Color (The tick mark inside the box) -->
                        <SolidColorBrush x:Key="CheckBoxCheckGlyphForeground" Color="#000000"/>
                        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundPointerOver" Color="#000000"/>
                        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundPressed" Color="#000000"/>
                        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundDisabled" Color="#707070"/>

                        <!-- Unchecked State (Empty box outline border) -->
                        <SolidColorBrush x:Key="CheckBoxStrokeColorDefault" Color="#808080"/>
                        <SolidColorBrush x:Key="CheckBoxStrokeColorPointerOver" Color="#B0B0B0"/>
                        <SolidColorBrush x:Key="CheckBoxStrokeColorPressed" Color="#606060"/>

                        <!-- Text Label Foreground -->
                        <SolidColorBrush x:Key="CheckBoxForeground" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="CheckBoxForegroundPointerOver" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="CheckBoxForegroundPressed" Color="#CCCCCC"/>
                    </CheckBox.Resources>
                </CheckBox>

                <Button FontFamily="{StaticResource GlobalFontHolder}"    Content="Set Ratio" Name="btnSetCustomRatio" Margin="0, 5" VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}" Click="btnSetCustomRatio_Click" Background="{StaticResource GlobalAccentColor}" >
                    <Button.Resources>
                        <SolidColorBrush x:Key="AccentButtonBackground" Color="{StaticResource GlobalAccentColor}"/>
                        <SolidColorBrush x:Key="AccentButtonForeground" Color="#0B0D13"/>
                        <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent"/>

                        <!-- Pointer Over (Hover) -->
                        <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{StaticResource GlobalAccentColorPointerOver}"/>
                        <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#0B0D13"/>
                        <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="Transparent"/>

                        <!-- Pressed State -->
                        <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                        <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="Transparent"/>

                        <!-- Disabled State -->
                        <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#2A2A2A"/>
                        <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#707070"/>
                        <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="Transparent"/>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
