<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Vusic_Player.UI.Dialogs.VideoOptions.VideoOverlay.WatermarkOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Vusic_Player.UI.Dialogs.VideoOptions.VideoOverlay"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <UserControl.Resources>
        <local:CountToVisibility x:Key="CountToVisConverter"/>
    </UserControl.Resources>
    <Grid RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="20">
            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"    Text="Watermark Overlay" Style="{StaticResource BodyLargeStrongTextBlockStyle}"/>
            <CheckBox FontFamily="{StaticResource GlobalFontHolder}"    Content="Show Watermark Values" Name="chkShowWatermarkValues" Checked="chkShowWatermarkValues_Checked" Unchecked="chkShowWatermarkValues_Checked">
                <CheckBox.Resources>
                    <!-- Checked State (Background box fill) -->
                    <SolidColorBrush x:Key="CheckBoxFillColorDefault" Color="{StaticResource GlobalAccentColor}"/>
                    <SolidColorBrush x:Key="CheckBoxFillColorPointerOver" Color="{StaticResource GlobalAccentColorPointerOver}"/>
                    <SolidColorBrush x:Key="CheckBoxFillColorPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                    <SolidColorBrush x:Key="CheckBoxFillColorDisabled" Color="#2A2A2A"/>

                    <!-- Checkmark Glyph Color (The tick mark inside the box) -->
                    <SolidColorBrush x:Key="CheckBoxCheckGlyphForeground" Color="#000000"/>
                    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundPointerOver" Color="#000000"/>
                    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundPressed" Color="#000000"/>
                    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundDisabled" Color="#707070"/>

                    <!-- Unchecked State (Empty box outline border) -->
                    <SolidColorBrush x:Key="CheckBoxStrokeColorDefault" Color="#808080"/>
                    <SolidColorBrush x:Key="CheckBoxStrokeColorPointerOver" Color="#B0B0B0"/>
                    <SolidColorBrush x:Key="CheckBoxStrokeColorPressed" Color="#606060"/>

                    <!-- Text Label Foreground -->
                    <SolidColorBrush x:Key="CheckBoxForeground" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="CheckBoxForegroundPointerOver" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="CheckBoxForegroundPressed" Color="#CCCCCC"/>
                </CheckBox.Resources>
            </CheckBox>

        </StackPanel>
        <TextBlock FontFamily="{StaticResource GlobalFontHolder}"    Name="txtDisplay1" Text="Display a watermark overlay with custom text or a running timecode on the video." Grid.Row="1"/>
        <TextBlock FontFamily="{StaticResource GlobalFontHolder}"    Name="txtDisplay2" Text="Add upto 9 Watermark Labels" Grid.Row="2" Style="{StaticResource BodyStrongTextBlockStyle}"/>
        <Grid Name="grdMain1" RowSpacing="20" Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button FontFamily="{StaticResource GlobalFontHolder}"    Content="Add new Label to Display"  Name="btnNewTimeCodedLabel" Visibility="Visible" Click="btnNewTimeCodedLabel_Click"/>
                <CheckBox FontFamily="{StaticResource GlobalFontHolder}"    Name="chkSaveWatermarkValues" Checked="chkSaveWatermarkValues_Checked" Unchecked="chkSaveWatermarkValues_Checked" Content="Save watermark values for every video">
                    <CheckBox.Resources>
                        <!-- Checked State (Background box fill) -->
                        <SolidColorBrush x:Key="CheckBoxFillColorDefault" Color="{StaticResource GlobalAccentColor}"/>
                        <SolidColorBrush x:Key="CheckBoxFillColorPointerOver" Color="{StaticResource GlobalAccentColorPointerOver}"/>
                        <SolidColorBrush x:Key="CheckBoxFillColorPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                        <SolidColorBrush x:Key="CheckBoxFillColorDisabled" Color="#2A2A2A"/>

                        <!-- Checkmark Glyph Color (The tick mark inside the box) -->
                        <SolidColorBrush x:Key="CheckBoxCheckGlyphForeground" Color="#000000"/>
                        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundPointerOver" Color="#000000"/>
                        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundPressed" Color="#000000"/>
                        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundDisabled" Color="#707070"/>

                        <!-- Unchecked State (Empty box outline border) -->
                        <SolidColorBrush x:Key="CheckBoxStrokeColorDefault" Color="#808080"/>
                        <SolidColorBrush x:Key="CheckBoxStrokeColorPointerOver" Color="#B0B0B0"/>
                        <SolidColorBrush x:Key="CheckBoxStrokeColorPressed" Color="#606060"/>

                        <!-- Text Label Foreground -->
                        <SolidColorBrush x:Key="CheckBoxForeground" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="CheckBoxForegroundPointerOver" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="CheckBoxForegroundPressed" Color="#CCCCCC"/>
                    </CheckBox.Resources>
                </CheckBox>

            </StackPanel>
        </Grid>
        <Grid Name="grdMain2" Grid.Row="4" ColumnSpacing="30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
         
                <ListView SelectionChanged="lstViewAddedTimeCodeLabels_SelectionChanged" 
          ItemsSource="{x:Bind timestamplabels, Mode=OneWay}" 
          Grid.Row="1" 
          Name="lstViewAddedTimeCodeLabels">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="50" Background="Transparent">
                                        <!-- Right-click Context Menu -->
                                        <Grid.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Remove" 
                                        Icon="Delete" 
                                        Click="MenuFlyoutItem_Remove_Click"/>
                                            </MenuFlyout>
                                        </Grid.ContextFlyout>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                            <TextBlock VerticalAlignment="Center" Text="{Binding Label}" FontFamily="{StaticResource GlobalFontHolder}"   />
                            <TextBlock VerticalAlignment="Center"  FontFamily="{StaticResource GlobalFontHolder}"   
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                           Text="{Binding Position}" 
                           Grid.Column="1"/>

                                        <!-- CheckBox with TwoWay binding and Checked/Unchecked events -->
                                        <CheckBox Content="Show" 
                          Grid.Column="2"  FontFamily="{StaticResource GlobalFontHolder}"   
                          IsChecked="{Binding IsShown, Mode=TwoWay}"
                          Checked="chkShow_Checked" 
                          Unchecked="chkShow_Unchecked">
                                <CheckBox.Resources>
                                    <!-- Checked State (Background box fill) -->
                                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="{StaticResource GlobalAccentColor}"/>
                                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="{StaticResource GlobalAccentColorPointerOver}"/>
                                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedDisabled" Color="#2A2A2A"/>

                                    <!-- Checkmark Glyph Color (The tick mark inside the box) -->
                                    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#000000"/>
                                    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#000000"/>
                                    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#000000"/>
                                    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedDisabled" Color="#707070"/>

                                    <!-- Unchecked State (Empty box outline border) -->
                                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked" Color="Transparent"/>
                                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="#808080"/>
                                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" Color="#B0B0B0"/>                                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPressed" Color="#606060"/> 

                                    <!-- Text Label Foreground -->
                                    <SolidColorBrush x:Key="CheckBoxForeground" Color="#FFFFFF"/>
                                    <SolidColorBrush x:Key="CheckBoxForegroundPointerOver" Color="#FFFFFF"/>
                                    <SolidColorBrush x:Key="CheckBoxForegroundPressed" Color="#CCCCCC"/>
                                </CheckBox.Resources>
                            </CheckBox>

                        </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    
            <StackPanel  VerticalAlignment="Center" Visibility="{x:Bind timestamplabels.Count, Mode=OneWay, Converter={StaticResource CountToVisConverter}}" Grid.Column="1" Orientation="Vertical" Spacing="10" Grid.Row="4">
                <ComboBox FontFamily="{StaticResource GlobalFontHolder}"    Name="cmbPosition" SelectionChanged="cmbPosition_SelectionChanged" Grid.Row="4" SelectedIndex="0" VerticalAlignment="Center" Header="Position">
                    <ComboBox.Items>
                        <ComboBoxItem FontFamily="{StaticResource GlobalFontHolder}"  Content="Top Left"/>
                        <ComboBoxItem FontFamily="{StaticResource GlobalFontHolder}"  Content="Top Center"/>
                        <ComboBoxItem FontFamily="{StaticResource GlobalFontHolder}"  Content="Top Right"/>
                        <ComboBoxItem FontFamily="{StaticResource GlobalFontHolder}"  Content="Left"/>
                        <ComboBoxItem FontFamily="{StaticResource GlobalFontHolder}"  Content="Center"/>
                        <ComboBoxItem FontFamily="{StaticResource GlobalFontHolder}"  Content="Right"/>
                        <ComboBoxItem FontFamily="{StaticResource GlobalFontHolder}"  Content="Bottom Left"/>
                        <ComboBoxItem FontFamily="{StaticResource GlobalFontHolder}"  Content="Bottom Center"/>
                        <ComboBoxItem FontFamily="{StaticResource GlobalFontHolder}"  Content="Bottom Right"/>
                    </ComboBox.Items>
                </ComboBox>
                <ComboBox FontFamily="{StaticResource GlobalFontHolder}"    Name="cmbMode" SelectionChanged="cmbMode_SelectionChanged" Grid.Row="5" SelectedIndex="0" VerticalAlignment="Center" Header="Mode">
                    <ComboBox.Items>
                        <ComboBoxItem FontFamily="{StaticResource GlobalFontHolder}"  Content="Elapsed Time of Video"/>
                        <ComboBoxItem FontFamily="{StaticResource GlobalFontHolder}"  Content="Remaining Time of Video"/>
                        <ComboBoxItem FontFamily="{StaticResource GlobalFontHolder}"  Content="Current Time vs Total Duration"/>
                        <ComboBoxItem FontFamily="{StaticResource GlobalFontHolder}"  Content="Current System Time"/>
                        <ComboBoxItem FontFamily="{StaticResource GlobalFontHolder}"  Visibility="Collapsed" Content="Custom Initial Offset"/>
                        <ComboBoxItem FontFamily="{StaticResource GlobalFontHolder}"  Content="Running Frames (Frame Rate to be Selected)"/>
                        <ComboBoxItem FontFamily="{StaticResource GlobalFontHolder}"  Content="Musical Timecode (Bars and Beats)"/>
                        <ComboBoxItem FontFamily="{StaticResource GlobalFontHolder}"  Content="Custom Static Watermark Text"/>
                    </ComboBox.Items>
                </ComboBox>
                <StackPanel x:Name="pnlFramesConfig" Visibility="Collapsed" Spacing="8" Margin="0,8,0,0">
                    <ComboBox FontFamily="{StaticResource GlobalFontHolder}"    x:Name="cmbFrameRate" Header="Frame Rate (FPS)" SelectedIndex="4" SelectionChanged="cmbFrameRate_SelectionChanged">
                        <ComboBoxItem FontFamily="{StaticResource GlobalFontHolder}"  Content="23.976"/>
                        <ComboBoxItem FontFamily="{StaticResource GlobalFontHolder}"  Content="24"/>
                        <ComboBoxItem FontFamily="{StaticResource GlobalFontHolder}"  Content="25"/>
                        <ComboBoxItem FontFamily="{StaticResource GlobalFontHolder}"  Content="29.97"/>
                        <ComboBoxItem FontFamily="{StaticResource GlobalFontHolder}"  Content="30"/>
                        <ComboBoxItem FontFamily="{StaticResource GlobalFontHolder}"  Content="50"/>
                        <ComboBoxItem FontFamily="{StaticResource GlobalFontHolder}"  Content="59.94"/>
                        <ComboBoxItem FontFamily="{StaticResource GlobalFontHolder}"  Content="60"/>
                    </ComboBox>
                </StackPanel>
                <TextBox FontFamily="{StaticResource GlobalFontHolder}"    PlaceholderText="Enter custom watermark text..." Name="txtCustomStaticWatermark" TextChanged="txtWatermarkCustomText_TextChanged"  Visibility="Collapsed">
                    <TextBox.Resources>
                        <!-- 1. Focused State (Accent Highlight on Border & Caret) -->
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource GlobalAccentColor}"/>
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1E1E1E"/>
                        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="TextControlButtonForegroundFocused" Color="{StaticResource GlobalAccentColor}"/>

                        <!-- 2. Resting / Unfocused State -->
                        <SolidColorBrush x:Key="TextControlBackground" Color="#202020"/>
                        <SolidColorBrush x:Key="TextControlForeground" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="#404040"/>
                        <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#808080"/>

                        <!-- 3. Pointer Over (Hover) State -->
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#2A2A2A"/>
                        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#555555"/>
                        <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#999999"/>

                        <!-- 4. Text Selection Highlight (Highlight color when selecting text) -->
                        <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="{StaticResource GlobalAccentColor}"/>

                        <!-- 5. Inner Clear / Action Button (The "X" delete button) -->
                        <SolidColorBrush x:Key="TextControlButtonBackground" Color="Transparent"/>
                        <SolidColorBrush x:Key="TextControlButtonBackgroundPointerOver" Color="#303030"/>
                        <SolidColorBrush x:Key="TextControlButtonBackgroundPressed" Color="#404040"/>
                        <SolidColorBrush x:Key="TextControlButtonForeground" Color="#808080"/>
                        <SolidColorBrush x:Key="TextControlButtonForegroundPointerOver" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="TextControlButtonForegroundPressed" Color="#FFFFFF"/>

                        <!-- 6. Disabled State -->
                        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#181818"/>
                        <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#505050"/>
                        <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#2A2A2A"/>
                        <SolidColorBrush x:Key="TextControlPlaceholderForegroundDisabled" Color="#404040"/>
                    </TextBox.Resources>
                </TextBox>

                <!-- Musical Timecode Configuration (Visible only when Mode == MusicalTimecode) -->
                <StackPanel x:Name="pnlMusicalConfig" Visibility="Collapsed" Spacing="8" Margin="0,8,0,0">
                    <NumberBox FontFamily="{StaticResource GlobalFontHolder}"    x:Name="numBpm" Header="BPM" Value="120" Minimum="20" Maximum="400" SpinButtonPlacementMode="Inline" ValueChanged="numBpm_ValueChanged">
                        <NumberBox.Resources>
                            <!-- 1. Focused State (Accent Border & Caret) -->
                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource GlobalAccentColor}"/>
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1E1E1E"/>
                            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFFFFF"/>

                            <!-- 2. Resting / Unfocused State -->
                            <SolidColorBrush x:Key="TextControlBackground" Color="#202020"/>
                            <SolidColorBrush x:Key="TextControlForeground" Color="#FFFFFF"/>
                            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#404040"/>
                            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#808080"/>

                            <!-- 3. Pointer Over (Hover) State -->
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#2A2A2A"/>
                            <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FFFFFF"/>
                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#555555"/>

                            <!-- 4. Text Selection Highlight -->
                            <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="{StaticResource GlobalAccentColor}"/>

                            <!-- 5. Spin Up/Down Repeat Buttons (Resting) -->
                            <SolidColorBrush x:Key="NumberBoxSpinButtonBackground" Color="Transparent"/>
                            <SolidColorBrush x:Key="NumberBoxSpinButtonForeground" Color="#AAAAAA"/>
                            <SolidColorBrush x:Key="NumberBoxSpinButtonBorderBrush" Color="Transparent"/>

                            <!-- 6. Spin Up/Down Repeat Buttons (Pointer Over) -->
                            <SolidColorBrush x:Key="NumberBoxSpinButtonBackgroundPointerOver" Color="#303030"/>
                            <SolidColorBrush x:Key="NumberBoxSpinButtonForegroundPointerOver" Color="{StaticResource GlobalAccentColor}"/>
                            <SolidColorBrush x:Key="NumberBoxSpinButtonBorderBrushPointerOver" Color="Transparent"/>

                            <!-- 7. Spin Up/Down Repeat Buttons (Pressed) -->
                            <SolidColorBrush x:Key="NumberBoxSpinButtonBackgroundPressed" Color="#404040"/>
                            <SolidColorBrush x:Key="NumberBoxSpinButtonForegroundPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                            <SolidColorBrush x:Key="NumberBoxSpinButtonBorderBrushPressed" Color="Transparent"/>

                            <!-- 8. Spin Up/Down Repeat Buttons (Disabled) -->
                            <SolidColorBrush x:Key="NumberBoxSpinButtonBackgroundDisabled" Color="Transparent"/>
                            <SolidColorBrush x:Key="NumberBoxSpinButtonForegroundDisabled" Color="#404040"/>
                            <SolidColorBrush x:Key="NumberBoxSpinButtonBorderBrushDisabled" Color="Transparent"/>

                            <!-- 9. Header / Label Foreground -->
                            <SolidColorBrush x:Key="NumberBoxHeaderForeground" Color="#FFFFFF"/>
                            <SolidColorBrush x:Key="NumberBoxHeaderForegroundDisabled" Color="#707070"/>

                            <!-- 10. Disabled NumberBox State -->
                            <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#181818"/>
                            <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#505050"/>
                            <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#2A2A2A"/>
                        </NumberBox.Resources>
                    </NumberBox>
                    <ComboBox FontFamily="{StaticResource GlobalFontHolder}"    x:Name="cmbBeatsPerBar" Header="Beats per Bar (Time Signature)" SelectedIndex="1" SelectionChanged="cmbBeatsPerBar_SelectionChanged">
                        <ComboBoxItem FontFamily="{StaticResource GlobalFontHolder}"  Content="3 (3/4)"/>
                        <ComboBoxItem FontFamily="{StaticResource GlobalFontHolder}"  Content="4 (4/4)"/>
                        <ComboBoxItem FontFamily="{StaticResource GlobalFontHolder}"  Content="6 (6/8)"/>
                        <ComboBoxItem FontFamily="{StaticResource GlobalFontHolder}"  Content="7 (7/8)"/>
                    </ComboBox>
                </StackPanel>
                <ComboBox FontFamily="{StaticResource GlobalFontHolder}"    Name="cmbFormat" SelectionChanged="cmbFormat_SelectionChanged" SelectedIndex="0"  Visibility="Visible" Grid.Row="5" VerticalAlignment="Center" Header="Format">
                    <ComboBox.Items>
                        <ComboBoxItem FontFamily="{StaticResource GlobalFontHolder}"  Content="hh:mm:ss:ff"/>
                        <ComboBoxItem FontFamily="{StaticResource GlobalFontHolder}"  Content="hh:mm:ss.ff"/>

                        <ComboBoxItem FontFamily="{StaticResource GlobalFontHolder}"  Content="Drop Frame (hh:mm:ss;ff)"/>
                        <ComboBoxItem FontFamily="{StaticResource GlobalFontHolder}"  Content="hh:mm:ss:fff"/>
                        <ComboBoxItem FontFamily="{StaticResource GlobalFontHolder}"  Content="hh:mm:ss.fff"/>
                        <ComboBoxItem FontFamily="{StaticResource GlobalFontHolder}"  Content="hh:mm:ss;fff"/>
                        <ComboBoxItem FontFamily="{StaticResource GlobalFontHolder}"  Content="DD:MM:YY hh:mm:ss:ff"/>
                        <ComboBoxItem FontFamily="{StaticResource GlobalFontHolder}"  Content="MM:DD:YY hh:mm:ss:ff"/>
                        <ComboBoxItem FontFamily="{StaticResource GlobalFontHolder}"  Content="mm:ss"/>
                        <ComboBoxItem FontFamily="{StaticResource GlobalFontHolder}"  Content="mm:ss:ff"/>
                        <ComboBoxItem FontFamily="{StaticResource GlobalFontHolder}"  Content="mm:ss:fff"/>
                        <ComboBoxItem FontFamily="{StaticResource GlobalFontHolder}"  Content="Custom Format"/>
                    </ComboBox.Items>
                </ComboBox>
                <TextBox  FontFamily="{StaticResource GlobalFontHolder}"   TextChanged="txtCustomFormat_TextChanged" Name="txtCustomFormat" Visibility="Collapsed" PlaceholderText="Enter a valid format...">
                    <TextBox.Resources>
                        <!-- 1. Focused State (Accent Highlight on Border & Caret) -->
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource GlobalAccentColor}"/>
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1E1E1E"/>
                        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="TextControlButtonForegroundFocused" Color="{StaticResource GlobalAccentColor}"/>

                        <!-- 2. Resting / Unfocused State -->
                        <SolidColorBrush x:Key="TextControlBackground" Color="#202020"/>
                        <SolidColorBrush x:Key="TextControlForeground" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="#404040"/>
                        <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#808080"/>

                        <!-- 3. Pointer Over (Hover) State -->
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#2A2A2A"/>
                        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#555555"/>
                        <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#999999"/>

                        <!-- 4. Text Selection Highlight (Highlight color when selecting text) -->
                        <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="{StaticResource GlobalAccentColor}"/>

                        <!-- 5. Inner Clear / Action Button (The "X" delete button) -->
                        <SolidColorBrush x:Key="TextControlButtonBackground" Color="Transparent"/>
                        <SolidColorBrush x:Key="TextControlButtonBackgroundPointerOver" Color="#303030"/>
                        <SolidColorBrush x:Key="TextControlButtonBackgroundPressed" Color="#404040"/>
                        <SolidColorBrush x:Key="TextControlButtonForeground" Color="#808080"/>
                        <SolidColorBrush x:Key="TextControlButtonForegroundPointerOver" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="TextControlButtonForegroundPressed" Color="#FFFFFF"/>

                        <!-- 6. Disabled State -->
                        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#181818"/>
                        <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#505050"/>
                        <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#2A2A2A"/>
                        <SolidColorBrush x:Key="TextControlPlaceholderForegroundDisabled" Color="#404040"/>
                    </TextBox.Resources>
                </TextBox>

                <StackPanel Name="txtInvalidFormat" Visibility="Collapsed" Orientation="Horizontal" Spacing="10">
                    <TextBlock   FontFamily="{StaticResource GlobalFontHolder}"   Style="{StaticResource BodyStrongTextBlockStyle}" Text="Invalid Format" Foreground="Red" />

                    <HyperlinkButton Foreground="{StaticResource GlobalAccentColor}"   Content="View Valid Formats" NavigateUri="https://github.com/OceanCyanTech/Vusic-Player/blob/master/Wiki/Features/Usage/ValidTimecodeFormats.md"></HyperlinkButton>
                </StackPanel>
                <NumberBox FontFamily="{StaticResource GlobalFontHolder}"    ValueChanged="numOffset_ValueChanged" Header="Offset (Milliseconds)" Value="0" Name="numOffset">
                    <NumberBox.Resources>
                        <!-- 1. Focused State (Accent Border & Caret) -->
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource GlobalAccentColor}"/>
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1E1E1E"/>
                        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFFFFF"/>

                        <!-- 2. Resting / Unfocused State -->
                        <SolidColorBrush x:Key="TextControlBackground" Color="#202020"/>
                        <SolidColorBrush x:Key="TextControlForeground" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="#404040"/>
                        <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#808080"/>

                        <!-- 3. Pointer Over (Hover) State -->
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#2A2A2A"/>
                        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#555555"/>

                        <!-- 4. Text Selection Highlight -->
                        <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="{StaticResource GlobalAccentColor}"/>

                        <!-- 5. Spin Up/Down Repeat Buttons (Resting) -->
                        <SolidColorBrush x:Key="NumberBoxSpinButtonBackground" Color="Transparent"/>
                        <SolidColorBrush x:Key="NumberBoxSpinButtonForeground" Color="#AAAAAA"/>
                        <SolidColorBrush x:Key="NumberBoxSpinButtonBorderBrush" Color="Transparent"/>

                        <!-- 6. Spin Up/Down Repeat Buttons (Pointer Over) -->
                        <SolidColorBrush x:Key="NumberBoxSpinButtonBackgroundPointerOver" Color="#303030"/>
                        <SolidColorBrush x:Key="NumberBoxSpinButtonForegroundPointerOver" Color="{StaticResource GlobalAccentColor}"/>
                        <SolidColorBrush x:Key="NumberBoxSpinButtonBorderBrushPointerOver" Color="Transparent"/>

                        <!-- 7. Spin Up/Down Repeat Buttons (Pressed) -->
                        <SolidColorBrush x:Key="NumberBoxSpinButtonBackgroundPressed" Color="#404040"/>
                        <SolidColorBrush x:Key="NumberBoxSpinButtonForegroundPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                        <SolidColorBrush x:Key="NumberBoxSpinButtonBorderBrushPressed" Color="Transparent"/>

                        <!-- 8. Spin Up/Down Repeat Buttons (Disabled) -->
                        <SolidColorBrush x:Key="NumberBoxSpinButtonBackgroundDisabled" Color="Transparent"/>
                        <SolidColorBrush x:Key="NumberBoxSpinButtonForegroundDisabled" Color="#404040"/>
                        <SolidColorBrush x:Key="NumberBoxSpinButtonBorderBrushDisabled" Color="Transparent"/>

                        <!-- 9. Header / Label Foreground -->
                        <SolidColorBrush x:Key="NumberBoxHeaderForeground" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="NumberBoxHeaderForegroundDisabled" Color="#707070"/>

                        <!-- 10. Disabled NumberBox State -->
                        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#181818"/>
                        <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#505050"/>
                        <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#2A2A2A"/>
                    </NumberBox.Resources>
                </NumberBox>
                <Button FontFamily="{StaticResource GlobalFontHolder}"    Name="btnFontSettings" Content="Font Settings">
                    <Button.Flyout>
                        <Flyout>
                            <StackPanel Orientation="Vertical" Spacing="10">
                                <ComboBox SelectionChanged="cmbFontFamily_SelectionChanged" Name="cmbFontFamily" Header="Font Family"></ComboBox>
                                <NumberBox FontFamily="{StaticResource GlobalFontHolder}"    ValueChanged="NumberBox_ValueChanged"  Value="36"  Header="Font Size">
                                    <NumberBox.Resources>
                                        <!-- 1. Focused State (Accent Border & Caret) -->
                                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource GlobalAccentColor}"/>
                                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1E1E1E"/>
                                        <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFFFFF"/>

                                        <!-- 2. Resting / Unfocused State -->
                                        <SolidColorBrush x:Key="TextControlBackground" Color="#202020"/>
                                        <SolidColorBrush x:Key="TextControlForeground" Color="#FFFFFF"/>
                                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="#404040"/>
                                        <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#808080"/>

                                        <!-- 3. Pointer Over (Hover) State -->
                                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#2A2A2A"/>
                                        <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FFFFFF"/>
                                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#555555"/>

                                        <!-- 4. Text Selection Highlight -->
                                        <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="{StaticResource GlobalAccentColor}"/>

                                        <!-- 5. Spin Up/Down Repeat Buttons (Resting) -->
                                        <SolidColorBrush x:Key="NumberBoxSpinButtonBackground" Color="Transparent"/>
                                        <SolidColorBrush x:Key="NumberBoxSpinButtonForeground" Color="#AAAAAA"/>
                                        <SolidColorBrush x:Key="NumberBoxSpinButtonBorderBrush" Color="Transparent"/>

                                        <!-- 6. Spin Up/Down Repeat Buttons (Pointer Over) -->
                                        <SolidColorBrush x:Key="NumberBoxSpinButtonBackgroundPointerOver" Color="#303030"/>
                                        <SolidColorBrush x:Key="NumberBoxSpinButtonForegroundPointerOver" Color="{StaticResource GlobalAccentColor}"/>
                                        <SolidColorBrush x:Key="NumberBoxSpinButtonBorderBrushPointerOver" Color="Transparent"/>

                                        <!-- 7. Spin Up/Down Repeat Buttons (Pressed) -->
                                        <SolidColorBrush x:Key="NumberBoxSpinButtonBackgroundPressed" Color="#404040"/>
                                        <SolidColorBrush x:Key="NumberBoxSpinButtonForegroundPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                                        <SolidColorBrush x:Key="NumberBoxSpinButtonBorderBrushPressed" Color="Transparent"/>

                                        <!-- 8. Spin Up/Down Repeat Buttons (Disabled) -->
                                        <SolidColorBrush x:Key="NumberBoxSpinButtonBackgroundDisabled" Color="Transparent"/>
                                        <SolidColorBrush x:Key="NumberBoxSpinButtonForegroundDisabled" Color="#404040"/>
                                        <SolidColorBrush x:Key="NumberBoxSpinButtonBorderBrushDisabled" Color="Transparent"/>

                                        <!-- 9. Header / Label Foreground -->
                                        <SolidColorBrush x:Key="NumberBoxHeaderForeground" Color="#FFFFFF"/>
                                        <SolidColorBrush x:Key="NumberBoxHeaderForegroundDisabled" Color="#707070"/>

                                        <!-- 10. Disabled NumberBox State -->
                                        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#181818"/>
                                        <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#505050"/>
                                        <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#2A2A2A"/>
                                    </NumberBox.Resources>
                                </NumberBox>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <ToggleButton FontFamily="{StaticResource GlobalFontHolder}"    Content="Bold" FontWeight="Bold" Name="tglBold" Checked="tglBold_Checked" Unchecked="tglBold_Checked">
                                        <ToggleButton.Resources>
                                            <!-- 1. Background Fill when CHECKED -->
                                            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{StaticResource GlobalAccentColor}"/>
                                            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{StaticResource GlobalAccentColorPointerOver}"/>
                                            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                                            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedDisabled" Color="#2A2A2A"/>

                                            <!-- 2. Text / Icon Foreground when CHECKED -->
                                            <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#000000"/>
                                            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#000000"/>
                                            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#000000"/>
                                            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedDisabled" Color="#707070"/>

                                            <!-- 3. Border Stroke when CHECKED -->
                                            <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent"/>
                                            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent"/>
                                            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent"/>
                                            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedDisabled" Color="Transparent"/>

                                            <!-- 4. Background Fill when UNCHECKED -->
                                            <SolidColorBrush x:Key="ToggleButtonBackground" Color="#202020"/>
                                            <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#2D2D2D"/>
                                            <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#181818"/>
                                            <SolidColorBrush x:Key="ToggleButtonBackgroundDisabled" Color="#1E1E1E"/>

                                            <!-- 5. Text / Icon Foreground when UNCHECKED -->
                                            <SolidColorBrush x:Key="ToggleButtonForeground" Color="#FFFFFF"/>
                                            <SolidColorBrush x:Key="ToggleButtonForegroundPointerOver" Color="#FFFFFF"/>
                                            <SolidColorBrush x:Key="ToggleButtonForegroundPressed" Color="#CCCCCC"/>
                                            <SolidColorBrush x:Key="ToggleButtonForegroundDisabled" Color="#505050"/>

                                            <!-- 6. Border Stroke when UNCHECKED -->
                                            <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="#404040"/>
                                            <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="#555555"/>
                                            <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="#303030"/>
                                            <SolidColorBrush x:Key="ToggleButtonBorderBrushDisabled" Color="#2A2A2A"/>
                                        </ToggleButton.Resources>
                                    </ToggleButton>
                                    <ToggleButton FontFamily="{StaticResource GlobalFontHolder}"    Content="Italics" FontStyle="Italic" Name="tglItalics" Checked="tglItalics_Checked" Unchecked="tglItalics_Checked">
                                        <ToggleButton.Resources>
                                            <!-- 1. Background Fill when CHECKED -->
                                            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{StaticResource GlobalAccentColor}"/>
                                            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{StaticResource GlobalAccentColorPointerOver}"/>
                                            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                                            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedDisabled" Color="#2A2A2A"/>

                                            <!-- 2. Text / Icon Foreground when CHECKED -->
                                            <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#000000"/>
                                            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#000000"/>
                                            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#000000"/>
                                            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedDisabled" Color="#707070"/>

                                            <!-- 3. Border Stroke when CHECKED -->
                                            <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent"/>
                                            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent"/>
                                            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent"/>
                                            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedDisabled" Color="Transparent"/>

                                            <!-- 4. Background Fill when UNCHECKED -->
                                            <SolidColorBrush x:Key="ToggleButtonBackground" Color="#202020"/>
                                            <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#2D2D2D"/>
                                            <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#181818"/>
                                            <SolidColorBrush x:Key="ToggleButtonBackgroundDisabled" Color="#1E1E1E"/>

                                            <!-- 5. Text / Icon Foreground when UNCHECKED -->
                                            <SolidColorBrush x:Key="ToggleButtonForeground" Color="#FFFFFF"/>
                                            <SolidColorBrush x:Key="ToggleButtonForegroundPointerOver" Color="#FFFFFF"/>
                                            <SolidColorBrush x:Key="ToggleButtonForegroundPressed" Color="#CCCCCC"/>
                                            <SolidColorBrush x:Key="ToggleButtonForegroundDisabled" Color="#505050"/>

                                            <!-- 6. Border Stroke when UNCHECKED -->
                                            <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="#404040"/>
                                            <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="#555555"/>
                                            <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="#303030"/>
                                            <SolidColorBrush x:Key="ToggleButtonBorderBrushDisabled" Color="#2A2A2A"/>
                                        </ToggleButton.Resources>
                                    </ToggleButton>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">

                                    <TextBlock FontFamily="{StaticResource GlobalFontHolder}"    Text="Font Color"/>
                                </StackPanel>
                                <ColorPicker FontFamily="{StaticResource GlobalFontHolder}"    ColorChanged="ColorPicker_ColorChanged"/>

                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>

        </Grid>

    </Grid>
</UserControl>
