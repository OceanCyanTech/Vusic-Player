<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Vusic_Player.UI.Dialogs.VideoOptions.VideoOverlay.WatermarkOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Vusic_Player.UI.Dialogs.VideoOptions.VideoOverlay"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <UserControl.Resources>
        <local:CountToVisibility x:Key="CountToVisConverter"/>
    </UserControl.Resources>
    <Grid RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Watermark Overlay" Style="{StaticResource BodyLargeStrongTextBlockStyle}"/>
        <TextBlock Text="Display a watermark overlay with custom text or a running timecode on the video." Grid.Row="1"/>
        <TextBlock Text="Add upto 9 Watermark Labels" Grid.Row="2" Style="{StaticResource BodyStrongTextBlockStyle}"/>

        <Grid Grid.Row="3" ColumnSpacing="30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Button Content="Add new Label to Display" Name="btnNewTimeCodedLabel" Visibility="Visible" Click="btnNewTimeCodedLabel_Click"/>
                        <ListView SelectionChanged="lstViewAddedTimeCodeLabels_SelectionChanged" 
          ItemsSource="{x:Bind timestamplabels, Mode=OneWay}" 
          Grid.Row="1" 
          Name="lstViewAddedTimeCodeLabels">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="50" Background="Transparent">
                                        <!-- Right-click Context Menu -->
                                        <Grid.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Remove" 
                                        Icon="Delete" 
                                        Click="MenuFlyoutItem_Remove_Click"/>
                                            </MenuFlyout>
                                        </Grid.ContextFlyout>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock VerticalAlignment="Center" Text="{Binding Label}"/>
                                        <TextBlock VerticalAlignment="Center" 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                           Text="{Binding Position}" 
                           Grid.Column="1"/>

                                        <!-- CheckBox with TwoWay binding and Checked/Unchecked events -->
                                        <CheckBox Content="Show" 
                          Grid.Column="2" 
                          IsChecked="{Binding IsShown, Mode=TwoWay}"
                          Checked="chkShow_Checked" 
                          Unchecked="chkShow_Unchecked"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
            <StackPanel VerticalAlignment="Center" Visibility="{x:Bind timestamplabels.Count, Mode=OneWay, Converter={StaticResource CountToVisConverter}}" Grid.Column="1" Orientation="Vertical" Spacing="10" Grid.Row="4">
                <ComboBox Name="cmbPosition" SelectionChanged="cmbPosition_SelectionChanged" Grid.Row="4" SelectedIndex="0" VerticalAlignment="Center" Header="Position">
                    <ComboBox.Items>
                        <ComboBoxItem Content="Top Left"/>
                        <ComboBoxItem Content="Top Center"/>
                        <ComboBoxItem Content="Top Right"/>
                        <ComboBoxItem Content="Left"/>
                        <ComboBoxItem Content="Center"/>
                        <ComboBoxItem Content="Right"/>
                        <ComboBoxItem Content="Bottom Left"/>
                        <ComboBoxItem Content="Bottom Center"/>
                        <ComboBoxItem Content="Bottom Right"/>
                    </ComboBox.Items>
                </ComboBox>
                <ComboBox Name="cmbMode" SelectionChanged="cmbMode_SelectionChanged" Grid.Row="5" SelectedIndex="0" VerticalAlignment="Center" Header="Mode">
                    <ComboBox.Items>
                        <ComboBoxItem Content="Elapsed Time of Video"/>
                        <ComboBoxItem Content="Remaining Time of Video"/>
                        <ComboBoxItem Content="Current Time vs Total Duration"/>
                        <ComboBoxItem Content="Current System Time"/>
                        <ComboBoxItem Visibility="Collapsed" Content="Custom Initial Offset"/>
                        <ComboBoxItem Content="Running Frames (Frame Rate to be Selected)"/>
                        <ComboBoxItem Content="Musical Timecode (Bars and Beats)"/>
                        <ComboBoxItem Content="Custom Static Watermark Text"/>
                    </ComboBox.Items>
                </ComboBox>
                <StackPanel x:Name="pnlFramesConfig" Visibility="Collapsed" Spacing="8" Margin="0,8,0,0">
                    <ComboBox x:Name="cmbFrameRate" Header="Frame Rate (FPS)" SelectedIndex="4" SelectionChanged="cmbFrameRate_SelectionChanged">
                        <ComboBoxItem Content="23.976"/>
                        <ComboBoxItem Content="24"/>
                        <ComboBoxItem Content="25"/>
                        <ComboBoxItem Content="29.97"/>
                        <ComboBoxItem Content="30"/>
                        <ComboBoxItem Content="50"/>
                        <ComboBoxItem Content="59.94"/>
                        <ComboBoxItem Content="60"/>
                    </ComboBox>
                </StackPanel>
                <TextBox PlaceholderText="Enter custom watermark text..." Name="txtCustomStaticWatermark" TextChanged="txtWatermarkCustomText_TextChanged"  Visibility="Collapsed"/>

                <!-- Musical Timecode Configuration (Visible only when Mode == MusicalTimecode) -->
                <StackPanel x:Name="pnlMusicalConfig" Visibility="Collapsed" Spacing="8" Margin="0,8,0,0">
                    <NumberBox x:Name="numBpm" Header="BPM" Value="120" Minimum="20" Maximum="400" SpinButtonPlacementMode="Inline" ValueChanged="numBpm_ValueChanged"/>
                    <ComboBox x:Name="cmbBeatsPerBar" Header="Beats per Bar (Time Signature)" SelectedIndex="1" SelectionChanged="cmbBeatsPerBar_SelectionChanged">
                        <ComboBoxItem Content="3 (3/4)"/>
                        <ComboBoxItem Content="4 (4/4)"/>
                        <ComboBoxItem Content="6 (6/8)"/>
                        <ComboBoxItem Content="7 (7/8)"/>
                    </ComboBox>
                </StackPanel>
                <ComboBox Name="cmbFormat" SelectionChanged="cmbFormat_SelectionChanged" SelectedIndex="0"  Visibility="Visible" Grid.Row="5" VerticalAlignment="Center" Header="Format">
                    <ComboBox.Items>
                        <ComboBoxItem Content="hh:mm:ss:ff"/>
                        <ComboBoxItem Content="hh:mm:ss.ff"/>

                        <ComboBoxItem Content="Drop Frame (hh:mm:ss;ff)"/>
                        <ComboBoxItem Content="hh:mm:ss:fff"/>
                        <ComboBoxItem Content="hh:mm:ss.fff"/>
                        <ComboBoxItem Content="hh:mm:ss;fff"/>
                        <ComboBoxItem Content="DD:MM:YY hh:mm:ss:ff"/>
                        <ComboBoxItem Content="MM:DD:YY hh:mm:ss:ff"/>
                        <ComboBoxItem Content="mm:ss"/>
                        <ComboBoxItem Content="mm:ss:ff"/>
                        <ComboBoxItem Content="mm:ss:fff"/>
                        <ComboBoxItem Content="Custom Format"/>
                    </ComboBox.Items>
                </ComboBox>
                <TextBox TextChanged="txtCustomFormat_TextChanged" Name="txtCustomFormat" Visibility="Collapsed" PlaceholderText="Enter a valid format..."/>

                <StackPanel Name="txtInvalidFormat" Visibility="Collapsed" Orientation="Horizontal" Spacing="10">
                <TextBlock  Style="{StaticResource BodyStrongTextBlockStyle}" Text="Invalid Format" Foreground="Red" />

                    <HyperlinkButton Content="View Valid Formats" NavigateUri="https://github.com/OceanCyanTech/Vusic-Player/blob/master/Wiki/Features/Usage/ValidTimecodeFormats.md"></HyperlinkButton>
                </StackPanel>
                <NumberBox ValueChanged="numOffset_ValueChanged" Header="Offset (Milliseconds)" Value="0" Name="numOffset"/>
                <Button Name="btnFontSettings" Content="Font Settings">
                    <Button.Flyout>
                        <Flyout>
                            <StackPanel Orientation="Vertical" Spacing="10">
                                <ComboBox SelectionChanged="cmbFontFamily_SelectionChanged" Name="cmbFontFamily" Header="Font Family"></ComboBox>
                                <NumberBox ValueChanged="NumberBox_ValueChanged"  Value="36"  Header="Font Size"></NumberBox>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                <ToggleButton Content="Bold" FontWeight="Bold" Name="tglBold" Checked="tglBold_Checked" Unchecked="tglBold_Checked"/>
                                <ToggleButton Content="Italics" FontStyle="Italic" Name="tglItalics" Checked="tglItalics_Checked" Unchecked="tglItalics_Checked"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                            
                                    <TextBlock Text="Font Color"/>
                                </StackPanel>
                                <ColorPicker ColorChanged="ColorPicker_ColorChanged"/>

                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>

        </Grid>

    </Grid>
</UserControl>
