<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Vusic_Player.UI.Dialogs.VideoOptions.Subtitle.SubtitleEditorUI"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Vusic_Player.UI.Dialogs.VideoOptions.Subtitle"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:flyleaf="using:FlyleafLib.MediaFramework.MediaStream"
    mc:Ignorable="d">
    <UserControl.Resources>
        <local:CountToCueConverter x:Key="CountToCueConv"/>
    </UserControl.Resources>
    <Grid Margin="30, 10" RowSpacing="20">
       
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Text="{x:Bind editorview.Header, Mode=OneWay}" Name="txtSubtitleEditorHeader" Grid.Row="0" Style="{StaticResource TitleLargeTextBlockStyle}"/>
        <StackPanel Orientation="Horizontal" Grid.Row="1" Spacing="10">
            <ComboBox FontFamily="{StaticResource GlobalFontHolder}"    x:Name="cmbEmbeddedSubTracks" Grid.Row="1" Visibility="{x:Bind editorview.CmbPlaceholderText, Mode=OneWay}"
                              PlaceholderText="Select Subtitle Track" ItemsSource="{x:Bind ViewModel.SubStreams, Mode=OneWay}"   SelectedItem="{x:Bind ViewModel.CurrentStream, Mode=OneWay}"
                              HorizontalAlignment="Stretch" 
                              SelectionChanged="cmbEmbeddedSubTracks_SelectionChanged">
            <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="flyleaf:SubtitlesStream">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xED1E;" FontSize="16" Foreground="Cyan"/>

                        <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  VerticalAlignment="Center">
<Run Text="Stream"/>
<Run Text="{x:Bind StreamIndex}"/>
<Run Text="["/>
<Run Text="{x:Bind Language}"/>
<Run Text="]"/>
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
            <CheckBox FontFamily="{StaticResource GlobalFontHolder}"  Visibility="{x:Bind editorview.CmbPlaceholderText, Mode=OneWay}" Name="chkFromVideo" Content="Subtitle(s) from video" Checked="chkFromVideo_Checked" Unchecked="chkFromVideo_Checked"/>
        </StackPanel>
        <TeachingTip Name="ttRenameFile">
            <StackPanel Orientation="Vertical" Spacing="10">
                <InfoBar FontFamily="{StaticResource GlobalFontHolder}"    Name="ifbErrorRename"></InfoBar>
                <TextBox FontFamily="{StaticResource GlobalFontHolder}"   Name="txtRename" PlaceholderText="Rename file..."></TextBox>
                <Button Name="btnOfficialRename" Click="btnOfficialRename_Click" ToolTipService.ToolTip="Rename">
                    <Image Source="{Binding TickIcon, Source={StaticResource GlobalIconHolder}}" Width="20"/>
                </Button>
            </StackPanel>
        </TeachingTip>
        <StackPanel Orientation="Horizontal" Spacing="10" Grid.Row="2">
            <Button FontFamily="{StaticResource GlobalFontHolder}"    Name="tglView" ToolTipService.ToolTip="Toggle View" Content="Text Editor" Click="tglView_Click_1" Style="{StaticResource AccentButtonStyle}"/>
            <Button Name="btnNewSubtitleFile" Click="btnNewSubtitleFile_Click">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Image Width="20" Source="{Binding AddIcon, Source={StaticResource GlobalIconHolder}}"/>
                    <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Text="{x:Bind editorview.BtnNewSubtitleFile, Mode=OneWay}"/>
                </StackPanel>
            </Button>
            <Button Name="btnLoadSubtitleFile" Click="btnLoadSubtitleFile_Click">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Image Width="20" Source="{Binding OpenFile, Source={StaticResource GlobalIconHolder}}"/>
                    <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Text="{x:Bind editorview.BtnLoadSubtitleFile, Mode=OneWay}"/>
                </StackPanel>
            </Button>

            <Button Name="btnSaveFile" IsEnabled="False"  Click="btnSaveFile_Click">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control" Key="S"/>
                </Button.KeyboardAccelerators>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Image Width="20" Source="{Binding SaveIcon, Source={StaticResource GlobalIconHolder}}"/>
                    <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Text="Save File"/>
                </StackPanel>
            </Button>
            <Button Name="btnSaveAsFile"  IsEnabled="False"   Click="btnSaveAsFile_Click">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Image Width="20" Source="{Binding SaveAsIcon, Source={StaticResource GlobalIconHolder}}"/>
                    <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Text="Save As"/>
                </StackPanel>
            </Button>
        </StackPanel>
        <MenuFlyoutSeparator Grid.Row="3"/>
        <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Text="Untitled" Name="txtFileName" Grid.Row="4" Style="{StaticResource TitleTextBlockStyle}">
            <TextBlock.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem FontFamily="{StaticResource GlobalFontHolder}"  Text="Copy File Path" Name="mnftCopyFilePath" Click="mnftCopyFilePath_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8C8;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem FontFamily="{StaticResource GlobalFontHolder}"  Text="Rename File" Name="mnftRenameSubtitle" Click="mnftRenameSubtitle_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8AC;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem FontFamily="{StaticResource GlobalFontHolder}"  Text="Open File Location" Name="mnftOpenFileLoc" Click="mnftOpenFileLoc_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8DA;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </TextBlock.ContextFlyout>
        </TextBlock>
        <Grid Grid.Row="5" Name="grdVisualEditor" ColumnSpacing="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Text="Subtitle Cue" Style="{StaticResource SubtitleTextBlockStyle}"/>
                <TextBox FontFamily="{StaticResource GlobalFontHolder}"   TextChanged="txtTranscript_TextChanged" Name="txtTranscript" Grid.Row="1" PlaceholderText="Select a subtitle cue in the list to load it here..."/>
                <StackPanel HorizontalAlignment="Stretch" Orientation="Horizontal" Spacing="10" Grid.Row="2">
                    <Button HorizontalAlignment="Stretch" Name="btnRemoveSubtitle" Click="btnRemoveSubtitle_Click" Content="Remove Subtitle" Grid.Row="2"/>

                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10" Grid.Row="3">
                    <Button Name="btnInsertBelow" Click="btnInsertBelow_Click">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Image Width="20" Source="{Binding ChevronDown, Source={StaticResource GlobalIconHolder}}"/>
                            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Text="Insert New Subtitle Cue Below"/>
                        </StackPanel>
                    </Button>
                    <Button Name="btnInsertAbove" Click="btnInsertAbove_Click">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Image Width="20" Source="{Binding ChevronUp, Source={StaticResource GlobalIconHolder}}"/>
                            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Text="Insert New Subtitle Cue Above"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10" Grid.Row="4">
                    <StackPanel Orientation="Vertical" Spacing="10">
                        <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Style="{StaticResource BodyStrongTextBlockStyle}"  Text="Subtitle Duration"/>
                        <NumberBox ValueChanged="subDifference_ValueChanged" Name="subDifference" Minimum="0"/>
                    </StackPanel>
                    <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  VerticalAlignment="Bottom" Margin="0, 10" Text="seconds"/>
                </StackPanel>
                <Grid Grid.Row="5"  ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Vertical" Spacing="15">
                        <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Style="{StaticResource BodyStrongTextBlockStyle}" Text="Start Time"/>
                        <InfoBar Name="ifbErrorStartTime"/>
                        <TextBox FontFamily="{StaticResource GlobalFontHolder}"   TextChanged="txtStartTime_TextChanged"  Text="00:00:00.000" Name="txtStartTime"/>
                        <Button Content="Get Current Time" Name="btnGetCurrentTimeStart" Click="btnGetCurrentTimeStart_Click"></Button>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="15">
                        <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Style="{StaticResource BodyStrongTextBlockStyle}" Text="End Time"/>
                        <InfoBar Name="ifbErrorEndTime"/>
                        <TextBox FontFamily="{StaticResource GlobalFontHolder}"   TextChanged="txtEndTime_TextChanged" Text="00:00:00.000" Name="txtEndTime"/>
                        <Button Content="Get Current Time" Name="btnGetCurrentTimeEnd" Click="btnGetCurrentTimeEnd_Click"></Button>
                    </StackPanel>
                </Grid>
            </Grid>
            <Grid Grid.Column="1" RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Text="Subtitles" Grid.Row="0" Style="{StaticResource SubtitleTextBlockStyle}"/>
                <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Text="{x:Bind Subtitles.Count, Mode=OneWay, Converter={StaticResource CountToCueConv}}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Grid.Row="1"/>
                <Grid Name="grdColumnHeaders" Visibility="Collapsed" Grid.Row="2" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xED1E;"  FontSize="12" />
                    <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Subtitle" Grid.Column="1"/>
                    <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}"  Text="Start Time" Grid.Column="2"/>
                    <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}"  Text="End Time" Grid.Column="3"/>
                </Grid>
                <ListView ItemClick="lstViewSubtitles_ItemClick" IsItemClickEnabled="True"   Name="lstViewSubtitles" ItemsSource="{x:Bind Subtitles, Mode=OneWay}" Grid.Row="3">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="30" Margin="0, 12">
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem FontFamily="{StaticResource GlobalFontHolder}"  Text="Edit Subtitle" Name="mnftEditSubtitle" Click="mnftEditSubtitle_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE70F;"/>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem FontFamily="{StaticResource GlobalFontHolder}"  Text="Copy Subtitle" Name="mnftCopySubtitle" Click="mnftCopySubtitle_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8C8;"/>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem FontFamily="{StaticResource GlobalFontHolder}"  Text="Copy Subtitle with Timestamps" Name="mnftCopySubtitlewithTimestamps" Click="mnftCopySubtitlewithTimestamps_Click">
                                            <MenuFlyoutItem.Icon>
                                                <ImageIcon Source="/Assets/copysubtitlewithtimestampsfonticon.png"/>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem FontFamily="{StaticResource GlobalFontHolder}"  Text="Remove Subtitle" Name="mnftRemoveSubtitle" Click="mnftRemoveSubtitle_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE894;"/>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator/>
                                        <MenuFlyoutItem FontFamily="{StaticResource GlobalFontHolder}"  Text="Insert Subtitle Above" Name="mnftInsertSubtitleAbove" Click="mnftInsertSubtitleAbove_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE70E;"/>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem FontFamily="{StaticResource GlobalFontHolder}"  Text="Insert Subtitle Below" Name="mnftInsertSubtitleBelow" Click="mnftInsertSubtitleBelow_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE70D;"/>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>

                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon FontSize="14" Glyph="&#xED1E;"/>
                                <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Text="{Binding Text}" Grid.Column="1"/>
                                <TextBlock FontFamily="{StaticResource GlobalFontHolder}"    Text="{Binding StartString}" Grid.Column="2"/>
                                <TextBlock FontFamily="{StaticResource GlobalFontHolder}"   Text="{Binding EndString}" Grid.Column="3"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel HorizontalAlignment="Center" Name="stkNoSubtitles" VerticalAlignment="Center" Orientation="Vertical" Spacing="30" Grid.Row="3">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Image Source="{Binding SubtitlesIcon, Source={StaticResource GlobalIconHolder}}" Width="30"/>
                        <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Text="There are no subtitles to display!" Style="{StaticResource SubtitleTextBlockStyle}"/>
                    </StackPanel>
                    <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  HorizontalAlignment="Center" Text="Import an existing subtitle file or create a new one."/>
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="10">
                        <Button Name="btnNewSubtitleFile2" Click="btnNewSubtitleFile_Click">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Image Width="20" Source="{Binding AddIcon, Source={StaticResource GlobalIconHolder}}"/>
                                <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Text="New Subtitle File"/>
                            </StackPanel>
                        </Button>
                        <Button Name="btnLoadSubtitleFile2" Click="btnLoadSubtitleFile_Click">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Image Width="20" Source="{Binding OpenFile, Source={StaticResource GlobalIconHolder}}"/>
                                <TextBlock FontFamily="{StaticResource GlobalFontHolder}"  Text="Load Subtitle File"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
        <Grid Grid.Row="6" Name="grdTextEditor" Visibility="Collapsed" VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="280"/>
            </Grid.RowDefinitions>
            <ScrollViewer Grid.Row="1">
                <TextBox FontFamily="{StaticResource GlobalFontHolder}"   AcceptsReturn="True"  Grid.Row="1" Name="txtTextEditor" TextChanged="txtTextEditor_TextChanged" VerticalAlignment="Stretch" >
                    <TextBox.Resources>
                        <!-- Keeps the selection visible even when focus is lost -->
                        <StaticResource x:Key="TextControlSelectionHighlightColorWhenNotFocused" 
                        ResourceKey="SystemAccentColor" />
                    </TextBox.Resources>
                </TextBox>
            </ScrollViewer>
            <Border  Grid.Column="0"
Padding="10"  Margin="0, 10"
VerticalAlignment="Top" 
HorizontalAlignment="Center"
Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" 
BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
BorderThickness="1" 
CornerRadius="16"
                >
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Name="btnUndo" Click="btnUndo_Click"  ToolTipService.ToolTip="Undo" BorderBrush="Transparent" Background="Transparent">
                        <FontIcon Glyph="&#xE7A7;"/>
                    </Button>
                    <Button Name="btnRedo" Click="btnRedo_Click" ToolTipService.ToolTip="Redo" BorderBrush="Transparent" Background="Transparent">
                        <FontIcon Glyph="&#xE7A6;"/>
                    </Button>
                    <Button Name="btnCut" Click="btnCut_Click"  ToolTipService.ToolTip="Cut" BorderBrush="Transparent" Background="Transparent">
                        <FontIcon Glyph="&#xE8C6;"/>
                    </Button>
                    <Button Name="btnCopy" Click="btnCopy_Click" ToolTipService.ToolTip="Copy" BorderBrush="Transparent" Background="Transparent">
                        <FontIcon Glyph="&#xE8C8;"/>
                    </Button>
                    <Button Name="btnPaste" Click="btnPaste_Click" ToolTipService.ToolTip="Paste" BorderBrush="Transparent" Background="Transparent">
                        <FontIcon Glyph="&#xE77F;"/>
                    </Button>
                    <Button Name="btnSelectAll" Click="btnSelectAll_Click" ToolTipService.ToolTip="Select All" BorderBrush="Transparent" Background="Transparent">
                        <FontIcon Glyph="&#xE8B3;"/>
                    </Button>
                    <Button Name="btnDelete" Click="btnDelete_Click" ToolTipService.ToolTip="Delete" BorderBrush="Transparent" Background="Transparent">
                        <FontIcon Glyph="&#xE74D;"/>
                    </Button>
                    <Button Name="btnFind" Click="btnFind_Click" ToolTipService.ToolTip="Find" BorderBrush="Transparent" Background="Transparent">
                        <FontIcon Glyph="&#xE71E;"/>
                    </Button>
                </StackPanel>
            </Border>
            <TeachingTip FontFamily="{StaticResource GlobalFontHolder}"    Title="Find" Name="ttFind">
                <Grid Margin="0,20" RowSpacing="10" ColumnSpacing="10">
                    <Grid.RowDefinitions>
                        <!-- Row 0: InfoBar -->
                        <RowDefinition Height="Auto"/>
                        <!-- Row 1: Find Field & Button -->
                        <RowDefinition Height="Auto"/>
                        <!-- Row 2: Replace Field & Button -->
                        <RowDefinition Height="Auto"/>
                        <!-- Row 3: Search Options (ToggleButtons) -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- InfoBar across both columns -->
                    <InfoBar Grid.Row="0"  FontFamily="{StaticResource GlobalFontHolder}"   
             Grid.ColumnSpan="2" 
             Name="ifbFindError" 
             Severity="Informational" 
             IsClosable="True" />

                    <!-- Find Row -->
                    <AutoSuggestBox Grid.Row="1" 
                    Grid.Column="0" 
                    Name="asbFind" 
                    Header="Find"  FontFamily="{StaticResource GlobalFontHolder}"   
                    QueryIcon="Find" 
                    VerticalAlignment="Bottom"/>
                    <Button Grid.Row="1" 
            Grid.Column="1" 
            Name="btnFindActual" 
            Content="Find" 
            VerticalAlignment="Bottom" 
            Click="btnFindActual_Click"/>

                    <!-- Replace Row -->
                    <AutoSuggestBox Grid.Row="2" 
                    Grid.Column="0" 
                    Name="asbReplace"  FontFamily="{StaticResource GlobalFontHolder}"   
                    Header="Replace" 
                    VerticalAlignment="Bottom"/>
                    <Button Grid.Row="2" 
            Grid.Column="1" 
            Name="btnReplace" 
            Content="Replace" 
            VerticalAlignment="Bottom" 
            Click="btnReplace_Click"/>

                    <!-- Toggle Options -->
                    <StackPanel Grid.Row="3" 
                Grid.ColumnSpan="2" 
                Orientation="Horizontal" 
                Spacing="8">
                        <ToggleButton Name="btnCaseSensitive" 
                      ToolTipService.ToolTip="Match Case" 
                      BorderBrush="Transparent" 
                      Background="Transparent">
                            <FontIcon Glyph="&#xE8E9;"/>
                        </ToggleButton>
                      
                    </StackPanel>
                </Grid>
            </TeachingTip>
        </Grid>

    </Grid>

</UserControl>
