<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Vusic_Player.UI.Dialogs.VideoOptions.Subtitle.SubtitleGeneral.General"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Vusic_Player.UI.Dialogs.VideoOptions.Subtitle.SubtitleGeneral"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:flyleaf="using:FlyleafLib.MediaFramework.MediaStream" xmlns:oceancyan="using:Vusic_Player.UI.UserViews.Controls"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="12">
            <oceancyan:SearchControl x:Name="srchSubtitles" 
                                 NoSearchResultsDisplayString="No subtitles found based on your search!" 
                                 SearchPlaceHolderText="Search subtitles..." 
                                 CloseSearch="srchSubtitles_CloseSearch" 
                                 ItemSelected="srchSubtitles_ItemSelected"
                                 MaxHeight="200" Width="300" 
                                 HorizontalAlignment="Left" Visibility="Collapsed" />

            <Grid HorizontalAlignment="Stretch" ColumnSpacing="8" Margin="0, 10" RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="stkSubtitleStream" Grid.Row="0" Grid.ColumnSpan="2" Spacing="8" Margin="0,0,0,10">
                    <TextBlock FontFamily="{StaticResource GlobalFontHolder}"    Text="Subtitle Stream" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox FontFamily="{StaticResource GlobalFontHolder}"    x:Name="cmbEmbeddedSubTracks" 
                              PlaceholderText="Select Subtitle Track" ItemsSource="{x:Bind ViewModel.SubStreams, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.CurrentStream, Mode=TwoWay}"
                              HorizontalAlignment="Stretch" 
                              SelectionChanged="cmbEmbeddedSubTracks_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="flyleaf:SubtitlesStream">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xED1E;" FontSize="16" Foreground="Cyan"/>

                                        <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource GlobalFontHolder}"   >
<Run Text="Stream"/>
<Run Text="{x:Bind StreamIndex}"/>
<Run Text="["/>
<Run Text="{x:Bind Language}"/>
<Run Text="]"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button x:Name="btnSearchSubtitles" 
                            ToolTipService.ToolTip="Search Subtitle Tracks" 
                            Click="btnSearchSubtitles_Click" 
                            Background="Transparent" BorderBrush="Transparent" 
                            Grid.Column="1" Margin="4,0,0,0" Padding="4">
                            <Image Source="{Binding SearchIcon, Source={StaticResource GlobalIconHolder}}" Width="16" Height="16"/>
                        </Button>
                    </Grid>
                    <ToggleButton x:Name="tglDisableSubtitles"  FontFamily="{StaticResource GlobalFontHolder}"   
                              Content="Disable Subtitles" 
                              Checked="tglDisableSubtitles_Checked" 
                              Unchecked="tglDisableSubtitles_Unchecked" 
                              HorizontalAlignment="Left">
                        <ToggleButton.Resources>
                            <!-- 1. Background Fill when CHECKED -->
                            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{StaticResource GlobalAccentColor}"/>
                            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{StaticResource GlobalAccentColorPointerOver}"/>
                            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedDisabled" Color="#2A2A2A"/>

                            <!-- 2. Text / Icon Foreground when CHECKED -->
                            <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#000000"/>
                            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#000000"/>
                            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#000000"/>
                            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedDisabled" Color="#707070"/>

                            <!-- 3. Border Stroke when CHECKED -->
                            <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent"/>
                            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent"/>
                            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedDisabled" Color="Transparent"/>

                            <!-- 4. Background Fill when UNCHECKED -->
                            <SolidColorBrush x:Key="ToggleButtonBackground" Color="#202020"/>
                            <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#2D2D2D"/>
                            <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#181818"/>
                            <SolidColorBrush x:Key="ToggleButtonBackgroundDisabled" Color="#1E1E1E"/>

                            <!-- 5. Text / Icon Foreground when UNCHECKED -->
                            <SolidColorBrush x:Key="ToggleButtonForeground" Color="#FFFFFF"/>
                            <SolidColorBrush x:Key="ToggleButtonForegroundPointerOver" Color="#FFFFFF"/>
                            <SolidColorBrush x:Key="ToggleButtonForegroundPressed" Color="#CCCCCC"/>
                            <SolidColorBrush x:Key="ToggleButtonForegroundDisabled" Color="#505050"/>

                            <!-- 6. Border Stroke when UNCHECKED -->
                            <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="#404040"/>
                            <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="#555555"/>
                            <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="#303030"/>
                            <SolidColorBrush x:Key="ToggleButtonBorderBrushDisabled" Color="#2A2A2A"/>
                        </ToggleButton.Resources>
                    </ToggleButton>
                </StackPanel>

                <Rectangle Grid.Row="1" Grid.ColumnSpan="2" Height="1" 
                       Fill="{ThemeResource SystemControlBackgroundBaseLowBrush}" Margin="0,4"/>

                <StackPanel x:Name="stkSubtitleExternal" Grid.Row="2" Grid.ColumnSpan="2" Spacing="12">
                    <TextBox FontFamily="{StaticResource GlobalFontHolder}"    x:Name="txtExternalSubPath" Header="External Subtitle File" 
                         PlaceholderText="C:\Users\Video\subtitles.srt" IsReadOnly="True"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button FontFamily="{StaticResource GlobalFontHolder}"    x:Name="btnBrowseExternalSubtitles" Content="Browse..." 
                            Click="btnBrowseExternalSubtitles_Click_1" />
                        <Button FontFamily="{StaticResource GlobalFontHolder}"    x:Name="btnSubtitleEditor" Content="Subtitle Editor" 
                            Click="btnSubtitleEditor_Click" />
                    </StackPanel>
                </StackPanel>
                <ListView Name="lstViewExternalList" SelectionMode="Single" SelectionChanged="lstViewExternalList_SelectionChanged" Grid.Row="3">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem FontFamily="{StaticResource GlobalFontHolder}"    Text="Open File Location" Name="mnftOpenFileLocationExtSub" Click="mnftOpenFileLocationExtSub_Click"></MenuFlyoutItem>
                                        <MenuFlyoutItem FontFamily="{StaticResource GlobalFontHolder}"    Text="Remove from List" Name="mnftRemoveFromListExtSub" Click="mnftRemoveFromListExtSub_Click"></MenuFlyoutItem>
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <TextBlock FontFamily="{StaticResource GlobalFontHolder}"    Text="{Binding Name}" Grid.Column="0"></TextBlock>
                                <HyperlinkButton Foreground="{StaticResource GlobalAccentColor}"   FontFamily="{StaticResource GlobalFontHolder}"    Content="{Binding Path}" Click="HyperlinkButton_Click" Grid.Column="1"></HyperlinkButton>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Rectangle Grid.Row="4" Grid.ColumnSpan="2" Height="1" 
        Fill="{ThemeResource SystemControlBackgroundBaseLowBrush}" Margin="0,4"/>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
