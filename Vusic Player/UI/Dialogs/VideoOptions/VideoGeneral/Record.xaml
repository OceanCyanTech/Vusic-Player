<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Vusic_Player.UI.Dialogs.VideoOptions.VideoGeneral.Record"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Vusic_Player.UI.Dialogs.VideoOptions.VideoGeneral"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:videoproperties="using:Vusic_Player.Configuration.Helper.Converters" xmlns:playerser="using:Vusic_Player.Configuration"
    mc:Ignorable="d">

    <UserControl.Resources>
        <videoproperties:RecordingStateConverter x:Key="RecConverter"/>
    </UserControl.Resources>
    <StackPanel Orientation="Vertical" Spacing="10">
        <StackPanel Spacing="12" Name="stkRecord">
            <TextBlock Text="Screen Record" Style="{StaticResource BodyStrongTextBlockStyle}"/>

            <StackPanel Spacing="4">
                <TextBlock Text="Save Location" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                <Grid Width="280" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox TextChanged="txtRecordPath_TextChanged" Name="txtRecordPath" IsReadOnly="True" PlaceholderText="Default Videos Folder" ToolTipService.ToolTip="Click the folder icon to change where recordings are saved."/>
                    <Button Name="btnRecordDirectory" Background="Transparent" BorderBrush="Transparent" VerticalAlignment="Stretch" HorizontalAlignment="Right" Grid.Column="0" Margin="4,0,0,0" Content="&#xE8B7;" FontFamily="{StaticResource SymbolThemeFontFamily}" Click="btnRecordDirectory_Click"/>
                </Grid>
            </StackPanel>

            <Button Name="btnRecord" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="btnRecord_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Name="fntIconRecord" Glyph="{x:Bind playerser:PlayerService.Masterplayer.IsRecording, Mode=OneWay, Converter={StaticResource RecConverter}, ConverterParameter='Icon'}" />
                    <TextBlock Name="txtRecord" Text="{x:Bind playerser:PlayerService.Masterplayer.IsRecording, Mode=OneWay, Converter={StaticResource RecConverter}, ConverterParameter='Text'}"/>
                </StackPanel>
            </Button>
        </StackPanel>

    </StackPanel>

</UserControl>
