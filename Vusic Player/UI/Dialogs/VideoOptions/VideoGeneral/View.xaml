<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Vusic_Player.UI.Dialogs.VideoOptions.VideoGeneral.View"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Vusic_Player.UI.Dialogs.VideoOptions.VideoGeneral"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local1="using:Vusic_Player.UI.UserViews.Controls" xmlns:converters="using:Vusic_Player.Configuration.Helper.Converters"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:PercentStringConverter x:Key="PercentConverter"/>
        <converters:RoundedPercentStringConverter x:Key="RoundedPercentConverter"/>
    </UserControl.Resources>
    <StackPanel Orientation="Vertical" Spacing="10">
        <StackPanel Spacing="12" Name="stkZoom">
            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"    Text="View" Style="{StaticResource BodyStrongTextBlockStyle}"/>

            <StackPanel Spacing="4">
                <TextBlock FontFamily="{StaticResource GlobalFontHolder}"    Text="Zoom Level (%)" 
   Style="{StaticResource CaptionTextBlockStyle}" 
   Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>

                <StackPanel Orientation="Horizontal">
                    <local1:OceanSlider x:Name="sldZoom" 
               ValueChanged="sldZoom_ValueChanged" 
               IsTooltipEnabled="False" 
               Minimum="25" 
               Maximum="300"  
               Value="{x:Bind mediacontroller.ZoomValue, Mode=TwoWay}" 
               Width="150"
               VerticalAlignment="Center"/>

                    <TextBlock x:Name="txtZoomDisplay"  FontFamily="{StaticResource GlobalFontHolder}"   
       Text="{x:Bind sldZoom.Value, Converter={StaticResource RoundedPercentConverter}, Mode=OneWay}" 
       Margin="10,0" 
       VerticalAlignment="Center" 
       Width="50"/>

                    <Button Content="Reset"  FontFamily="{StaticResource GlobalFontHolder}"   
    Click="btnResetZoom_Click" 
    VerticalAlignment="Center"
    Padding="8,4" Margin="0, 0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="10" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal" Spacing="20">
                    <CheckBox Name="chkGlow"  FontFamily="{StaticResource GlobalFontHolder}"   
  Content="Enable Glow Effect"  IsChecked="True"
  >
                        <CheckBox.Resources>
                            <!-- Checked State (Background box fill) -->
                            <SolidColorBrush x:Key="CheckBoxFillColorDefault" Color="{StaticResource GlobalAccentColor}"/>
                            <SolidColorBrush x:Key="CheckBoxFillColorPointerOver" Color="{StaticResource GlobalAccentColorPointerOver}"/>
                            <SolidColorBrush x:Key="CheckBoxFillColorPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                            <SolidColorBrush x:Key="CheckBoxFillColorDisabled" Color="#2A2A2A"/>

                            <!-- Checkmark Glyph Color (The tick mark inside the box) -->
                            <SolidColorBrush x:Key="CheckBoxCheckGlyphForeground" Color="#000000"/>
                            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundPointerOver" Color="#000000"/>
                            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundPressed" Color="#000000"/>
                            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundDisabled" Color="#707070"/>

                            <!-- Unchecked State (Empty box outline border) -->
                            <SolidColorBrush x:Key="CheckBoxStrokeColorDefault" Color="#808080"/>
                            <SolidColorBrush x:Key="CheckBoxStrokeColorPointerOver" Color="#B0B0B0"/>
                            <SolidColorBrush x:Key="CheckBoxStrokeColorPressed" Color="#606060"/>

                            <!-- Text Label Foreground -->
                            <SolidColorBrush x:Key="CheckBoxForeground" Color="#FFFFFF"/>
                            <SolidColorBrush x:Key="CheckBoxForegroundPointerOver" Color="#FFFFFF"/>
                            <SolidColorBrush x:Key="CheckBoxForegroundPressed" Color="#CCCCCC"/>
                        </CheckBox.Resources>
                    </CheckBox>

                    <ToggleButton FontFamily="{StaticResource GlobalFontHolder}"    Content="More Options" Name="tglMoreGlowOptions" Checked="tglMoreGlowOptions_Checked" Unchecked="tglMoreGlowOptions_Unchecked">
                        <ToggleButton.Resources>
                            <!-- 1. Background Fill when CHECKED -->
                            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{StaticResource GlobalAccentColor}"/>
                            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{StaticResource GlobalAccentColorPointerOver}"/>
                            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedDisabled" Color="#2A2A2A"/>

                            <!-- 2. Text / Icon Foreground when CHECKED -->
                            <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#000000"/>
                            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#000000"/>
                            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#000000"/>
                            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedDisabled" Color="#707070"/>

                            <!-- 3. Border Stroke when CHECKED -->
                            <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent"/>
                            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent"/>
                            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedDisabled" Color="Transparent"/>

                            <!-- 4. Background Fill when UNCHECKED -->
                            <SolidColorBrush x:Key="ToggleButtonBackground" Color="#202020"/>
                            <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#2D2D2D"/>
                            <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#181818"/>
                            <SolidColorBrush x:Key="ToggleButtonBackgroundDisabled" Color="#1E1E1E"/>

                            <!-- 5. Text / Icon Foreground when UNCHECKED -->
                            <SolidColorBrush x:Key="ToggleButtonForeground" Color="#FFFFFF"/>
                            <SolidColorBrush x:Key="ToggleButtonForegroundPointerOver" Color="#FFFFFF"/>
                            <SolidColorBrush x:Key="ToggleButtonForegroundPressed" Color="#CCCCCC"/>
                            <SolidColorBrush x:Key="ToggleButtonForegroundDisabled" Color="#505050"/>

                            <!-- 6. Border Stroke when UNCHECKED -->
                            <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="#404040"/>
                            <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="#555555"/>
                            <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="#303030"/>
                            <SolidColorBrush x:Key="ToggleButtonBorderBrushDisabled" Color="#2A2A2A"/>
                        </ToggleButton.Resources>
                    </ToggleButton>
                </StackPanel>

                <StackPanel x:Name="GlowSettingsPanel" Visibility="Collapsed" Spacing="15" Margin="0,0,0,0">

                    <TextBlock FontFamily="{StaticResource GlobalFontHolder}"    Text="Glow Customization" Style="{StaticResource BodyStrongTextBlockStyle}"/>

                    <StackPanel Spacing="4" HorizontalAlignment="Left">
                        <TextBlock FontFamily="{StaticResource GlobalFontHolder}"    Text="Glow Color" Style="{StaticResource BodyTextBlockStyle}"/>
                        <Button Name="btnChooseGlowColor" >
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Rectangle Name="rctColorGlow" Width="40" Height="18" Fill="White" Stroke="Gray" StrokeThickness="1" RadiusX="2" RadiusY="2"/>
                                <TextBlock FontFamily="{StaticResource GlobalFontHolder}"    Text="Choose Color" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout>
                                    <ColorPicker Name="glowColorPicker" 
      
             IsAlphaEnabled="True" 
             IsColorSliderVisible="True"
                                                                             ColorChanged="glowColorPicker_ColorChanged"/>
                                </Flyout>
                            </Button.Flyout>

                        </Button>
                    </StackPanel>
                    <ToggleSwitch Visibility="Collapsed" Name="switchRGB"  Toggled="switchRGB_Toggled"
          Header="RGB Rainbow Mode" 
          OnContent="Active"  FontFamily="{StaticResource GlobalFontHolder}"   
          OffContent="Inactive"
       >
                        <ToggleSwitch.Resources>
                            <!-- 1. Pill Track Fill when ON -->
                            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{StaticResource GlobalAccentColor}"/>
                            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{StaticResource GlobalAccentColorPointerOver}"/>
                            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                            <SolidColorBrush x:Key="ToggleSwitchFillOnDisabled" Color="#2A2A2A"/>

                            <!-- 2. Thumb Knob Fill when ON -->
                            <SolidColorBrush x:Key="ToggleSwitchThumbFillOn" Color="#000000"/>
                            <SolidColorBrush x:Key="ToggleSwitchThumbFillOnPointerOver" Color="#000000"/>
                            <SolidColorBrush x:Key="ToggleSwitchThumbFillOnPressed" Color="#000000"/>
                            <SolidColorBrush x:Key="ToggleSwitchThumbFillOnDisabled" Color="#707070"/>

                            <!-- 3. Pill Track Border Stroke when ON -->
                            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="Transparent"/>
                            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="Transparent"/>
                            <SolidColorBrush x:Key="ToggleSwitchStrokeOnDisabled" Color="Transparent"/>

                            <!-- 4. Pill Track Fill when OFF -->
                            <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="Transparent"/>
                            <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="Transparent"/>
                            <SolidColorBrush x:Key="ToggleSwitchFillOffDisabled" Color="Transparent"/>

                            <!-- 5. Pill Track Border Stroke when OFF -->
                            <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#808080"/>
                            <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="#B0B0B0"/>
                            <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed" Color="#606060"/>
                            <SolidColorBrush x:Key="ToggleSwitchStrokeOffDisabled" Color="#404040"/>

                            <!-- 6. Thumb Knob Fill when OFF -->
                            <SolidColorBrush x:Key="ToggleSwitchThumbFillOff" Color="#CCCCCC"/>
                            <SolidColorBrush x:Key="ToggleSwitchThumbFillOffPointerOver" Color="#FFFFFF"/>
                            <SolidColorBrush x:Key="ToggleSwitchThumbFillOffPressed" Color="#999999"/>
                            <SolidColorBrush x:Key="ToggleSwitchThumbFillOffDisabled" Color="#505050"/>

                            <!-- 7. Header and On/Off Label Text Foreground -->
                            <SolidColorBrush x:Key="ToggleSwitchHeaderForeground" Color="#FFFFFF"/>
                            <SolidColorBrush x:Key="ToggleSwitchHeaderForegroundDisabled" Color="#707070"/>
                            <SolidColorBrush x:Key="ToggleSwitchContainerForeground" Color="#FFFFFF"/>
                        </ToggleSwitch.Resources>
                    </ToggleSwitch>

                    <ToggleSwitch Name="switchMoving" 
          Header="Animated Glow"  Toggled="switchMoving_Toggled"
          OnContent="Running"  FontFamily="{StaticResource GlobalFontHolder}"   
          OffContent="Stopped"
         >
                        <ToggleSwitch.Resources>
                            <!-- 1. Pill Track Fill when ON -->
                            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{StaticResource GlobalAccentColor}"/>
                            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{StaticResource GlobalAccentColorPointerOver}"/>
                            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                            <SolidColorBrush x:Key="ToggleSwitchFillOnDisabled" Color="#2A2A2A"/>

                            <!-- 2. Thumb Knob Fill when ON -->
                            <SolidColorBrush x:Key="ToggleSwitchThumbFillOn" Color="#000000"/>
                            <SolidColorBrush x:Key="ToggleSwitchThumbFillOnPointerOver" Color="#000000"/>
                            <SolidColorBrush x:Key="ToggleSwitchThumbFillOnPressed" Color="#000000"/>
                            <SolidColorBrush x:Key="ToggleSwitchThumbFillOnDisabled" Color="#707070"/>

                            <!-- 3. Pill Track Border Stroke when ON -->
                            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="Transparent"/>
                            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="Transparent"/>
                            <SolidColorBrush x:Key="ToggleSwitchStrokeOnDisabled" Color="Transparent"/>

                            <!-- 4. Pill Track Fill when OFF -->
                            <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="Transparent"/>
                            <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="Transparent"/>
                            <SolidColorBrush x:Key="ToggleSwitchFillOffDisabled" Color="Transparent"/>

                            <!-- 5. Pill Track Border Stroke when OFF -->
                            <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#808080"/>
                            <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="#B0B0B0"/>
                            <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed" Color="#606060"/>
                            <SolidColorBrush x:Key="ToggleSwitchStrokeOffDisabled" Color="#404040"/>

                            <!-- 6. Thumb Knob Fill when OFF -->
                            <SolidColorBrush x:Key="ToggleSwitchThumbFillOff" Color="#CCCCCC"/>
                            <SolidColorBrush x:Key="ToggleSwitchThumbFillOffPointerOver" Color="#FFFFFF"/>
                            <SolidColorBrush x:Key="ToggleSwitchThumbFillOffPressed" Color="#999999"/>
                            <SolidColorBrush x:Key="ToggleSwitchThumbFillOffDisabled" Color="#505050"/>

                            <!-- 7. Header and On/Off Label Text Foreground -->
                            <SolidColorBrush x:Key="ToggleSwitchHeaderForeground" Color="#FFFFFF"/>
                            <SolidColorBrush x:Key="ToggleSwitchHeaderForegroundDisabled" Color="#707070"/>
                            <SolidColorBrush x:Key="ToggleSwitchContainerForeground" Color="#FFFFFF"/>
                        </ToggleSwitch.Resources>
                    </ToggleSwitch>
                    <StackPanel>
                        <TextBlock Text="Animation Speed" Style="{StaticResource CaptionTextBlockStyle}"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <local1:OceanSlider x:Name="speedSlider" 
    Minimum="0.1" 
    Maximum="5.0" 
                  Margin="10, 0"
                                                IsTooltipEnabled="False"
 ValueChanged="speedSlider_ValueChanged"
    Value="1.0" 
    Width="200"/>
                            <TextBlock  FontFamily="{StaticResource GlobalFontHolder}"   Text="{x:Bind FormatSpeed(speedSlider.Value),Mode=OneWay}" Name="txtAnimationSpeed" Margin="0, 5"></TextBlock>
                        </StackPanel>
                    </StackPanel>

                </StackPanel>
            </StackPanel>
        </StackPanel>

        <Rectangle Height="1" Fill="{ThemeResource SystemControlBackgroundBaseLowBrush}" Margin="0,4"/>

    </StackPanel>

</UserControl>
