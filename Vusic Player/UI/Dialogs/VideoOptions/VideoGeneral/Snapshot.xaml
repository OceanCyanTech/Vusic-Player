<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Vusic_Player.UI.Dialogs.VideoOptions.VideoGeneral.Snapshot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Vusic_Player.UI.Dialogs.VideoOptions.VideoGeneral"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Orientation="Vertical" Spacing="10">
        <StackPanel Spacing="12" Name="stkSnapshot">
            <TextBlock FontFamily="{StaticResource GlobalFontHolder}"    Text="Snapshot" Style="{StaticResource BodyStrongTextBlockStyle}"/>

            <StackPanel Spacing="12">
                <StackPanel Spacing="4">
                    <TextBlock Text="Save Location"  FontFamily="{StaticResource GlobalFontHolder}"   
       Style="{StaticResource CaptionTextBlockStyle}" 
       Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                    <Grid Width="280" HorizontalAlignment="Left">
                        <TextBox FontFamily="{StaticResource GlobalFontHolder}"    TextChanged="txtSnapshotPath_TextChanged" Name="txtSnapshotPath" ToolTipService.ToolTip="Click the folder icon to change directory" IsReadOnly="True" PlaceholderText="Default Pictures Folder"/>
                        <Button Background="Transparent" BorderBrush="Transparent" 
        VerticalAlignment="Stretch" HorizontalAlignment="Right" Name="btnSnapshotDirectory" 
        Content="&#xE8B7;" FontFamily="{StaticResource SymbolThemeFontFamily}" 
        Click="btnSnapshotDirectory_Click"/>
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Capture Options"  FontFamily="{StaticResource GlobalFontHolder}"   
       Style="{StaticResource CaptionTextBlockStyle}" 
       Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>

                    <CheckBox FontFamily="{StaticResource GlobalFontHolder}"    Name="chkIncludePosition" Checked="chkIncludePosition_Checked" Unchecked="chkIncludePosition_Unchecked" Content="Include media position" >
                        <CheckBox.Resources>
                            <!-- Checked State (Background box fill) -->
                            <SolidColorBrush x:Key="CheckBoxFillColorDefault" Color="{StaticResource GlobalAccentColor}"/>
                            <SolidColorBrush x:Key="CheckBoxFillColorPointerOver" Color="{StaticResource GlobalAccentColorPointerOver}"/>
                            <SolidColorBrush x:Key="CheckBoxFillColorPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                            <SolidColorBrush x:Key="CheckBoxFillColorDisabled" Color="#2A2A2A"/>

                            <!-- Checkmark Glyph Color (The tick mark inside the box) -->
                            <SolidColorBrush x:Key="CheckBoxCheckGlyphForeground" Color="#000000"/>
                            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundPointerOver" Color="#000000"/>
                            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundPressed" Color="#000000"/>
                            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundDisabled" Color="#707070"/>

                            <!-- Unchecked State (Empty box outline border) -->
                            <SolidColorBrush x:Key="CheckBoxStrokeColorDefault" Color="#808080"/>
                            <SolidColorBrush x:Key="CheckBoxStrokeColorPointerOver" Color="#B0B0B0"/>
                            <SolidColorBrush x:Key="CheckBoxStrokeColorPressed" Color="#606060"/>

                            <!-- Text Label Foreground -->
                            <SolidColorBrush x:Key="CheckBoxForeground" Color="#FFFFFF"/>
                            <SolidColorBrush x:Key="CheckBoxForegroundPointerOver" Color="#FFFFFF"/>
                            <SolidColorBrush x:Key="CheckBoxForegroundPressed" Color="#CCCCCC"/>
                        </CheckBox.Resources>
                    </CheckBox>

                    <CheckBox FontFamily="{StaticResource GlobalFontHolder}"    Name="chkIncludeTimestamp" Checked="chkIncludeTimestamp_Checked" Unchecked="chkIncludeTimestamp_Unchecked" Content="Include current date/time" >
                        <CheckBox.Resources>
                            <!-- Checked State (Background box fill) -->
                            <SolidColorBrush x:Key="CheckBoxFillColorDefault" Color="{StaticResource GlobalAccentColor}"/>
                            <SolidColorBrush x:Key="CheckBoxFillColorPointerOver" Color="{StaticResource GlobalAccentColorPointerOver}"/>
                            <SolidColorBrush x:Key="CheckBoxFillColorPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                            <SolidColorBrush x:Key="CheckBoxFillColorDisabled" Color="#2A2A2A"/>

                            <!-- Checkmark Glyph Color (The tick mark inside the box) -->
                            <SolidColorBrush x:Key="CheckBoxCheckGlyphForeground" Color="#000000"/>
                            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundPointerOver" Color="#000000"/>
                            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundPressed" Color="#000000"/>
                            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundDisabled" Color="#707070"/>

                            <!-- Unchecked State (Empty box outline border) -->
                            <SolidColorBrush x:Key="CheckBoxStrokeColorDefault" Color="#808080"/>
                            <SolidColorBrush x:Key="CheckBoxStrokeColorPointerOver" Color="#B0B0B0"/>
                            <SolidColorBrush x:Key="CheckBoxStrokeColorPressed" Color="#606060"/>

                            <!-- Text Label Foreground -->
                            <SolidColorBrush x:Key="CheckBoxForeground" Color="#FFFFFF"/>
                            <SolidColorBrush x:Key="CheckBoxForegroundPointerOver" Color="#FFFFFF"/>
                            <SolidColorBrush x:Key="CheckBoxForegroundPressed" Color="#CCCCCC"/>
                        </CheckBox.Resources>
                    </CheckBox>

                </StackPanel>

                <Button Name="btnSnapshot"  FontFamily="{StaticResource GlobalFontHolder}"   
Style="{StaticResource AccentButtonStyle}" 
HorizontalAlignment="Stretch" 
Click="btnSnapshot_Click" Background="{StaticResource GlobalAccentColor}" >
                    <Button.Resources>
                        <SolidColorBrush x:Key="AccentButtonBackground" Color="{StaticResource GlobalAccentColor}"/>
                        <SolidColorBrush x:Key="AccentButtonForeground" Color="#0B0D13"/>
                        <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent"/>

                        <!-- Pointer Over (Hover) -->
                        <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{StaticResource GlobalAccentColorPointerOver}"/>
                        <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#0B0D13"/>
                        <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="Transparent"/>

                        <!-- Pressed State -->
                        <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{StaticResource GlobalAccentColorPointerPressed}"/>
                        <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="Transparent"/>

                        <!-- Disabled State -->
                        <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#2A2A2A"/>
                        <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#707070"/>
                        <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="Transparent"/>
                    </Button.Resources>
                <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE722;" />
                        <TextBlock FontFamily="{StaticResource GlobalFontHolder}"    Text="Capture Frame"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
        <Rectangle Height="1" Fill="{ThemeResource SystemControlBackgroundBaseLowBrush}" Margin="0,4"/>

    </StackPanel>

</UserControl>
